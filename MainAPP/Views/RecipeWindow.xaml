<Window
    x:Class="MainAPP.Views.RecipeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:viewer="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:interactivity="clr-namespace:MainAPP.Interactivity"
    xmlns:local="clr-namespace:MainAPP.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    Title="配方详情"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    d:DataContext="{d:DesignInstance vm:RecipeViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <!--  ===== 深色科技风：Window 级隐式样式（BasedOn Themes/Controls/FormControls 命名样式）  =====  -->
    <!--  由于本窗口 GroupBox / hc:NumericUpDown / CheckBox 等控件数量多，采用隐式 BasedOn 一行式引用更简洁、不易遗漏  -->
    <Window.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource DarkGroupBoxStyle}" />
        <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItemStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource DarkTextBoxStyle}" />
        <Style TargetType="hc:TextBox" BasedOn="{StaticResource DarkHCTextBoxStyle}" />
        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource DarkHCNumericUpDownStyle}" />
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBoxStyle}" />
        <Style TargetType="Expander" BasedOn="{StaticResource DarkExpanderStyle}" />
        <Style TargetType="ProgressBar" BasedOn="{StaticResource DarkProgressBarStyle}" />

        <!--  TextBlock 默认色：保留为隐式样式（影响所有未显式设置 Style 的 TextBlock，是默认文本色，不抽取）  -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TechTextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!--  Ctrl+S: 保存配方  -->
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveToFileCommand}" />
        <!--  F5: 采集图像  -->
        <KeyBinding Key="F5" Command="{Binding GetImageCommand}" />
        <!--  Ctrl+Enter: 查找基准点（标定）  -->
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding FindReferencePointsCommand}" />
        <!--  Esc: 关闭窗口  -->
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}" />
        <!--  Ctrl+D: 连接相机  -->
        <KeyBinding Gesture="Ctrl+D" Command="{Binding ConnectCameraCommand}" />
    </Window.InputBindings>

    <!--  ===== 根 Grid：深色渐变背景 + 网格装饰 =====  -->
    <Grid Background="{StaticResource TechPageBackgroundBrush}" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="288" />
        </Grid.ColumnDefinitions>

        <!--  装饰性网格背景（铺满两列）  -->
        <Rectangle
            Grid.ColumnSpan="2"
            Opacity="0.3"
            Fill="{StaticResource TechGridBrush}" />

        <!--  ImageViewer 容器：深色卡片边框包裹（图像本身保持原样）  -->
        <Border
            Grid.Column="0"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="2">
            <viewer:ImageViewer x:Name="imageViewer" ImageSource="{Binding ImageForShow}" />
        </Border>

        <!--  右侧 Grid：含 TabControl 与底部按钮  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <TabControl Background="{StaticResource TechCardBgBrush}">
                <!--#region 图像采集配置-->
                <!--  图像采集配置  -->
                <TabItem Header="图像采集">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!--  图像来源  -->
                            <GroupBox Margin="0,0,0,8" Header="图像来源">
                                <StackPanel Margin="4">
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="从扫码枪读取"
                                        IsChecked="{Binding ImageReadFromScanner}" />
                                    <Grid Visibility="{Binding ImageReadFromScanner, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <hc:TextBox
                                            Grid.Column="0"
                                            hc:InfoElement.Title="图像目录"
                                            Text="{Binding ImageDirectoryPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="8,0"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding BrowseImageDirectoryCommand}"
                                            Content="..."
                                            Style="{StaticResource NeonButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!--  图像预处理  -->
                            <GroupBox Margin="0,0,0,8" Header="图像预处理">
                                <StackPanel Margin="4">
                                    <hc:NumericUpDown
                                        Margin="0,0,0,8"
                                        hc:InfoElement.Title="跳过开头帧"
                                        Maximum="100"
                                        Minimum="0"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        ToolTip="文件夹取图时跳过目录开头不稳定的 N 张图（0 表示不跳过）；与二维码移除无关"
                                        Value="{Binding ImageTool.RemoveCount}" />
                                </StackPanel>
                            </GroupBox>

                            <!--  扫码枪操作  -->
                            <GroupBox
                                Margin="0,0,0,8"
                                Header="扫码枪操作"
                                Visibility="{Binding ImageReadFromScanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Margin="4">
                                    <TextBlock Margin="8,0,0,8" Text="曝光时间" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        Text="{Binding ImageTool.ExposureTime, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}">
                                        <i:Interaction.Behaviors>
                                            <interactivity:NumericInputBehavior AllowDecimal="True" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                    <TextBlock Margin="8,0,0,8" Text="增益" />
                                    <TextBox
                                        Margin="0,0,0,8"
                                        Text="{Binding ImageTool.Gain, StringFormat={}{0:F2}, UpdateSourceTrigger=LostFocus}">
                                        <i:Interaction.Behaviors>
                                            <interactivity:NumericInputBehavior AllowDecimal="True" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                    <UniformGrid
                                        Margin="0,8,0,0"
                                        Columns="3"
                                        Rows="1">
                                        <Button
                                            Margin="0,0,4,0"
                                            Padding="8,4"
                                            Command="{Binding SetParameterCommand}"
                                            Content="参数设置"
                                            IsEnabled="{Binding HasScanner}"
                                            Style="{StaticResource NeonButtonStyle}" />
                                        <Button
                                            Margin="0,0,4,0"
                                            Padding="8,4"
                                            Command="{Binding GetParameterCommand}"
                                            Content="参数获取"
                                            IsEnabled="{Binding HasScanner}"
                                            Style="{StaticResource NeonButtonStyle}" />
                                        <Button
                                            Padding="8,4"
                                            Command="{Binding OptimizeParameterCommand}"
                                            IsEnabled="{Binding HasScanner}">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                    <Setter Property="Content" Value="最佳参数" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOptimizing}" Value="True">
                                                            <Setter Property="Content" Value="取消优化" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </UniformGrid>
                                    <UniformGrid
                                        Margin="0,8,0,0"
                                        Columns="3"
                                        Rows="1">
                                        <Button
                                            Margin="0,0,4,0"
                                            Padding="8,4"
                                            Command="{Binding GetImageCommand}"
                                            IsEnabled="{Binding CanCapture}"
                                            Style="{StaticResource ButtonPrimary}"
                                            ToolTip="采集图像 (F5)">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconPhosphorIcons
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Camera" />
                                                <TextBlock Text="获取图像" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Margin="0,0,4,0"
                                            Padding="8,4"
                                            Command="{Binding SaveImageCommand}"
                                            Style="{StaticResource ButtonSuccess}">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconPhosphorIcons
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FloppyDisk" />
                                                <TextBlock Text="保存图像" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton
                                            Padding="8,4"
                                            IsChecked="{Binding IsLiveDisplayEnabled}"
                                            IsEnabled="{Binding HasScanner}">
                                            <ToggleButton.Style>
                                                <Style BasedOn="{StaticResource ToggleButtonPrimary}" TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="实时显示" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="停止显示" />
                                                            <Setter Property="Background" Value="#E53935" />
                                                            <Setter Property="BorderBrush" Value="#C62828" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!--#endregion-->

                <!--  坐标系创建配置  -->
                <!--#region 坐标系创建配置-->
                <TabItem Header="坐标系创建">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!--  P2-19: 标定向导 - 步骤状态指示  -->
                            <Border
                                Margin="0,0,0,8"
                                Padding="10"
                                Background="{StaticResource TechInnerBgBrush}"
                                BorderBrush="{StaticResource TechCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource NeonCyanBrush}"
                                        Text="📊 标定向导" />
                                    <UniformGrid Columns="4" Rows="1">
                                        <!--  Step 1: 准备图像  -->
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                Text="●">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TechTextLabelBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource TechTextLabelBrush}"
                                                Text="1.准备图像" />
                                        </StackPanel>
                                        <!--  Step 2: 配置参数  -->
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                Foreground="{StaticResource TechTextLabelBrush}"
                                                Text="●" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource TechTextLabelBrush}"
                                                Text="2.配置参数" />
                                        </StackPanel>
                                        <!--  Step 3: 执行标定  -->
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                Text="●">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TechTextLabelBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource TechTextLabelBrush}"
                                                Text="3.执行标定" />
                                        </StackPanel>
                                        <!--  Step 4: 验证结果  -->
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                Text="●">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TechTextLabelBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalibrated}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource NeonGreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource TechTextLabelBrush}"
                                                Text="4.验证结果" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        FontStyle="Italic"
                                        Foreground="{StaticResource TechTextTertiaryBrush}"
                                        Text="提示：先到「图像采集」Tab 采图，再填写下方棋盘参数，最后点击「查找基准点」按钮完成标定。" />
                                </StackPanel>
                            </Border>

                            <!--  棋盘定位  -->
                            <GroupBox Margin="0,0,0,8" Header="棋盘定位">
                                <StackPanel Margin="4">
                                    <UniformGrid
                                        Margin="0,0,0,8"
                                        Columns="2"
                                        Rows="1">
                                        <hc:NumericUpDown
                                            Margin="0,0,4,0"
                                            hc:InfoElement.Title="角点列数"
                                            Maximum="100"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            ToolTip="0表示不使用棋盘定位"
                                            Value="{Binding CoordinateTool.PatternWidth}" />
                                        <hc:NumericUpDown
                                            Margin="4,0,0,0"
                                            hc:InfoElement.Title="角点行数"
                                            Maximum="100"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            ToolTip="0表示不使用棋盘定位"
                                            Value="{Binding CoordinateTool.PatternHeight}" />
                                    </UniformGrid>
                                    <UniformGrid Columns="2" Rows="1">
                                        <hc:NumericUpDown
                                            Margin="0,0,4,0"
                                            hc:InfoElement.Title="方格尺寸"
                                            DecimalPlaces="2"
                                            Increment="0.01"
                                            Maximum="1000"
                                            Minimum="1"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding CoordinateTool.SquareSize}" />
                                        <hc:NumericUpDown
                                            Margin="4,0,0,0"
                                            hc:InfoElement.Title="ROI边距"
                                            Maximum="1000"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding CoordinateTool.RoiPadding}" />
                                    </UniformGrid>
                                </StackPanel>
                            </GroupBox>

                            <!--  P2-19: 圆点检测（默认折叠，高级参数）  -->
                            <Expander
                                Margin="0,0,0,8"
                                Header="圆点检测（高级参数，通常使用默认值即可）"
                                IsExpanded="False">
                                <GroupBox Margin="0,8,0,0" Header="圆点检测">
                                    <StackPanel Margin="4">
                                        <UniformGrid
                                            Margin="0,0,0,8"
                                            Columns="2"
                                            Rows="1">
                                            <hc:NumericUpDown
                                                Margin="0,0,4,0"
                                                hc:InfoElement.Title="最小面积"
                                                Maximum="1000000"
                                                Minimum="1"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.MinArea}" />
                                            <hc:NumericUpDown
                                                Margin="4,0,0,0"
                                                hc:InfoElement.Title="最大面积"
                                                Maximum="10000000"
                                                Minimum="1"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.MaxArea}" />
                                        </UniformGrid>
                                        <hc:NumericUpDown
                                            hc:InfoElement.Title="最小圆度"
                                            DecimalPlaces="2"
                                            Increment="0.01"
                                            Maximum="1"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding CoordinateTool.MinCircularity}" />
                                    </StackPanel>
                                </GroupBox>
                            </Expander>

                            <!--  P2-19: 图像预处理（默认折叠，高级参数）  -->
                            <Expander
                                Margin="0,0,0,8"
                                Header="图像预处理（高级参数，仅在检测失败时调整）"
                                IsExpanded="False">
                                <GroupBox Margin="0,8,0,0" Header="图像预处理">
                                    <StackPanel Margin="4">
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="12"
                                            Foreground="{StaticResource TechTextTertiaryBrush}"
                                            Text="双边滤波" />
                                        <UniformGrid
                                            Margin="0,0,0,8"
                                            Columns="3"
                                            Rows="1">
                                            <hc:NumericUpDown
                                                Margin="0,0,4,0"
                                                hc:InfoElement.Title="直径"
                                                Maximum="31"
                                                Minimum="1"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.BilateralD}" />
                                            <hc:NumericUpDown
                                                Margin="0,0,4,0"
                                                hc:InfoElement.Title="颜色σ"
                                                DecimalPlaces="0"
                                                Increment="5"
                                                Maximum="500"
                                                Minimum="0"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.BilateralSigmaColor}" />
                                            <hc:NumericUpDown
                                                hc:InfoElement.Title="空间σ"
                                                DecimalPlaces="0"
                                                Increment="5"
                                                Maximum="500"
                                                Minimum="0"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.BilateralSigmaSpace}" />
                                        </UniformGrid>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="12"
                                            Foreground="{StaticResource TechTextTertiaryBrush}"
                                            Text="边缘检测" />
                                        <UniformGrid
                                            Margin="0,0,0,8"
                                            Columns="3"
                                            Rows="1">
                                            <hc:NumericUpDown
                                                Margin="0,0,4,0"
                                                hc:InfoElement.Title="Canny低"
                                                Maximum="255"
                                                Minimum="0"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.CannyThreshold1}" />
                                            <hc:NumericUpDown
                                                Margin="0,0,4,0"
                                                hc:InfoElement.Title="Canny高"
                                                Maximum="255"
                                                Minimum="0"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.CannyThreshold2}" />
                                            <hc:NumericUpDown
                                                hc:InfoElement.Title="核大小"
                                                Maximum="31"
                                                Minimum="1"
                                                Style="{StaticResource NumericUpDownExtend}"
                                                Value="{Binding CoordinateTool.KernelSize}" />
                                        </UniformGrid>
                                        <UniformGrid Columns="2" Rows="1">
                                            <CheckBox
                                                Margin="0,0,4,0"
                                                Content="CLAHE均衡化"
                                                IsChecked="{Binding CoordinateTool.EnableCLAHE}" />
                                            <CheckBox
                                                Margin="4,0,0,0"
                                                Content="多策略重试"
                                                IsChecked="{Binding CoordinateTool.EnableMultiStrategy}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </GroupBox>
                            </Expander>

                            <!--  操作按钮  -->
                            <UniformGrid Columns="2" Rows="1">
                                <Button
                                    Margin="0,0,4,0"
                                    Padding="8,6"
                                    Command="{Binding FindReferencePointsCommand}"
                                    ToolTip="查找基准点 (Ctrl+Enter)">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconPhosphorIcons
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="MagnifyingGlass" />
                                        <!--  L: 标定进行中切换文字为"标定中..."并显示 ProgressBar  -->
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="查找基准点" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                                            <Setter Property="Text" Value="标定中..." />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar
                                            Width="14"
                                            Height="14"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center"
                                            IsIndeterminate="True"
                                            Visibility="{Binding IsCalibrating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Button>
                                <CheckBox
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="显示调试窗口"
                                    IsChecked="{Binding IsShowDebug}" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!--#endregion-->

                <!--  AI模型配置  -->
                <!--#region AI模型配置-->
                <TabItem Header="AI模型">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <!--  边缘检测模型配置  -->
                            <GroupBox Margin="0,0,0,8" Header="边缘检测模型">
                                <StackPanel Margin="4">
                                    <!--  模型路径  -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <hc:TextBox
                                            Grid.Column="0"
                                            hc:InfoElement.Title="ONNX模型文件路径"
                                            Text="{Binding YoloTool.EdgeDetection.ModelPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            Padding="8,0"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding BrowseEdgeModelCommand}"
                                            Content="浏览"
                                            Style="{StaticResource NeonButtonStyle}"
                                            ToolTip="选择ONNX模型文件" />
                                    </Grid>
                                    <!--  图像调整大小  -->
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="调整输入图像大小"
                                        IsChecked="{Binding YoloTool.EdgeDetection.IsResize}" />
                                    <Grid Visibility="{Binding YoloTool.EdgeDetection.IsResize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <hc:NumericUpDown
                                            Grid.Column="0"
                                            Margin="0,0,4,0"
                                            hc:InfoElement.Title="宽度缩放比例"
                                            Maximum="16"
                                            Minimum="1"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding YoloTool.EdgeDetection.ResizeScale}" />
                                        <hc:NumericUpDown
                                            Grid.Column="1"
                                            Margin="4,0,0,0"
                                            hc:InfoElement.Title="高度缩放比例"
                                            Maximum="16"
                                            Minimum="1"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding YoloTool.EdgeDetection.ResizeScaleY}" />
                                    </Grid>
                                    <!--  CUDA加速  -->
                                    <CheckBox
                                        Margin="0,8,0,8"
                                        Content="使用CUDA加速"
                                        IsChecked="{Binding YoloTool.EdgeDetection.UseCuda}" />
                                    <Grid Visibility="{Binding YoloTool.EdgeDetection.UseCuda, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <hc:NumericUpDown
                                            hc:InfoElement.Title="CUDA设备ID"
                                            Maximum="16"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding YoloTool.EdgeDetection.CudaDeviceId}" />
                                    </Grid>
                                    <!--  检测阈值  -->
                                    <UniformGrid
                                        Margin="0,8,0,8"
                                        Columns="2"
                                        Rows="1">
                                        <hc:NumericUpDown
                                            Margin="0,0,4,0"
                                            hc:InfoElement.Title="置信度阈值"
                                            DecimalPlaces="2"
                                            Increment="0.05"
                                            Maximum="1"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding YoloTool.EdgeDetection.Confidence}" />
                                        <hc:NumericUpDown
                                            Margin="4,0,0,0"
                                            hc:InfoElement.Title="IoU阈值"
                                            DecimalPlaces="2"
                                            Increment="0.05"
                                            Maximum="1"
                                            Minimum="0"
                                            Style="{StaticResource NumericUpDownExtend}"
                                            Value="{Binding YoloTool.EdgeDetection.IoU}" />
                                    </UniformGrid>
                                    <!--  其他选项  -->
                                    <UniformGrid Columns="3" Rows="1">
                                        <CheckBox Margin="0,0,4,0" IsChecked="{Binding YoloTool.EdgeDetection.KeepAspectRatio}">
                                            <TextBlock Text="保持宽高比" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Margin="0,0,4,0" IsChecked="{Binding YoloTool.EdgeDetection.ApplyAutoOrient}">
                                            <TextBlock Text="自动校正方向" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox IsChecked="{Binding YoloTool.EdgeDetection.SuppressParallelInference}">
                                            <TextBlock Text="禁用并行推理" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </UniformGrid>
                                    <!--  2026-09-07: 产品掩码面积过滤（配方级覆盖；留空=跟随设置页全局值，填 0=禁用对应方向）  -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- 2026-09-07: 两行展示，避免窄窗下并排被截断；行2 控件顶距 4 与行1 拉开 -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,4,0" VerticalAlignment="Center" Text="产品最小面积" />
                                        <TextBox
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding YoloTool.EdgeDetection.MinMaskAreaPixels, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="分割掩码面积（原图像素）低于此值的目标判定无效并过滤。留空 = 跟随设置页全局值；填 0 = 禁用下限。" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="px" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,4,0" VerticalAlignment="Center" Text="产品最大面积" />
                                        <TextBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,4,8,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding YoloTool.EdgeDetection.MaxMaskAreaPixels, UpdateSourceTrigger=LostFocus}"
                                            ToolTip="分割掩码面积（原图像素）高于此值的目标判定无效并过滤。留空 = 跟随设置页全局值；填 0 = 禁用上限。" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,4,0,0" VerticalAlignment="Center" Text="px" />
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <!--  角度检测模型配置  -->
                            <GroupBox Margin="0,0,0,8" Header="角度检测模型">
                                <StackPanel Margin="4">
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="启用角度检测"
                                        IsChecked="{Binding YoloTool.IsAngleDetectionEnabled}"
                                        ToolTip="启用角度检测模型" />
                                    <!-- 2026-09-08: 灰度判向（无角度模型时对掩码回退角度做 180° 去歧义）。
                                        放在可折叠 Grid 之外，保证"未启用角度检测"时也能看到并配置本开关 -->
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="无角度模型时灰度判向"
                                        IsChecked="{Binding YoloTool.IsBrightnessDirectionEnabled}"
                                        ToolTip="仅未启用角度检测时生效：按分割掩码长轴两侧平均灰度判定产品头尾（头端偏亮约定见设置页），消除回退角度 180° 方向歧义。勾选/取消=本配方强制启用/禁用；新建配方默认留空=跟随设置页全局开关。头端偏亮/偏暗与灰度差死区在设置页 Algorithm 配置中调整。" />
                                    <Grid Visibility="{Binding YoloTool.IsAngleDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <!--  模型路径  -->
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <hc:TextBox
                                                    Grid.Column="0"
                                                    hc:InfoElement.Title="ONNX模型文件路径"
                                                    Text="{Binding YoloTool.AngleDetection.ModelPath, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    Padding="8,0"
                                                    VerticalAlignment="Bottom"
                                                    Command="{Binding BrowseAngleModelCommand}"
                                                    Content="浏览"
                                                    Style="{StaticResource NeonButtonStyle}"
                                                    ToolTip="选择ONNX模型文件" />
                                            </Grid>
                                            <!--  图像调整大小  -->
                                            <CheckBox
                                                Margin="0,0,0,8"
                                                Content="调整输入图像大小"
                                                IsChecked="{Binding YoloTool.AngleDetection.IsResize}" />
                                            <Grid Visibility="{Binding YoloTool.AngleDetection.IsResize, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    Grid.Column="0"
                                                    Margin="0,0,4,0"
                                                    hc:InfoElement.Title="宽度缩放比例"
                                                    Maximum="16"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownExtend}"
                                                    Value="{Binding YoloTool.AngleDetection.ResizeScale}" />
                                                <hc:NumericUpDown
                                                    Grid.Column="1"
                                                    Margin="4,0,0,0"
                                                    hc:InfoElement.Title="高度缩放比例"
                                                    Maximum="16"
                                                    Minimum="1"
                                                    Style="{StaticResource NumericUpDownExtend}"
                                                    Value="{Binding YoloTool.AngleDetection.ResizeScaleY}" />
                                            </Grid>
                                            <!--  CUDA加速  -->
                                            <CheckBox
                                                Margin="0,8,0,8"
                                                Content="使用CUDA加速"
                                                IsChecked="{Binding YoloTool.AngleDetection.UseCuda}" />
                                            <Grid Visibility="{Binding YoloTool.AngleDetection.UseCuda, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <hc:NumericUpDown
                                                    hc:InfoElement.Title="CUDA设备ID"
                                                    Maximum="16"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownExtend}"
                                                    Value="{Binding YoloTool.AngleDetection.CudaDeviceId}" />
                                            </Grid>
                                            <!--  检测阈值  -->
                                            <UniformGrid
                                                Margin="0,8,0,8"
                                                Columns="2"
                                                Rows="1">
                                                <hc:NumericUpDown
                                                    Margin="0,0,4,0"
                                                    hc:InfoElement.Title="置信度阈值"
                                                    DecimalPlaces="2"
                                                    Increment="0.05"
                                                    Maximum="1"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownExtend}"
                                                    Value="{Binding YoloTool.AngleDetection.Confidence}" />
                                                <hc:NumericUpDown
                                                    Margin="4,0,0,0"
                                                    hc:InfoElement.Title="IoU阈值"
                                                    DecimalPlaces="2"
                                                    Increment="0.05"
                                                    Maximum="1"
                                                    Minimum="0"
                                                    Style="{StaticResource NumericUpDownExtend}"
                                                    Value="{Binding YoloTool.AngleDetection.IoU}" />
                                            </UniformGrid>
                                            <!--  其他选项  -->
                                            <UniformGrid Columns="3" Rows="1">
                                                <CheckBox Margin="0,0,4,0" IsChecked="{Binding YoloTool.AngleDetection.KeepAspectRatio}">
                                                    <TextBlock Text="保持宽高比" TextWrapping="Wrap" />
                                                </CheckBox>
                                                <CheckBox Margin="0,0,4,0" IsChecked="{Binding YoloTool.AngleDetection.ApplyAutoOrient}">
                                                    <TextBlock Text="自动校正方向" TextWrapping="Wrap" />
                                                </CheckBox>
                                                <CheckBox IsChecked="{Binding YoloTool.AngleDetection.SuppressParallelInference}">
                                                    <TextBlock Text="禁用并行推理" TextWrapping="Wrap" />
                                                </CheckBox>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>
                            <!--  标定补偿(所有角度路径生效)：偏移/平移与是否启用角度检测无关——
                                无角度模型时掩码回退角同样叠加 OffsetAngle(DetectionRecordService 掩码分支
                                fallbackAngle=主轴角+offsetAngle)，故独立成组、始终可见可配，
                                便于仅分割模式现场标定安装偏差(2026-09-08 移出"角度检测模型"折叠区)  -->
                            <GroupBox Margin="0,0,0,8" Header="标定补偿">
                                <StackPanel Margin="4">
                                    <!--  角度偏移(手动标定):放置已知朝向产品,期望角度-系统显示角度(允许负值);
                                        掩码回退分支也叠加本值(检测时回退角=掩码主轴角+OffsetAngle),非角度模型专属  -->
                                    <hc:NumericUpDown
                                        Margin="0,0,0,8"
                                        hc:InfoElement.Title="角度偏移 OffsetAngle(°)(-360~360)"
                                        DecimalPlaces="1"
                                        Increment="1"
                                        Maximum="359.9"
                                        Minimum="-359.9"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        ToolTip="放置已知朝向产品，期望角度-系统显示角度（允许负值）。对所有角度路径生效：启用角度模型时加在 atan2 结果上；未启用(掩码回退)时加在掩码主轴角上（回退角=主轴角+OffsetAngle），用于校准安装偏差。"
                                        Value="{Binding OffsetAngle, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </GroupBox>
                            <!--  抓取点(2026-09-15)：产品局部坐标系偏移，随产品角度一起旋转 ——
                                用于补偿夹爪偏心、或抓取点不在产品中心。
                                取代原先的"世界坐标系常量平移补偿 OffsetX/OffsetY"（方向固定，只在单一角度成立，
                                已移除；旧配方值在加载时一次性自动迁移到本组）。
                                0 / 0 = 抓取点即掩码最小外接旋转矩形的几何中心（默认，与改造前一致）。  -->
                            <GroupBox Margin="0,0,0,8" Header="抓取点（产品局部坐标系，随角度旋转）">
                                <StackPanel Margin="4">
                                    <!--  画面示教开关：勾选后点击测试推理图像即可设点，免去手动换算长/短轴偏移  -->
                                    <CheckBox
                                        Margin="0,0,0,8"
                                        Content="启用画面示教（点击图像设置抓取点）"
                                        IsChecked="{Binding IsGrabTeachMode}"
                                        ToolTip="勾选后，在下方测试推理图像上点击任意位置，该点会被设为抓取点（自动反算长轴/短轴偏移）。仅当已执行过一次测试推理且头尾朝向可信时有效。" />
                                    <!--  长轴偏移：正 = 朝产品头部；朝向不可信时会自动退化为中心（宁可抓中心也不抓反）  -->
                                    <hc:NumericUpDown
                                        Margin="0,0,0,8"
                                        hc:InfoElement.Title="长轴偏移 朝头部(mm)"
                                        DecimalPlaces="2"
                                        Increment="0.1"
                                        Maximum="1000"
                                        Minimum="-1000"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        ToolTip="抓取点沿产品长轴的偏移，正值朝产品头部。属于产品局部坐标系、随产品角度旋转，用于补偿夹爪偏心或抓取点不在产品中心。0 = 抓取点即矩形几何中心。注意：当二维码、角度模型、特征池都无法判定头尾（朝向不可信）时，本项与短轴偏移会【一起】退回中心 —— 短轴方向同样依赖头尾，只退一半会让抓取点偏到产品另一侧。此时画面上的抓取点标记会变灰，帧日志也会提示。"
                                        Value="{Binding GrabOffsetLongMm, UpdateSourceTrigger=PropertyChanged}" />
                                    <!--  短轴偏移：正 = 面朝头部时的右手侧；方向取决于相机安装朝向，相反时填负值  -->
                                    <hc:NumericUpDown
                                        Margin="0,0,0,0"
                                        hc:InfoElement.Title="短轴偏移 右为正(mm)"
                                        DecimalPlaces="2"
                                        Increment="0.1"
                                        Maximum="1000"
                                        Minimum="-1000"
                                        Style="{StaticResource NumericUpDownExtend}"
                                        ToolTip="抓取点沿产品短轴的偏移，正值 = 面朝产品头部时的右手侧。同样随产品角度旋转。图像的「左右」取决于相机安装朝向，若现场发现方向与预期相反，直接填负值即可（无需改程序）。头尾朝向不可信时本项与长轴偏移会一起退回中心（短轴方向依赖头尾，见长轴偏移的说明）。"
                                        Value="{Binding GrabOffsetShortMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </GroupBox>
                            <!--  操作按钮  -->
                            <UniformGrid Columns="2" Rows="1">
                                <Button
                                    Margin="4,0,0,0"
                                    Padding="8,6"
                                    Command="{Binding InferenceCommand}"
                                    ToolTip="使用当前图像进行推理测试">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconPhosphorIcons
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Lightning" />
                                        <TextBlock Text="测试推理" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!--#endregion-->
                <!--  推理结果（测试推理历史，最新在前，每次推理一张卡片）  -->
                <!--#region 推理结果-->
                <TabItem Header="推理结果">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  工具行：记录计数 + 拍照 / 测试推理 / 清空  -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource TechTextTertiaryBrush}"
                                Text="{Binding TestResults.Count, StringFormat={}共 {0} 条}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Padding="10,3"
                                Command="{Binding GetImageCommand}"
                                IsEnabled="{Binding CanCapture}"
                                Style="{StaticResource NeonButtonStyle}"
                                ToolTip="拍照获取当前图像 (F5)，随后可点「测试推理」">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconPhosphorIcons
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="Camera" />
                                    <TextBlock Text="拍照" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                Padding="10,3"
                                Command="{Binding InferenceCommand}"
                                Style="{StaticResource NeonButtonStyle}"
                                ToolTip="使用当前图像执行一次推理测试">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconPhosphorIcons
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Kind="Lightning" />
                                    <TextBlock Text="测试推理" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="3"
                                Margin="6,0,0,0"
                                Padding="10,3"
                                Command="{Binding ClearTestResultsCommand}"
                                Style="{StaticResource NeonButtonStyle}"
                                ToolTip="清空全部推理记录">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconPhosphorIcons
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Kind="Trash" />
                                    <TextBlock Text="清空" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!--  滚动区：每次推理结果一张卡片（最新在最上）  -->
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <ListBox
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                ItemsSource="{Binding TestResults}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Focusable" Value="False" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="10,8"
                                            Background="{StaticResource TechCardBgBrush}"
                                            BorderBrush="{StaticResource TechCardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <StackPanel>
                                                <!--  头行：时间 + 备注徽标  -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource NeonCyanBrush}"
                                                        Text="{Binding TimeText}" />
                                                    <Border
                                                        Grid.Column="1"
                                                        Margin="8,0,0,0"
                                                        Padding="6,1"
                                                        HorizontalAlignment="Right"
                                                        MaxWidth="130"
                                                        Background="{StaticResource TechInnerBgBrush}"
                                                        CornerRadius="8">
                                                        <TextBlock
                                                            FontSize="10.5"
                                                            Foreground="{StaticResource NeonGreenBrush}"
                                                            Text="{Binding Remark, TargetNullValue=—}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding Remark}" />
                                                    </Border>
                                                </Grid>

                                                <!--  产品坐标（标定→世界 mm；未标定→像素并注明）  -->
                                                <TextBlock
                                                    Margin="0,8,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource TechTextLabelBrush}"
                                                    Text="产品坐标" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource NeonOrangeBrush}"
                                                    Text="{Binding CoordText}"
                                                    TextWrapping="Wrap" />

                                                <!--  指标行：角度 / 目标数 / 耗时  -->
                                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TechTextLabelBrush}" Text="角度" />
                                                        <TextBlock
                                                            Margin="0,1,0,0"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Foreground="{StaticResource NeonTealBrush}"
                                                            Text="{Binding AngleText}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TechTextLabelBrush}" Text="目标数" />
                                                        <TextBlock
                                                            Margin="0,1,0,0"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Text="{Binding TargetCount}" />
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TechTextLabelBrush}" Text="耗时" />
                                                        <TextBlock
                                                            Margin="0,1,0,0"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            Text="{Binding CostText}" />
                                                    </StackPanel>
                                                </UniformGrid>

                                                <!--  像素质心（辅助信息）  -->
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontSize="10.5"
                                                    Foreground="{StaticResource TechTextTertiaryBrush}"
                                                    Text="{Binding PixelText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding PixelText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!--  空状态提示（无记录时居中显示，置于 ListBox 上方）  -->
                            <TextBlock
                                MaxWidth="220"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TechTextTertiaryBrush}"
                                Text="尚无推理结果 — 点击上方「测试推理」开始。"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Panel.ZIndex="1"
                                IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestResults.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!--  保留性提示  -->
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,4,0,0"
                            FontSize="10.5"
                            Foreground="{StaticResource TechTextTertiaryBrush}"
                            Text="记录随当前配方保留（重开窗口仍可见），删除该配方后自动释放。"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Grid>
                </TabItem>
                <!--#endregion-->
            </TabControl>
            <!--  底部按钮  -->
            <StackPanel
                Grid.Row="1"
                Margin="0,16,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="80"
                    Margin="0,0,8,0"
                    Padding="16,6"
                    Command="{Binding SaveToFileCommand}"
                    Style="{StaticResource ButtonPrimary}"
                    ToolTip="保存配方 (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="FloppyDisk" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </Button>
                <Button
                    MinWidth="80"
                    Padding="16,6"
                    Click="CloseButton_Click"
                    ToolTip="关闭窗口 (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="X" />
                        <TextBlock Text="关闭" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
