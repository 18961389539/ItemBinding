<Window
    x:Class="AIAgent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AIAgent"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewer="clr-namespace:ImageViewer.Controls;assembly=ImageViewerControl"
    Title="AIAgent"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="16"
            Background="#FFF8FAFC"
            BorderBrush="#FFD9E2EC"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="扫码枪状态" />

                    <Border
                        DockPanel.Dock="Right"
                        Padding="10,4"
                        HorizontalAlignment="Right"
                        Background="#FFE2E8F0"
                        CornerRadius="999">
                        <TextBlock
                            x:Name="ScannerConnectionValue"
                            FontWeight="SemiBold"
                            Foreground="#FF0F172A"
                            Text="未初始化" />
                    </Border>
                </DockPanel>

                <TextBlock
                    x:Name="ScannerStatusMessageValue"
                    Margin="0,0,0,0"
                    Foreground="#FF64748B"
                    Text="等待读取扫码枪信息..." />
            </StackPanel>
        </Border>

        <Border
            Grid.Row="2"
            Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="8" MinWidth="6" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="#FF0F172A"
                    BorderBrush="#FF1E293B"
                    BorderThickness="1"
                    CornerRadius="12">
                    <viewer:ImageViewer x:Name="ScannerImageViewer" />
                </Border>

                <GridSplitter
                    Grid.Column="1"
                    Width="8"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#FFD9E2EC"
                    ShowsPreview="True"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext" />

                <Border
                    Grid.Column="2"
                    Padding="16"
                    Background="#FFF8FAFC"
                    BorderBrush="#FFD9E2EC"
                    BorderThickness="1"
                    CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <UniformGrid Columns="1">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="设备序号" />
                                <TextBlock x:Name="ScannerIndexValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="设备名称" />
                                <TextBlock x:Name="ScannerDeviceNameValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="型号" />
                                <TextBlock x:Name="ScannerModelValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="序列号" />
                                <TextBlock x:Name="ScannerSerialValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="接口类型" />
                                <TextBlock x:Name="ScannerInterfaceValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="IP 地址" />
                                <TextBlock x:Name="ScannerIpValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Foreground="#FF64748B" Text="MAC 地址" />
                                <TextBlock x:Name="ScannerMacValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Foreground="#FF64748B" Text="设备版本" />
                                <TextBlock x:Name="ScannerVersionValue" FontSize="14" FontWeight="SemiBold" Text="-" />
                            </StackPanel>
                        </UniformGrid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
