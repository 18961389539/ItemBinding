<UserControl
    x:Class="MainAPP.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:MainAPP.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    xmlns:services="clr-namespace:MainAPP.Services"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DataContext="{d:DesignInstance vm:HomeViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <!--  ===== 深色科技风页面资源：ScrollBar 隐式应用命名样式（DataGrid 内部 ScrollBar 为模板自动生成，无法直接 Style 引用）  =====  -->
    <UserControl.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
    </UserControl.Resources>

    <!--  ===== 整页深色科技风背景 =====  -->
    <Grid Background="{StaticResource TechPageBackgroundBrush}">
        <!--  装饰性网格背景  -->
        <Rectangle Opacity="0.4">
            <Rectangle.Fill>
                <StaticResource ResourceKey="TechGridBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!--  P0-2: 图像显示区（含顶部扫描枪连接状态指示条）  -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  扫描枪连接状态指示条：断连时显示明显的红色背景  -->
                <Border
                    Grid.Row="0"
                    Height="28"
                    Background="{Binding ScannerStatusColor}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,8,0"
                            Fill="White" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding ScannerStatusText}" />
                    </StackPanel>
                </Border>

                <!--  相机画面容器：深色卡片包裹  -->
                <Border
                    Grid.Row="1"
                    Margin="5"
                    Background="{StaticResource TechCardBgBrush}"
                    BorderBrush="{StaticResource TechCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <controls:ImageViewer
                        x:Name="DisplayControl"
                        ImageSource="{Binding ImageForShow}" />
                </Border>
            </Grid>

            <!--  分隔条：青色细线  -->
            <GridSplitter
                Grid.Column="1"
                Width="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{StaticResource TechCardBorderBrush}"
                ShowsPreview="True" />

            <!--  右侧：TabControl 卡片化容器  -->
            <Border
                Grid.Column="2"
                Margin="5"
                Background="{StaticResource TechCardBgBrush}"
                BorderBrush="{StaticResource TechCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <TabControl
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">

                    <!--  Tab 1: 推理结果  -->
                    <TabItem Style="{StaticResource DarkTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonOrangeBrush}"
                                    Kind="ListMagnifyingGlass" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TechTextSecondaryBrush}"
                                    Text="推理结果" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource TechTextTertiaryBrush}"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Text="{Binding ResultCount, StringFormat='({0})'}" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid>
                            <!--  结果列表：WPF 默认 DataGrid 样式（亮色主题下白底，用户要求移除 DarkDataGridStyle）  -->
                            <DataGrid
                                x:Name="InferenceDataGrid"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserResizeRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding InferenceResults}"
                                SelectionMode="Single">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="CopyBarcodeMenuItem_Click"
                                            Header="复制条码" />
                                        <MenuItem
                                            Click="CopyRowMenuItem_Click"
                                            Header="复制整行" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding ConfidencePercent}" Header="置信度" />
                                    <DataGridTextColumn Binding="{Binding CenterX, StringFormat=F1}" Header="中心X" />
                                    <DataGridTextColumn Binding="{Binding CenterY, StringFormat=F1}" Header="中心Y" />
                                    <DataGridTextColumn Binding="{Binding AngleDisplay}" Header="角度" />
                                    <DataGridTextColumn Binding="{Binding MaskAreaDisplay}" Header="掩码面积" />
                                    <!-- 2026-09-08: 灰度判向统计（仅无角度模型回退+判向时有值，null 显示为空） -->
                                    <DataGridTextColumn
                                        Binding="{Binding BrightMean, StringFormat=F0, TargetNullValue=''}"
                                        Header="亮灰度" />
                                    <DataGridTextColumn
                                        Binding="{Binding DarkMean, StringFormat=F0, TargetNullValue=''}"
                                        Header="暗灰度" />
                                    <DataGridTextColumn
                                        Binding="{Binding BrightnessDiff, StringFormat=F1, TargetNullValue=''}"
                                        Header="亮差" />
                                    <DataGridTextColumn Binding="{Binding Barcode}" Header="条码" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  空状态提示（往下移：距顶部 80px，视觉上位于表格中部）  -->
                            <TextBlock
                                Margin="0,80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Text="暂无推理结果">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStatePrimaryText}">
                                        <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <!--  Tab 2: 发送给机器人的信息（RobotSendMonitor 记录，仅含真实发出 UDP 的产品；被角度未知过滤的产品不入列）  -->
                    <TabItem Style="{StaticResource DarkTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonCyanBrush}"
                                    Kind="PaperPlaneTilt" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TechTextSecondaryBrush}"
                                    Text="发送" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid>
                            <!--  发送记录：WPF 默认样式（与推理结果/日志一致）；行前景色见 RobotSendEntry.Color  -->
                            <DataGrid
                                x:Name="RobotSendDataGrid"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserResizeRows="False"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding Sends, Source={x:Static services:RobotSendMonitor.Instance}}"
                                SelectionMode="Single">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="ClearRobotSends_Click"
                                            Header="清空记录" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Time, StringFormat='HH:mm:ss.fff'}"
                                        Header="时间" />
                                    <DataGridTextColumn
                                        Width="50"
                                        Binding="{Binding Frame}"
                                        Header="帧号" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Barcode}"
                                        Header="条码" />
                                    <DataGridTextColumn
                                        Width="70"
                                        Binding="{Binding X, StringFormat=F2}"
                                        Header="X(mm)" />
                                    <DataGridTextColumn
                                        Width="70"
                                        Binding="{Binding Y, StringFormat=F2}"
                                        Header="Y(mm)" />
                                    <DataGridTextColumn
                                        Width="70"
                                        Binding="{Binding AngleDisplay}"
                                        Header="角度" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  空状态提示  -->
                            <TextBlock
                                Margin="0,80"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Text="暂无发送记录">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyStatePrimaryText}">
                                        <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding Sends.Count, Source={x:Static services:RobotSendMonitor.Instance}}"
                                                Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </TabItem>

                    <!--  Tab 3: 日志  -->
                    <TabItem Style="{StaticResource DarkTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonTealBrush}"
                                    Kind="Scroll" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TechTextSecondaryBrush}"
                                    Text="日志" />
                            </StackPanel>
                        </TabItem.Header>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  日志列表：WPF 默认样式（用户要求移除 DarkDataGridStyle）  -->
                            <DataGrid
                                Name="LogDataGrid"
                                Grid.Row="0"
                                AutoGenerateColumns="False"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding Logs, Source={x:Static services:LogService.Instance}}"
                                RowBackground="{StaticResource TechCardBgBrush}"
                                AlternatingRowBackground="#F5F8FA"
                                Foreground="{StaticResource TechTextPrimaryBrush}"
                                BorderBrush="{StaticResource TechCardBorderBrush}"
                                RowDetailsVisibilityMode="Collapsed"
                                MouseDoubleClick="LogDataGrid_MouseDoubleClick">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="ClearLogs_Click"
                                            Header="清空日志" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}"
                                        FontSize="{StaticResource FontSizeCaption}"
                                        Header="时间">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="*" Header="消息">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="{StaticResource FontSizeMicro}"
                                                    TextWrapping="Wrap"
                                                    Foreground="{Binding Color}"
                                                    Text="{Binding Message}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  清空日志按钮：霓虹风格  -->
                            <Button
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Right"
                                Click="ClearLogs_Click"
                                Content="清空日志"
                                Style="{StaticResource NeonButtonStyle}" />
                        </Grid>
                    </TabItem>

                    <!--  Tab 3: 处理耗时曲线（数据源 TimingLogger.RecentInferenceMs，DispatcherTimer 500ms 节流刷新）  -->
                    <TabItem x:Name="TimingTabItem" Style="{StaticResource DarkTabItemStyle}">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonBlueBrush}"
                                    Kind="ChartLine" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TechTextSecondaryBrush}"
                                    Text="耗时曲线" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="4">
                            <ScottPlot:WpfPlot
                                x:Name="TimingPlot"
                                Background="White" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
