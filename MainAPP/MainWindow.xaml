<Window
    x:Class="MainAPP.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:MainAPP"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MainAPP.Views"
    x:Name="RootWindow"
    Title="ABB-SLV"
    Width="1400"
    Height="900"
    MinWidth="1024"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.InputBindings>
        <!--  F1: 打开关于页/帮助  -->
        <KeyBinding Key="F1" Command="{Binding NavigateToAboutCommand}" />
        <!--  Ctrl+S: 保存当前页面设置（仅当当前页面支持保存时）  -->
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentPageCommand}" />
        <!--  Ctrl+Tab: 切换到下一个页面  -->
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NavigateToNextPageCommand}" />
        <!--  Ctrl+Shift+Tab: 切换到上一个页面  -->
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding NavigateToPreviousPageCommand}" />
        <!--  Ctrl+1~5: 快速切换到指定页面  -->
        <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateToPageCommand}" CommandParameter="Home" />
        <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateToPageCommand}" CommandParameter="Recipe" />
        <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateToPageCommand}" CommandParameter="Database" />
        <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateToPageCommand}" CommandParameter="Settings" />
        <KeyBinding Gesture="Ctrl+5" Command="{Binding NavigateToPageCommand}" CommandParameter="About" />
    </Window.InputBindings>

    <!--  根 Grid：深色科技风页面背景  -->
    <Grid Background="{StaticResource TechPageBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部状态栏（亮色主题：浅灰背景）  -->
        <Border
            Grid.Row="0"
            Background="#E9EDF2"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  状态信息：按"计数 / 设备 / 用户"三组分区，组间用细分隔线  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  组1：计数（读码 + AI 识别）  -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <icons:PackIconPhosphorIcons
                            Width="14" Height="14"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource NeonBlueBrush}"
                            Kind="Barcode" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TechTextLabelBrush}"
                            Text="读码" />
                        <TextBlock
                            MinWidth="56"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TechTextPrimaryBrush}"
                            Text="{Binding Count}" />
                        <TextBlock
                            Margin="16,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TechTextLabelBrush}"
                            Text="AI" />
                        <TextBlock
                            MinWidth="56"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TechTextPrimaryBrush}"
                            Text="{Binding AiCount}" />
                    </StackPanel>

                    <!--  组间分隔线  -->
                    <Rectangle
                        Width="1" Height="20"
                        Margin="20,0"
                        Fill="{StaticResource TechCardBorderBrush}" />

                    <!--  组2：设备（编码器指示灯）  -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse
                            Width="8" Height="8"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource NeonGreenBrush}"
                            ToolTip="编码器接收状态">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource StatusErrorSoftBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEncoderReceiving}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource NeonGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TechTextLabelBrush}"
                            Text="编码器" />
                        <TextBlock
                            MinWidth="56"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TechTextPrimaryBrush}"
                            Text="{Binding EncoderStatusText}" />
                        <TextBlock
                            MinWidth="80"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontFamily="Consolas"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NeonCyanBrush}"
                            Text="{Binding EncoderValueText}"
                            ToolTip="最近一次接收到的编码器值（counts）" />
                    </StackPanel>

                    <!--  组间分隔线  -->
                    <Rectangle
                        Width="1" Height="20"
                        Margin="20,0"
                        Fill="{StaticResource TechCardBorderBrush}" />

                    <!--  组3：用户登录状态  -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <icons:PackIconPhosphorIcons
                            Width="14" Height="14"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource NeonOrangeBrush}"
                            Kind="UserCircle" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TechTextPrimaryBrush}"
                            Text="{Binding LoginStatusText}" />
                    </StackPanel>
                </StackPanel>

                <!--  操作按钮：在深色背景上用白色文字  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="6,0"
                        Padding="12,4"
                        Command="{Binding ResetCountCommand}"
                        Content="清零计数"
                        Foreground="White"
                        Style="{StaticResource ButtonDanger}"
                        ToolTip="清零读码数量、识别数量和去重跟踪列表（换班/换产品场景）"
                        Visibility="{Binding CanResetCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        Margin="6,0"
                        Padding="12,4"
                        Click="LoginButton_Click"
                        Content="{Binding LoginButtonText}"
                        Foreground="White"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  P1-12: 系统状态条：FPS / 内存 / 当前配方 / 推理耗时  -->
        <Border
            Grid.Row="1"
            Background="{StaticResource TechInnerBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel
                    Margin="16,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <!--  FPS  -->
                    <icons:PackIconPhosphorIcons
                        Width="12" Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonOrangeBrush}"
                        Kind="Gauge" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Text="FPS" />
                    <TextBlock
                        MinWidth="48"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#B03D0B"
                        Text="{Binding FpsText}"
                        ToolTip="每秒处理帧数" />

                    <!--  分隔点  -->
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechCardBorderBrush}"
                        Text="|" />

                    <!--  内存  -->
                    <icons:PackIconPhosphorIcons
                        Width="12" Height="12"
                        Margin="20,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonTealBrush}"
                        Kind="Memory" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Text="MEM" />
                    <TextBlock
                        MinWidth="76"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NeonTealBrush}"
                        Text="{Binding MemoryText}"
                        ToolTip="进程工作集内存" />

                    <!--  分隔点  -->
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechCardBorderBrush}"
                        Text="|" />

                    <!--  配方  -->
                    <icons:PackIconPhosphorIcons
                        Width="12" Height="12"
                        Margin="20,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TechTextPrimaryBrush}"
                        Kind="Receipt" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Text="RECIPE" />
                    <TextBlock
                        MaxWidth="180"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TechTextPrimaryBrush}"
                        Text="{Binding CurrentRecipeText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="当前激活配方" />

                    <!--  分隔点  -->
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechCardBorderBrush}"
                        Text="|" />

                    <!--  推理耗时  -->
                    <icons:PackIconPhosphorIcons
                        Width="12" Height="12"
                        Margin="20,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonBlueBrush}"
                        Kind="Lightning" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Text="INFER" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NeonBlueBrush}"
                        Text="{Binding InferenceTimeText}"
                        ToolTip="最近一帧推理耗时 / 总耗时 (设备)" />

                    <!--  分隔点  -->
                    <TextBlock
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechCardBorderBrush}"
                        Text="|" />

                    <!--  丢帧  -->
                    <icons:PackIconPhosphorIcons
                        Width="12" Height="12"
                        Margin="20,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonOrangeBrush}"
                        Kind="WarningCircle" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Text="DROP" />
                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#B03D0B"
                        Text="{Binding DropFrameText}"
                        ToolTip="累计丢帧/跳帧数" />
                </StackPanel>
                <!--  快捷键提示  -->
                <TextBlock
                    Margin="16,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{StaticResource TechTextDimBrush}"
                    Text="F1 关于 · Ctrl+S 保存 · Ctrl+Tab 切页 · Ctrl+1~5 直达" />
            </Grid>
        </Border>

        <!--  主内容区域：深色背景  -->
        <Grid Grid.Row="2" Background="{StaticResource TechPageBgBrush}">
            <TabControl
                x:Name="MainTabControl"
                Background="Transparent"
                BorderThickness="0"
                TabStripPlacement="Left">

                <TabControl.Resources>
                    <!--  TabItem 样式：未选中用浅灰文字，选中时青色高亮，鼠标悬停时浅青色  -->
                    <Style BasedOn="{StaticResource TabItemInLine}" TargetType="TabItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="20,15" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TechTextSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <TabItem Visibility="{Binding CanAccessHome, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="24"
                                Height="24"
                                Kind="House" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="主页" />
                        </StackPanel>
                    </TabItem.Header>

                    <controls:TransitioningContentControl>
                        <Border Margin="10" Background="Transparent">
                            <views:HomeView x:Name="HomeViewControl" />
                        </Border>
                    </controls:TransitioningContentControl>
                </TabItem>

                <TabItem Visibility="{Binding CanAccessRecipes, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="24"
                                Height="24"
                                Kind="Receipt" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="配方" />
                        </StackPanel>
                    </TabItem.Header>
                    <controls:TransitioningContentControl>
                        <Border Margin="10" Background="Transparent">
                            <views:RecipesManageView x:Name="RecipesManageViewControl" />
                        </Border>
                    </controls:TransitioningContentControl>
                </TabItem>
                <TabItem Visibility="{Binding CanAccessDatabase, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="24"
                                Height="24"
                                Kind="Database" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="数据" />
                        </StackPanel>
                    </TabItem.Header>
                    <controls:TransitioningContentControl>
                        <Border Margin="10" Background="Transparent">
                            <views:DatabaseView />
                        </Border>
                    </controls:TransitioningContentControl>
                </TabItem>
                <TabItem Visibility="{Binding CanAccessSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="24"
                                Height="24"
                                Kind="Gear" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="设置" />
                        </StackPanel>
                    </TabItem.Header>
                    <controls:TransitioningContentControl>
                        <Border Margin="10" Background="Transparent">
                            <views:SettingsView />
                        </Border>
                    </controls:TransitioningContentControl>
                </TabItem>
                <TabItem Visibility="{Binding CanAccessLogs, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="24"
                                Height="24"
                                Kind="Notebook" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="日志" />
                        </StackPanel>
                    </TabItem.Header>
                    <controls:TransitioningContentControl>
                        <Border Margin="10" Background="Transparent">
                            <views:LogView />
                        </Border>
                    </controls:TransitioningContentControl>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="24"
                                Height="24"
                                Kind="Info" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Text="关于" />
                        </StackPanel>
                    </TabItem.Header>
                    <controls:TransitioningContentControl>
                        <Border Margin="10" Background="Transparent">
                            <views:AboutView />
                        </Border>
                    </controls:TransitioningContentControl>
                </TabItem>
            </TabControl>
        </Grid>

        <!--  P2-17: HandyControl Growl 全局通知容器，跨所有行底部居中显示通知提示  -->
        <ScrollViewer Grid.Row="0"
                      Grid.RowSpan="3"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,20"
                      Width="320"
                      MaxHeight="600"
                      VerticalScrollBarVisibility="Auto"
                      Background="{x:Null}"
                      Panel.ZIndex="9999">
            <!-- REVIEW(2026-08-05): x:Name 供 NotificationService 按 token 注册容器，实现定时强制关闭 -->
            <StackPanel x:Name="GrowlRootPanel" hc:Growl.GrowlParent="True" Background="{x:Null}" />
        </ScrollViewer>
    </Grid>
</Window>