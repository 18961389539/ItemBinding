<Window x:Class="LicenseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="激活码生成器" Height="420" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="根据机器码生成激活码" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="机器码:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MachineCodeBox" Margin="4" FontFamily="Consolas"
                 ToolTip="客户提供的机器码（4 组 Base32 字符）"/>
        <Button Grid.Row="1" Grid.Column="2" Content="采集本机" Margin="4" Padding="10,3" Click="OnCopyLocalMachine"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="有效期:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4">
            <RadioButton x:Name="PermRadio" Content="永久" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <RadioButton x:Name="DaysRadio" Content="天数" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="DaysBox" Width="60" Text="365" IsEnabled="False"/>
            <RadioButton x:Name="DateRadio" Content="到期日" VerticalAlignment="Center" Margin="12,0,4,0"/>
            <DatePicker x:Name="DateBox" Width="130" IsEnabled="False" SelectedDate="{x:Static sys:DateTime.Now}" xmlns:sys="clr-namespace:System;assembly=System.Runtime"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4,10,4,4">
            <Button x:Name="GenerateButton" Content="生成激活码" Padding="18,6" FontWeight="SemiBold" Click="OnGenerate"/>
            <Button Content="复制" Padding="14,6" Margin="10,0,0,0" Click="OnCopyResult"/>
        </StackPanel>

        <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ResultBox" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="4,8,4,4"
                 FontFamily="Consolas" Background="#F5F6FA" Height="120"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4">
            <TextBlock x:Name="KeyStatus" VerticalAlignment="Center" Foreground="#7F8C8D" FontSize="11"/>
            <Button Content="选择私钥" Padding="8,2" Margin="8,0,0,0" FontSize="11" Click="OnBrowsePrivateKey"/>
        </StackPanel>
    </Grid>
</Window>
