<Window
    x:Class="MainAPP.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="登录系统"
    Width="920"
    Height="600"
    Background="{StaticResource TechPageBackgroundBrush}"
    WindowStartupLocation="CenterOwner"
    WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <!--  特性说明文本样式：深色背景下的次级文字  -->
        <Style x:Key="FeatureTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TechTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  深色输入框样式：内嵌深色底 + 青色聚焦边  -->
        <!--  UI-FIX(2026-08-13): 输入框文字改深色（TechTextPrimaryBrush #263238），
             底色 TechInnerBgBrush 实为近白浅灰 #E9EDF2（DarkTheme 文件内已是亮色配色），
             原 White 文字几乎不可见；CaretBrush 同步改深色避免光标隐形  -->
        <Style x:Key="TechTextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NeonCyanBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  深色密码框样式  -->
        <Style x:Key="TechPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NeonCyanBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  字段标签样式  -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
            <Setter Property="Foreground" Value="{StaticResource TechTextLabelBrush}" />
            <Setter Property="Margin" Value="2,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  UI-FIX(2026-08-13): 登录主按钮：全宽青色渐变 + 白色文字，贴合项目 Accent 体系  -->
        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00838F" />
                                    <GradientStop Offset="1" Color="#00ACC1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPrimaryLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="0.9*" />
        </Grid.ColumnDefinitions>

        <!--  装饰性网格背景  -->
        <Rectangle Grid.ColumnSpan="2" Opacity="0.4">
            <Rectangle.Fill>
                <StaticResource ResourceKey="TechGridBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <!--  ===== 左侧：品牌展示卡片（深色科技风渐变 + 发光 Logo） =====  -->
        <Border
            Grid.Column="0"
            Margin="0,0,16,0"
            Padding="36"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Border.Background>
                <!-- REVIEW-FIX(亮色主题): 品牌卡改浅青白渐变 -->
                <RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.3,0.2" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Offset="0" Color="#EAF3F5" />
                    <GradientStop Offset="1" Color="#F6FAFB" />
                </RadialGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  装饰光晕（亮色主题：浅青光晕）  -->
                <Ellipse
                    Width="240"
                    Height="240"
                    Margin="0,-70,-30,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Fill="#1800838F" />
                <Ellipse
                    Width="160"
                    Height="160"
                    Margin="0,0,30,34"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Fill="#1200838F" />

                <!--  Logo + 标题  -->
                <StackPanel Orientation="Horizontal">
                    <!--  发光圆形 Logo  -->
                    <Border
                        Width="56"
                        Height="56"
                        Margin="0,0,14,0"
                        CornerRadius="28">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#80DEEA" />
                                <GradientStop Offset="1" Color="#00838F" />
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                Opacity="0.7"
                                ShadowDepth="0"
                                Color="#4DD0E1" />
                        </Border.Effect>
                        <icons:PackIconPhosphorIcons
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Barcode" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="{StaticResource TechTextPrimaryBrush}"
                            Text="系统登录" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="{StaticResource FontSizeStat}"
                            Foreground="{StaticResource TechTextSecondaryBrush}"
                            Text="物码绑定系统 · 安全进入工作台" />
                    </StackPanel>
                </StackPanel>

                <!--  特性区  -->
                <StackPanel
                    Grid.Row="1"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,18"
                        FontSize="{StaticResource FontSizeTitle}"
                        Style="{StaticResource FeatureTextStyle}"
                        Text="登录后可访问配方管理、数据和日志页面。" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <!--  特性卡 1  -->
                        <Border
                            Margin="0,0,12,0"
                            Padding="14,12"
                            Background="{StaticResource TechInnerBgBrush}"
                            BorderBrush="{StaticResource TechCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="{StaticResource FontSizeHeader}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TechTextPrimaryBrush}"
                                    Text="智能易用" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{StaticResource TechTextTertiaryBrush}"
                                    Text="产品追溯好帮手" />
                            </StackPanel>
                        </Border>
                        <!--  特性卡 2  -->
                        <Border
                            Padding="14,12"
                            Background="{StaticResource TechInnerBgBrush}"
                            BorderBrush="{StaticResource TechCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    FontSize="{StaticResource FontSizeHeader}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TechTextPrimaryBrush}"
                                    Text="快速登录" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{StaticResource TechTextTertiaryBrush}"
                                    Text="进入即工作" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!--  ===== 右侧：登录表单卡片 =====  -->
        <Border
            Grid.Column="1"
            Margin="0,2,0,2"
            Padding="32"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  关闭按钮  -->
                <Button
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="CancelButton_Click"
                    Content="✕"
                    IsCancel="True"
                    ToolTip="关闭">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!--  欢迎语  -->
                <StackPanel Grid.Row="0" Margin="0,24,0,26">
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{StaticResource TechTextPrimaryBrush}"
                        Text="欢迎回来" />
                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="{StaticResource FontSizeBody}"
                        Foreground="{StaticResource TechTextTertiaryBrush}"
                        Text="请输入账号和密码进入系统" />
                </StackPanel>

                <!--  账号输入（外层 Border 用于校验失败时的红边高亮）  -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="账号" />
                    <Border
                        x:Name="UserNameErrorBorder"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBox
                            x:Name="UserNameTextBox"
                            Style="{StaticResource TechTextBoxStyle}"
                            TextChanged="Input_TextChanged" />
                    </Border>
                </StackPanel>

                <!--  密码输入  -->
                <StackPanel Grid.Row="2" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="密码" />
                    <Border
                        x:Name="PasswordErrorBorder"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="4">
                        <PasswordBox
                            x:Name="PasswordTextBox"
                            Style="{StaticResource TechPasswordBoxStyle}"
                            PasswordChanged="PasswordTextBox_PasswordChanged" />
                    </Border>
                </StackPanel>

                <!--  提示语 + 内联错误提示  -->
                <StackPanel Grid.Row="3" Margin="2,10,0,12">
                    <TextBlock
                        FontSize="{StaticResource FontSizeMicro}"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Text="提示：使用你在设置页中配置的账号登录。" />
                    <!--  UI-FIX(2026-08-13): 内联错误提示，校验失败时显示红字，替代系统弹窗  -->
                    <TextBlock
                        x:Name="ErrorTextBlock"
                        Margin="0,8,0,0"
                        FontSize="{StaticResource FontSizeSmall}"
                        FontWeight="SemiBold"
                        Foreground="#D32F2F"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  操作按钮（全宽渐变主按钮 + 次按钮）  -->
                <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                    <Button
                        x:Name="LoginButton"
                        Height="42"
                        Click="ConfirmButton_Click"
                        Content="登 录"
                        IsDefault="True"
                        Style="{StaticResource LoginPrimaryButtonStyle}" />
                    <Button
                        Margin="0,10,0,0"
                        Height="34"
                        Click="CancelButton_Click"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource NeonButtonStyle}" />
                </StackPanel>

                <!--  页脚：版本信息  -->
                <TextBlock
                    x:Name="VersionText"
                    Grid.Row="5"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource FontSizeMicro}"
                    Foreground="{StaticResource TechTextTertiaryBrush}"
                    Text="物码绑定系统" />
            </Grid>
        </Border>
    </Grid>
</Window>
