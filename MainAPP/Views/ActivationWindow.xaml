<Window x:Class="MainAPP.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件激活" Height="380" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="软件激活" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="机器码:" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MachineCodeBox" Margin="4" IsReadOnly="True"
                 FontFamily="Consolas" Background="#F5F6FA"/>
        <Button Grid.Row="1" Grid.Column="2" Content="复制" Margin="4" Padding="10,3" Click="OnCopyMachine"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="4,6,4,0" TextWrapping="Wrap"
                   Foreground="#7F8C8D" FontSize="11"
                   Text="请将上方机器码发送给厂商，厂商将据此生成激活码。激活码与本机绑定，更换电脑后需重新激活。"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="激活码:" VerticalAlignment="Top" Margin="4,8,4,4" FontWeight="SemiBold"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CodeBox" Margin="4" Height="70"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4,10,4,4">
            <Button Content="激活" Padding="20,6" FontWeight="SemiBold" Click="OnActivate"/>
            <Button Content="退出程序" Padding="20,6" Margin="10,0,0,0" Click="OnExit"/>
        </StackPanel>

        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ResultCard" Margin="4,10,4,0"
                Padding="10,8" BorderThickness="2" CornerRadius="4" BorderBrush="#BDC3C7" Background="#F8F9FA">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Margin="4,8,4,0" TextWrapping="Wrap"
                   Foreground="#7F8C8D" FontSize="11"
                   Text="授权校验为本地离线验证（签名校验），无需联网。到期前请及时联系厂商续期。"/>
    </Grid>
</Window>
