<UserControl
    x:Class="MainAPP.Controls.ImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MainAPP.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        x:Name="rootGrid"
        Background="Transparent"
        ClipToBounds="True">
        <!--  图像和覆盖层容器 - 共享变换  -->
        <Canvas ClipToBounds="False">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="scaleTransform" />
                    <TranslateTransform x:Name="translateTransform" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <Image
                x:Name="image"
                RenderOptions.BitmapScalingMode="NearestNeighbor"
                Stretch="None" />

            <!--  覆盖层 Canvas - 跟随图像变换，子元素由代码动态添加  -->
            <Canvas
                x:Name="overlayCanvas"
                ClipToBounds="False"
                IsHitTestVisible="False" />
        </Canvas>

        <!--  像素网格 - 不跟随图像变换，使用屏幕坐标  -->
        <Canvas x:Name="pixelGridCanvas" IsHitTestVisible="False" />

        <!--  十字准线 - 不跟随图像，始终全屏  -->
        <Line
            x:Name="crosshairH"
            IsHitTestVisible="False"
            Stroke="{StaticResource OverlayCrosshairBrush}"
            StrokeThickness="1"
            Visibility="Collapsed" />
        <Line
            x:Name="crosshairV"
            IsHitTestVisible="False"
            Stroke="{StaticResource OverlayCrosshairBrush}"
            StrokeThickness="1"
            Visibility="Collapsed" />

        <!--  坐标和缩放信息  -->
        <TextBlock
            x:Name="coordTextBlock"
            Margin="5"
            Padding="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Background="{StaticResource OverlayCoordBackgroundBrush}"
            Foreground="White" />

        <!--  测量信息  -->
        <TextBlock
            x:Name="measureTextBlock"
            Margin="5,5,5,30"
            Padding="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Background="{StaticResource OverlayMeasureBackgroundBrush}"
            Foreground="Black"
            Visibility="Collapsed" />

        <!--  ROI 信息  -->
        <TextBlock
            x:Name="roiTextBlock"
            Margin="5,5,5,55"
            Padding="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Background="{StaticResource OverlayRoiBackgroundBrush}"
            FontFamily="Consolas"
            FontSize="11"
            Foreground="Black"
            Visibility="Collapsed" />

        <!--  角度测量信息  -->
        <TextBlock
            x:Name="angleTextBlock"
            Margin="5,5,5,80"
            Padding="3"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Panel.ZIndex="1"
            Background="{StaticResource OverlayAngleBackgroundBrush}"
            FontFamily="Consolas"
            FontSize="11"
            Foreground="Black"
            Visibility="Collapsed" />

        <!--  图像属性面板  -->
        <Border
            x:Name="infoPanel"
            Margin="5"
            Padding="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Background="{StaticResource OverlayInfoPanelBackgroundBrush}"
            CornerRadius="4"
            Visibility="Collapsed">
            <StackPanel>
                <TextBlock
                    x:Name="infoText"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="White" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>