@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject ScannerLiveViewService ScannerService
@inject NavigationManager NavigationManager

<PageTitle>Web Live View</PageTitle>

<h1>扫码枪实时画面</h1>

<div class="grid-page">
    <section class="panel panel-primary">
        <div class="panel-header">
            <div>
                <h2>实时照片</h2>
                <p>扫码枪已切换为软触发模式，并按 200ms 周期触发采集，可在 MJPEG 与 SignalR 预览之间切换。</p>
            </div>
            <div class="header-actions">
                <div class="mode-switch" role="group" aria-label="预览模式切换">
                    <button type="button" class="mode-btn @GetModeButtonClass(LiveViewMode.Mjpeg)" @onclick="() => SwitchMode(LiveViewMode.Mjpeg)">MJPEG</button>
                    <button type="button" class="mode-btn @GetModeButtonClass(LiveViewMode.SignalR)" @onclick="() => SwitchMode(LiveViewMode.SignalR)">SignalR</button>
                </div>
                <button class="btn btn-secondary" @onclick="RefreshNowAsync" disabled="@_busy">立即刷新</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="status status-error">@_errorMessage</div>
        }
        else if (_snapshot is null)
        {
            <div class="status">正在连接扫码枪...</div>
        }
        else
        {
            <div class="image-wrap">
                @if (_liveViewMode == LiveViewMode.Mjpeg)
                {
                    <img class="live-image" src="@_mjpegUrl" alt="扫码枪实时照片" />
                }
                else
                {
                    <img class="live-image" src="@GetSignalRImageSource()" alt="扫码枪实时照片" />
                }
            </div>
            <div class="meta-grid">
                <div><span>预览模式</span><strong>@GetModeDisplayName(_liveViewMode)</strong></div>
                <div><span>采集时间</span><strong>@_snapshot.CapturedAt.ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                <div><span>分辨率</span><strong>@_snapshot.Width × @_snapshot.Height</strong></div>
                <div><span>曝光</span><strong>@_snapshot.Exposure.ToString("0.##")</strong></div>
                <div><span>增益</span><strong>@_snapshot.Gain.ToString("0.##")</strong></div>
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-header compact">
            <div>
                <h2>设备状态</h2>
                <p>支持自动重连、断线提示与 MJPEG 低延迟播放。</p>
            </div>
            <div class="stream-tip">SignalR 实时推送</div>
        </div>

        @if (_isDisconnected)
        {
            <div class="status status-warning">连接已中断，正在自动重连...</div>
        }

        @if (_settings is not null)
        {
            <div class="device-card-list">
                <div class="device-card"><span>型号</span><strong>@_settings.ModelName</strong></div>
                <div class="device-card"><span>序列号</span><strong>@_settings.SerialNumber</strong></div>
                <div class="device-card"><span>IP</span><strong>@_settings.IpAddress</strong></div>
                <div class="device-card"><span>触发模式</span><strong>@_settings.TriggerMode</strong></div>
                <div class="device-card"><span>曝光范围</span><strong>@_settings.ExposureMin.ToString("0.##") ~ @_settings.ExposureMax.ToString("0.##")</strong></div>
                <div class="device-card"><span>增益范围</span><strong>@_settings.GainMin.ToString("0.##") ~ @_settings.GainMax.ToString("0.##")</strong></div>
            </div>
        }
    </section>

    <section class="panel panel-form">
        <div class="panel-header compact">
            <div>
                <h2>曝光 / 增益调试</h2>
                <p>保存后立即生效，再次抓图即可查看效果。</p>
            </div>
        </div>

        @if (_settings is not null)
        {
            <EditForm Model="_editor" OnValidSubmit="SaveSettingsAsync">
                <div class="form-field">
                    <div class="field-head">
                        <label for="exposure">曝光</label>
                        <strong>@_editor.Exposure.ToString("0.##")</strong>
                    </div>
                    <InputNumber id="exposure" class="input input-spinner" @bind-Value="_editor.Exposure" @bind-Value:after="QueueAutoSaveAsync" step="1" min="@_settings.ExposureMin" max="@_settings.ExposureMax" />
                    <div class="range-scale">
                        <span>最小值：@_settings.ExposureMin.ToString("0.##")</span>
                        <span>最大值：@_settings.ExposureMax.ToString("0.##")</span>
                    </div>
                </div>
                <div class="form-field">
                    <div class="field-head">
                        <label for="gain">增益</label>
                        <strong>@_editor.Gain.ToString("0.##")</strong>
                    </div>
                    <InputNumber id="gain" class="input input-spinner" @bind-Value="_editor.Gain" @bind-Value:after="QueueAutoSaveAsync" step="0.1" min="@_settings.GainMin" max="@_settings.GainMax" />
                    <div class="range-scale">
                        <span>最小值：@_settings.GainMin.ToString("0.##")</span>
                        <span>最大值：@_settings.GainMax.ToString("0.##")</span>
                    </div>
                </div>
                <button class="btn" type="submit" disabled="@_busy">立即保存</button>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(_saveMessage))
            {
                <div class="status status-success">@_saveMessage</div>
            }

            @if (_lastSavedAt is not null)
            {
                <div class="save-time">最近一次提交：@_lastSavedAt.Value.ToString("yyyy-MM-dd HH:mm:ss")</div>
            }
        }
    </section>
</div>

@code {
    private LiveViewMode _liveViewMode = LiveViewMode.Mjpeg;
    private ScannerSnapshot? _snapshot;
    private ScannerSettingsState? _settings;
    private ScannerEditorModel _editor = new();
    private string? _errorMessage;
    private string? _saveMessage;
    private DateTime? _lastSavedAt;
    private bool _busy;
    private bool _isDisconnected;
    private string _mjpegUrl = string.Empty;
    private CancellationTokenSource? _autoSaveCts;

    protected override async Task OnInitializedAsync()
    {
        _mjpegUrl = $"{NavigationManager.ToAbsoluteUri("/mjpeg")}?t={Guid.NewGuid():N}";
        ScannerService.SnapshotUpdated += OnSnapshotUpdatedAsync;
        ScannerService.StreamStatusChanged += OnStreamStatusChangedAsync;
        await ScannerService.EnsureStreamingAsync();
        await LoadAsync();
    }

    private async Task RefreshNowAsync()
    {
        await LoadAsync();
    }

    private void SwitchMode(LiveViewMode mode)
    {
        _liveViewMode = mode;
    }

    private Task QueueAutoSaveAsync()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        _autoSaveCts = new CancellationTokenSource();
        var token = _autoSaveCts.Token;

        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(450, token).ConfigureAwait(false);
                if (!token.IsCancellationRequested)
                {
                    await InvokeAsync(SaveSettingsAsync);
                }
            }
            catch (OperationCanceledException)
            {
            }
        }, token);

        return Task.CompletedTask;
    }

    private async Task LoadAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _saveMessage = null;
        try
        {
            _snapshot = await ScannerService.GetSnapshotAsync();
            _settings = await ScannerService.GetSettingsAsync();
            if (_editor is null || (_editor.Exposure == 0 && _editor.Gain == 0))
            {
                _editor = new ScannerEditorModel
                {
                    Exposure = _settings.Exposure,
                    Gain = _settings.Gain
                };
            }

            _errorMessage = ScannerService.LatestError;
            _isDisconnected = !string.IsNullOrWhiteSpace(_errorMessage);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _isDisconnected = true;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SaveSettingsAsync()
    {
        _busy = true;
        try
        {
            _settings = await ScannerService.UpdateSettingsAsync(_editor.Exposure, _editor.Gain);
            _editor.Exposure = _settings.Exposure;
            _editor.Gain = _settings.Gain;
            _saveMessage = "参数已更新";
            _lastSavedAt = DateTime.Now;
            _errorMessage = null;
            _isDisconnected = false;
            _snapshot = await ScannerService.GetSnapshotAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _saveMessage = null;
            _isDisconnected = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task OnSnapshotUpdatedAsync(ScannerSnapshot snapshot)
    {
        _snapshot = snapshot;
        _isDisconnected = false;
        return InvokeAsync(StateHasChanged);
    }

    private Task OnStreamStatusChangedAsync(string? errorMessage)
    {
        _errorMessage = errorMessage;
        _isDisconnected = !string.IsNullOrWhiteSpace(errorMessage);
        return InvokeAsync(StateHasChanged);
    }

    private string GetSignalRImageSource()
    {
        return _snapshot is null ? string.Empty : $"data:{_snapshot.MimeType};base64,{_snapshot.ImageBase64}";
    }

    private string GetModeButtonClass(LiveViewMode mode)
    {
        return _liveViewMode == mode ? "active" : string.Empty;
    }

    private static string GetModeDisplayName(LiveViewMode mode)
    {
        return mode == LiveViewMode.Mjpeg ? "MJPEG" : "SignalR";
    }

    public ValueTask DisposeAsync()
    {
        _autoSaveCts?.Cancel();
        _autoSaveCts?.Dispose();
        ScannerService.SnapshotUpdated -= OnSnapshotUpdatedAsync;
        ScannerService.StreamStatusChanged -= OnStreamStatusChangedAsync;
        return ValueTask.CompletedTask;
    }

    private sealed class ScannerEditorModel
    {
        public float Exposure { get; set; }
        public float Gain { get; set; }
    }

    private enum LiveViewMode
    {
        Mjpeg,
        SignalR
    }
}
