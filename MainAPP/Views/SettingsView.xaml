<UserControl
    x:Class="MainAPP.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:MainAPP.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <!--  ===== 深色科技风：输入控件、TabItem 统一样式（基于默认样式扩展，不破坏 MahApps 模板）  ===== -->
    <UserControl.Resources>
        <!--  TextBox：白字 + 深色内嵌背景 + 卡片边框 + 青色光标  -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NeonCyanBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NeonCyanDeepBrush}" />
        </Style>
        <!--  ComboBox：白字 + 深色背景 + 卡片边框  -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        </Style>
        <!--  PasswordBox：白字 + 深色背景 + 卡片边框 + 青色光标  -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NeonCyanBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource NeonCyanDeepBrush}" />
        </Style>
        <!--  CheckBox：白字（保留默认勾选框样式）  -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
        </Style>
        <!--  TabItem：默认白字，选中时青色 + 底部青色下划线（简单属性覆盖，无 ControlTemplate）  -->
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource TechCardBgBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--  ===== 深色科技风根容器：渐变背景 + 网格装饰底层 =====  -->
    <Grid Background="{StaticResource TechPageBackgroundBrush}">
        <!--  装饰性网格背景  -->
        <Rectangle Opacity="0.3">
            <Rectangle.Fill>
                <StaticResource ResourceKey="TechGridBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <DockPanel Margin="10" Grid.IsSharedSizeScope="True">
            <!--  按钮停靠在底部  -->
            <StackPanel
                HorizontalAlignment="Right"
                DockPanel.Dock="Bottom"
                Orientation="Horizontal">
                <Button
                    Margin="5"
                    Padding="12,6"
                    Command="{Binding ResetToDefaultsCommand}"
                    Style="{StaticResource NeonButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            Kind="ArrowCounterClockwise" />
                        <TextBlock VerticalAlignment="Center" Text="重置为默认" />
                    </StackPanel>
                </Button>
                <Button
                    Margin="5"
                    Padding="12,6"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            Kind="FloppyDisk" />
                        <TextBlock VerticalAlignment="Center" Text="保存设置" />
                        <!--  脏标记：未保存时显示霓虹橙色 *  -->
                        <TextBlock
                            Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="{StaticResource NeonOrangeBrush}"
                            Text="*">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  ===== TabControl 深色化：卡片背景 =====  -->
            <TabControl
                Background="{StaticResource TechCardBgBrush}"
                BorderThickness="0"
                Padding="0">

                <!--  Tab 1: 界面（窗口 + 登录）  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Kind="WindowsLogo" />
                            <TextBlock VerticalAlignment="Center" Text="界面" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="登录超时:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding ExistLoginTimeout}"
                                         ToolTip="无操作多久后自动登出（毫秒，0=禁用，建议 60000-3600000）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="毫秒" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="窗口宽度:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding WindowWidth}"
                                         ToolTip="应用启动时的初始窗口宽度（最小 1024，单位：像素）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="窗口高度:" />
                                <TextBox Grid.Column="4" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding WindowHeight}"
                                         ToolTip="应用启动时的初始窗口高度（最小 700，单位：像素）" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                            </Grid>

                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="窗口标题:" />
                                <TextBox Grid.Column="1" Margin="5" Text="{Binding WindowTitle}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  Tab 2: 数据保留（图片/条码/日志/备份）  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Kind="Database" />
                            <TextBlock VerticalAlignment="Center" Text="数据保留" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Margin="5" Content="保存绘制图像" IsChecked="{Binding IsSaveDraw}" />
                                <CheckBox Margin="5" Content="保存源图像" IsChecked="{Binding IsSaveSource}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="图片保存文件夹:" />
                                <TextBox Grid.Column="1" Margin="5" Text="{Binding PicturesSaveFolder}" />
                                <Button Grid.Column="2" Margin="5" Padding="8,4"
                                        Command="{Binding BrowsePicturesFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconPhosphorIcons Width="14" Height="14" Margin="0,0,4,0" Kind="FolderOpen" />
                                        <TextBlock VerticalAlignment="Center" Text="浏览" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="最近天数:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding MinRecentDays}"
                                         ToolTip="最近多少天内的数据会被保留（建议 1-365 天）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="天" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="条码移除数量:" />
                                <TextBox Grid.Column="4" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding BarcodeRemoveCount}"
                                         ToolTip="条码集合达到上限 100000 时移除的旧条码数量（1-100）" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="个" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="备份过期天数:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding BackupExpireDays}"
                                         ToolTip="备份文件保留天数，超过后自动清理（1-365 天）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="天" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="条码保留天数:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding BarcodeDataRetentionDays}"
                                         ToolTip="条码数据库记录保留天数，超过此天数的记录将自动清理（0=禁用，建议 30-365 天）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="天" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="条码最大条数:" />
                                <TextBox Grid.Column="4" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding BarcodeDataMaxCount}"
                                         ToolTip="条码数据库最大保留记录数，超出时按时间从最旧开始删除（0=不限制，建议 100000-1000000）" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="条" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="日志保留天数:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding LogRetentionDays}"
                                         ToolTip="日志数据库记录保留天数，超过此天数的日志将自动清理（0=禁用，建议 7-90 天）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="天" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="日志最大条数:" />
                                <TextBox Grid.Column="4" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding LogMaxCount}"
                                         ToolTip="日志数据库最大保留记录数，超出时按 id 从最旧开始删除（0=不限制，建议 50000-500000）" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="条" />
                            </Grid>

                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="清理周期:" />
                                <TextBox Grid.Column="1" Width="80" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding DataCleanupIntervalHours}"
                                         ToolTip="数据/日志清理周期（小时），启动时也会立即执行一次（0=仅启动时清理，建议 1-24 小时）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="小时" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  Tab 3: 通信  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Kind="Broadcast" />
                            <TextBlock VerticalAlignment="Center" Text="通信" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="接收方协议:" />
                                <ComboBox Grid.Column="1" Width="100" Margin="5"
                                          ItemsSource="{Binding AvailableReceivers}"
                                          SelectedItem="{Binding MessageReceiver}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="连通性检测IP:" />
                                <TextBox Grid.Column="1" Width="140" Margin="5"
                                         Text="{Binding ConnectivityCheckIP}"
                                         ToolTip="用于周期性 Ping 检测连通性的目标 IPv4 地址（如 192.168.1.100）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="发送结果IP:" />
                                <TextBox Grid.Column="3" Width="140" Margin="5"
                                         Text="{Binding DetectionResultSendIP}"
                                         ToolTip="检测结果 UDP 报文发送的目标 IPv4 地址" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="接收编码器端口:" />
                                <TextBox Grid.Column="1" Width="100" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding EncoderReceiverPort}"
                                         ToolTip="接收编码器报文的 UDP 端口（1-65535）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="发送结果端口:" />
                                <TextBox Grid.Column="3" Width="100" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding DetectionResultSendPort}"
                                         ToolTip="发送检测结果 UDP 报文的目标端口（1-65535）" />
                            </Grid>

                            <!--  测试连接：按钮 + 状态合并区（深色卡片，状态色边框绑定不变）  -->
                            <Border
                                Margin="5,15,5,0"
                                Padding="12,8"
                                Background="{StaticResource TechInnerBgBrush}"
                                BorderBrush="{Binding TestConnectionStatusColor}"
                                BorderThickness="2,0,0,2"
                                CornerRadius="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Button
                                            Padding="12,6"
                                            Command="{Binding TestConnectionCommand}"
                                            IsEnabled="{Binding !IsTestingConnection}">
                                            <StackPanel Orientation="Horizontal">
                                                <icons:PackIconPhosphorIcons
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,5,0"
                                                    Kind="Plugs" />
                                                <TextBlock VerticalAlignment="Center" Text="测试连接" />
                                            </StackPanel>
                                        </Button>
                                        <!--  状态指示：测试中显示旋转图标+文案；空闲且无结果显示空闲文案；有结果显示状态色圆点  -->
                                        <StackPanel
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <!--  状态指示灯：Fill 绑定保持不变  -->
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,6,0"
                                                Fill="{Binding TestConnectionStatusColor}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="点击“测试连接”验证通信参数">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TechMetricValue}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                                                <Setter Property="Text" Value="测试中..." />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TestConnectionResult}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  测试结果文本（仅完成后显示，Consolas 代码感）  -->
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        FontFamily="Consolas"
                                        Text="{Binding TestConnectionResult}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TechMetricValue}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TestConnectionResult}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTestingConnection}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  Tab 4: 检测与去重  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Kind="Funnel" />
                            <TextBlock VerticalAlignment="Center" Text="检测与去重" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <!--  2026-09-07: 用 GroupBox 按语义分组（去重匹配 / 边界过滤 / 面积过滤）  -->
                            <GroupBox Margin="0,0,0,10" Style="{StaticResource DarkGroupBoxStyle}" Header="去重匹配">
                                <StackPanel>
                            <TextBlock
                                Margin="5,0,0,8"
                                Style="{StaticResource CardDescriptionText}"
                                Foreground="{StaticResource TechTextTertiaryBrush}"
                                Text="位置阈值同时用于有条码和无条码产品的去重匹配；有条码产品使用 3 倍位置阈值作为容差，以区分同条码不同位置的产品。" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="启用去重:" />
                                <CheckBox Grid.Column="1" Margin="5" VerticalAlignment="Center" IsChecked="{Binding DedupEnabled}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="20,5,5,5" Text="匹配轴:" />
                                <ComboBox Grid.Column="3" Width="80" Margin="5"
                                          ItemsSource="{Binding AvailableAxes}"
                                          SelectedItem="{Binding DedupTrackAxis}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="位置阈值:" />
                                <TextBox Grid.Column="1" Width="100" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding DedupPositionThreshold}"
                                         ToolTip="位置差小于此阈值视为同一产品（单位：mm，建议 0.5-10.0）" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="mm" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="5,5,5,5" Text="角度阈值:" />
                                <TextBox Grid.Column="4" Width="100" Margin="5"
                                         PreviewTextInput="NumberValidation_PreviewTextInput"
                                         DataObject.Pasting="NumberValidation_Pasting"
                                         Text="{Binding DedupAngleThreshold}"
                                         ToolTip="角度差小于此阈值视为同一产品（单位：度，建议 0.5-5.0）" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="°" />
                            </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!--  2026-09-05: 四边独立边缘最小间距可配置：对应边距图像边缘不足该值判定无效 -->
                            <GroupBox Margin="0,0,0,10" Style="{StaticResource DarkGroupBoxStyle}" Header="边界过滤（防半个产品）">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  第 1 行：左 | 右  -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="左边缘间距:" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Width="100"
                                    Margin="5"
                                    PreviewTextInput="NumberValidation_PreviewTextInput"
                                    DataObject.Pasting="NumberValidation_Pasting"
                                    Text="{Binding EdgeMarginLeftPixels}"
                                    ToolTip="检测框左边距图像左边界必须≥此值（像素）才有效。设为 0 表示允许检测框贴左边缘。" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="20,5,5,5" Text="右边缘间距:" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="4"
                                    Width="100"
                                    Margin="5"
                                    PreviewTextInput="NumberValidation_PreviewTextInput"
                                    DataObject.Pasting="NumberValidation_Pasting"
                                    Text="{Binding EdgeMarginRightPixels}"
                                    ToolTip="检测框右边距图像右边界必须≥此值（像素）才有效。设为 0 表示允许检测框贴右边缘。" />
                                <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />

                                <!--  第 2 行：上 | 下  -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="上边缘间距:" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Width="100"
                                    Margin="5"
                                    PreviewTextInput="NumberValidation_PreviewTextInput"
                                    DataObject.Pasting="NumberValidation_Pasting"
                                    Text="{Binding EdgeMarginTopPixels}"
                                    ToolTip="检测框上边距图像上边界必须≥此值（像素）才有效。设为 0 表示允许检测框贴上边缘。" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="20,5,5,5" Text="下边缘间距:" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    Width="100"
                                    Margin="5"
                                    PreviewTextInput="NumberValidation_PreviewTextInput"
                                    DataObject.Pasting="NumberValidation_Pasting"
                                    Text="{Binding EdgeMarginBottomPixels}"
                                    ToolTip="检测框下边距图像下边界必须≥此值（像素）才有效。设为 0 表示允许检测框贴下边缘。" />
                                <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                            </Grid>
                            </GroupBox>

                            <!--  2026-09-07: 产品掩码面积上下限过滤（全局默认，0=禁用）；配方可单独覆盖（配方编辑→AI模型）  -->
                            <GroupBox Style="{StaticResource DarkGroupBoxStyle}" Header="面积过滤（按掩码像素面积）">
                                <StackPanel>
                                    <TextBlock
                                        Margin="5,0,0,6"
                                        Style="{StaticResource CardDescriptionText}"
                                        Foreground="{StaticResource TechTextTertiaryBrush}"
                                        Text="全局默认：若某配方在“配方编辑 → AI模型 → 边缘检测模型”中单独填写了面积值，则按配方值生效；此处 0 = 不启用对应方向。" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="UnitCol" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="最小面积:" />
                                <TextBox
                                    Grid.Column="1"
                                    Width="100"
                                    Margin="5"
                                    PreviewTextInput="NumberValidation_PreviewTextInput"
                                    DataObject.Pasting="NumberValidation_Pasting"
                                    Text="{Binding MinMaskAreaPixels}"
                                    ToolTip="分割掩码面积（原图像素）低于此值的目标判定无效并过滤（不落库/不发送/不计数）。设为 0 表示不启用下限。" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TechMetricLabel}" Margin="20,5,5,5" Text="最大面积:" />
                                <TextBox
                                    Grid.Column="4"
                                    Width="100"
                                    Margin="5"
                                    PreviewTextInput="NumberValidation_PreviewTextInput"
                                    DataObject.Pasting="NumberValidation_Pasting"
                                    Text="{Binding MaxMaskAreaPixels}"
                                    ToolTip="分割掩码面积（原图像素）高于此值的目标判定无效并过滤（不落库/不发送/不计数）。设为 0 表示不启用上限。" />
                                <TextBlock Grid.Column="5" Style="{StaticResource TechMetricLabel}" Margin="0,5,5,5" Text="px" />
                            </Grid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  Tab 5: 安全  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource StatusWarningBrush}"
                                Kind="Lock" />
                            <TextBlock VerticalAlignment="Center" Text="安全" />
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <StackPanel>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="账号:" />
                                <TextBox Grid.Column="1" Width="140" Margin="5" Text="{Binding UserName}" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="5" Text="密码:" />
                                <PasswordBox
                                    x:Name="PasswordBox"
                                    Grid.Column="3"
                                    Width="140"
                                    Margin="5"
                                    PasswordChanged="PasswordBox_PasswordChanged" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--  Tab: 通讯协议（2026-09-13 自定义模板协议）  -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="通讯协议" />
                            <Button
                                Margin="6,0,0,0"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                Click="ProtocolTabHelp_Click"
                                Content="?"
                                FontWeight="Bold"
                                ToolTip="查看自定义通讯协议说明" />
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：协议列表（搜索 + 启用置顶）+ 当前接收方 -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource TechMetricLabel}" VerticalAlignment="Center" Text="接收方协议：" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding ProtocolVM.CurrentReceiver}" />
                            </StackPanel>
                            <!--  2026-09-17: 发送角度域。机械手腕关节只能转 ±90 时选「-90 ~ 90（折叠）」，
                                  折叠 180° 只对 180° 对称的产品/夹爪成立；落库值始终是 -180~180，仅发送值折算。  -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource TechMetricLabel}" VerticalAlignment="Center" Text="默认角度域：" />
                                <ComboBox MinWidth="230"
                                          SelectedValue="{Binding ProtocolVM.DefaultAngleDomain, Mode=TwoWay}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Display"
                                          ItemsSource="{Binding Source={x:Static vm:ProtocolSettingsViewModel.GlobalAngleDomainOptions}}"
                                          ToolTip="作用于内置 VGT/LL 报文，以及未单独设置角度域的协议项。折叠域仅适用于 180° 对称的产品或夹爪。" />
                            </StackPanel>
                            <TextBox Margin="0,0,0,6" Text="{Binding ProtocolVM.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="按名称过滤协议" />
                            <DataGrid
                                Height="300"
                                AutoGenerateColumns="False"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding ProtocolVM.ProtocolsView}"
                                SelectedItem="{Binding ProtocolVM.Selected, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Width="50" Header="启用" Binding="{Binding Enabled}" />
                                    <DataGridTextColumn Width="*" Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Width="*" Header="端点 ip:port" Binding="{Binding EndPoint, UpdateSourceTrigger=PropertyChanged}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="＋ 新增" Margin="0,0,8,0" Command="{Binding ProtocolVM.AddProtocolCommand}" />
                                <Button Content="删除" Margin="0,0,8,0" Command="{Binding ProtocolVM.DeleteProtocolCommand}" />
                                <Button Content="保存" Margin="0,0,0,0" Command="{Binding ProtocolVM.SaveCommand}" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TechMetricLabel}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="把主页「接收方协议」填成协议名即切换；保存后启用项自动置顶。" />
                        </StackPanel>

                        <!-- 右：详情（选中协议） -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource TechMetricLabel}" FontWeight="Bold" VerticalAlignment="Center" Text="协议详情" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProtocolVM.InUseBadgeText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#9a9aa8" />
                                                        <Setter Property="FontSize" Value="12" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProtocolVM.IsCurrentInUse}" Value="True">
                                                                <Setter Property="Foreground" Value="#3ddc84" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>

                                <!-- 基本信息 -->
                                <Border Background="{StaticResource TechCardBgBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="5" Text="名称:" />
                                        <TextBox Grid.Column="1" Margin="5" Text="{Binding ProtocolVM.Selected.Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource TechMetricLabel}" Margin="5" Text="端点:" />
                                        <TextBox Grid.Column="3" Margin="5" Text="{Binding ProtocolVM.Selected.EndPoint, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource TechMetricLabel}" Margin="5" Text="传输:" />
                                        <TextBox Grid.Column="5" Margin="5" Text="{Binding ProtocolVM.Selected.Transport, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>

                                <!-- 策略分组：发送行为 / 无码策略 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource TechCardBgBrush}" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TechMetricLabel}" FontWeight="Bold" Margin="0,0,0,6" Text="发送行为" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Style="{StaticResource TechMetricLabel}" Margin="5,0" Text="行尾:" />
                                                <ComboBox SelectedValue="{Binding ProtocolVM.Selected.LineEnding}"
                                                          ItemsSource="{Binding Source={x:Static vm:ProtocolSettingsViewModel.LineEndings}}" />
                                            </StackPanel>
                                            <CheckBox Margin="5,6,0,0" Content="角度未知拒发（-9999）"
                                                      IsChecked="{Binding ProtocolVM.Selected.RejectWhenAngleUnknown}" />
                                            <!--  2026-09-17: 本协议的角度域（覆盖全局默认）。预览与实发同源。  -->
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Style="{StaticResource TechMetricLabel}" Margin="5,0" VerticalAlignment="Center" Text="角度域:" />
                                                <ComboBox Width="190"
                                                          SelectedValue="{Binding ProtocolVM.Selected.AngleDomain, Mode=TwoWay}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Display"
                                                          ItemsSource="{Binding Source={x:Static vm:ProtocolSettingsViewModel.AngleDomainOptions}}"
                                                          ToolTip="留「跟随默认」即用全局设置。折叠域只对 180° 对称的产品/夹爪成立——有头尾的产品请勿使用，否则会把「装反」发成正常角度。" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource TechCardBgBrush}" CornerRadius="4" Padding="8" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TechMetricLabel}" FontWeight="Bold" Margin="0,0,0,6" Text="无码策略" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Style="{StaticResource TechMetricLabel}" Margin="5,0" Text="行为:" />
                                                <ComboBox Width="130" SelectedValue="{Binding ProtocolVM.Selected.NoBarcodeBehavior}"
                                                          ItemsSource="{Binding Source={x:Static vm:ProtocolSettingsViewModel.NoBarcodeBehaviors}}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Style="{StaticResource TechMetricLabel}" Margin="5,0" Text="占位:" />
                                                <TextBox Width="130" Text="{Binding ProtocolVM.Selected.NoBarcodePlaceholder, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 段编辑（↑↓ 调整顺序，绿色=命中，灰色=条件未满足跳过） -->
                                <Border Background="{StaticResource TechCardBgBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="＋ 追加段" Command="{Binding ProtocolVM.AddSegmentCommand}" />
                                            <TextBlock Style="{StaticResource TechMetricLabel}" VerticalAlignment="Center"
                                                       Text="模板段（按顺序拼接；绿色=命中，灰色=条件未满足跳过）" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding ProtocolVM.SegmentPreviews}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2" Padding="4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="#33333d" />
                                                                <Setter Property="BorderThickness" Value="1" />
                                                                <Setter Property="CornerRadius" Value="4" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Matched}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#3ddc84" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Matched}" Value="False">
                                                                        <Setter Property="BorderBrush" Value="#7d7d8e" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Style="{StaticResource TechMetricLabel}" Margin="4,0" VerticalAlignment="Center"
                                                                       Text="{Binding Index}" />
                                                            <ComboBox Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                                                                      SelectedValue="{Binding Segment.Condition}"
                                                                      ItemsSource="{Binding Source={x:Static vm:ProtocolSettingsViewModel.SegmentConditions}}" />
                                                            <TextBox Grid.Column="2" Margin="4,0" VerticalAlignment="Center"
                                                                     Text="{Binding Segment.Text, UpdateSourceTrigger=PropertyChanged}" />
                                                            <Button Grid.Column="3" Margin="4,0" Content="↑" Padding="2,0"
                                                                    Command="{Binding DataContext.ProtocolVM.MoveSegmentUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Segment}" ToolTip="上移" />
                                                            <Button Grid.Column="4" Margin="4,0" Content="↓" Padding="2,0"
                                                                    Command="{Binding DataContext.ProtocolVM.MoveSegmentDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Segment}" ToolTip="下移" />
                                                            <Button Grid.Column="5" Margin="4,0" Content="×" Padding="2,0"
                                                                    Command="{Binding DataContext.ProtocolVM.RemoveSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding Segment}" ToolTip="删除段" />
                                                            <TextBlock Grid.Column="6" Margin="4,0" VerticalAlignment="Center" FontSize="11"
                                                                       Text="{Binding Status}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#7d7d8e" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Matched}" Value="True">
                                                                                <Setter Property="Foreground" Value="#3ddc84" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- 试算预览 + 发送测试 -->
                                <Border Background="{StaticResource TechCardBgBrush}" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TechMetricLabel}" FontWeight="Bold" Margin="0,0,0,4"
                                                   Text="试算预览（改样例即刷新；与生产同一渲染实现）" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding ProtocolVM.SampleX, UpdateSourceTrigger=PropertyChanged}" ToolTip="X (mm)" />
                                            <TextBox Grid.Column="1" Margin="0,0,4,0" Text="{Binding ProtocolVM.SampleY, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y (mm)" />
                                            <TextBox Grid.Column="2" Margin="0,0,4,0" Text="{Binding ProtocolVM.SampleRz, UpdateSourceTrigger=PropertyChanged}" ToolTip="RZ (度)" />
                                            <TextBox Grid.Column="3" Margin="0,0,4,0" Text="{Binding ProtocolVM.SampleBarcode, UpdateSourceTrigger=PropertyChanged}" ToolTip="条码（清空=无码）" />
                                            <TextBox Grid.Column="4" Text="{Binding ProtocolVM.SampleEncoder, UpdateSourceTrigger=PropertyChanged}" ToolTip="编码器（留空=未收到）" />
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas"
                                                   Text="{Binding ProtocolVM.PreviewText}" />
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Left" Content="发送测试报文（UDP）" Command="{Binding ProtocolVM.SendTestCommand}" />
                                            <TextBlock Margin="10,4,0,0" VerticalAlignment="Center" Text="{Binding ProtocolVM.TestSendResult}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9a9aa8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProtocolVM.TestSendOk}" Value="True">
                                                                <Setter Property="Foreground" Value="#3ddc84" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolVM.TestSendOk}" Value="False">
                                                                <Setter Property="Foreground" Value="#ff6b6b" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource TechMetricLabel}" Foreground="#888888"
                                                   Text="{Binding ProtocolVM.PreviewNote}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
