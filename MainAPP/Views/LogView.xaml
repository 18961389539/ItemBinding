<UserControl
    x:Class="MainAPP.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  ===== 统计徽章样式：基于 Tech 指标样式，覆盖居中对齐与字号  ===== -->
        <Style x:Key="LogStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TechMetricValue}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LogStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TechMetricLabel}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--  ===== 深色科技风：输入控件隐式样式  ===== -->
        <!--  TextBox：白字 + 深色内框 + 白色光标  -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <!--  ComboBox：白字 + 深色内框  -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        </Style>
        <!--  ComboBoxItem：白字  -->
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!--  DatePicker：白字 + 深色内框  -->
        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        </Style>

        <!--  ===== DataGrid 深色科技风：已抽取到 Themes/Controls/DataGridDarkStyles.xaml  =====  -->
        <!--  REVIEW: DataGrid 已改用 WPF 默认样式（DarkDataGridStyle 已按要求移除），此注释仅保留样式定义位置说明  -->
        <!--  ScrollBar 隐式应用命名样式（DataGrid 内部 ScrollBar 为模板自动生成，无法直接 Style 引用）  -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
    </UserControl.Resources>

    <!--  ===== 根 Grid：深色科技风渐变背景  ===== -->
    <Grid Background="{StaticResource TechPageBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  装饰性网格背景层（横跨所有行，作为底层装饰，不挡住其他内容）  -->
        <Rectangle Grid.RowSpan="6" Opacity="0.3">
            <Rectangle.Fill>
                <StaticResource ResourceKey="TechGridBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <!--  ===== 顶部标题栏：青色图标 + 标题 + 统计徽章  ===== -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!--  青色图标徽章  -->
                    <Border
                        Width="48"
                        Height="48"
                        Margin="0,0,12,0"
                        Background="{StaticResource NeonCyanDeepBrush}"
                        CornerRadius="10">
                        <icons:PackIconPhosphorIcons
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Notebook" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <!--  标题：TechCardTitleText 基础 + 大号字号覆盖（与图标视觉平衡）  -->
                        <TextBlock
                            Style="{StaticResource TechCardTitleText}"
                            FontSize="{StaticResource FontSizeHeader}"
                            Text="运行日志" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource TechTextTertiaryBrush}"
                            Text="直接管理 SQLite 数据库中的日志记录。" />
                    </StackPanel>
                </StackPanel>

                <!--  统计徽章组  -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border
                        MinWidth="92"
                        Margin="6,0"
                        Padding="10,6"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource TechCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LogStatValueStyle}" Text="{Binding TotalLogCount}" />
                            <TextBlock Style="{StaticResource LogStatLabelStyle}" Text="数据库总数" />
                        </StackPanel>
                    </Border>
                    <Border
                        MinWidth="92"
                        Margin="6,0"
                        Padding="10,6"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource TechCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LogStatValueStyle}" Text="{Binding VisibleLogCount}" />
                            <TextBlock Style="{StaticResource LogStatLabelStyle}" Text="筛选结果" />
                        </StackPanel>
                    </Border>
                    <Border
                        MinWidth="170"
                        Margin="6,0"
                        Padding="10,6"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource TechCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LogStatValueStyle}" Text="{Binding LatestLogTimeText}" />
                            <TextBlock Style="{StaticResource LogStatLabelStyle}" Text="最新记录" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!--  ===== 时间范围 + 级别筛选面板  ===== -->
        <Border
            Grid.Row="1"
            Margin="0,10,0,0"
            Padding="12"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource TechMetricLabel}"
                    Text="时间范围:" />

                <DatePicker
                    SelectedDate="{Binding StartTimeFilter}"
                    Width="120"
                    ToolTip="起始日期（包含）" />

                <TextBlock
                    VerticalAlignment="Center"
                    Margin="5,0"
                    Style="{StaticResource TechMetricLabel}"
                    Text="至" />

                <DatePicker
                    SelectedDate="{Binding EndTimeFilter}"
                    Width="120"
                    ToolTip="结束日期（包含）" />

                <!--  快捷按钮：霓虹风格  -->
                <Button
                    Content="今日"
                    Margin="5,0,0,0"
                    Padding="8,3"
                    Command="{Binding SetTodayFilterCommand}"
                    Style="{StaticResource NeonButtonStyle}" />
                <Button
                    Content="最近7天"
                    Margin="5,0,0,0"
                    Padding="8,3"
                    Command="{Binding SetLast7DaysFilterCommand}"
                    Style="{StaticResource NeonButtonStyle}" />
                <Button
                    Content="最近30天"
                    Margin="5,0,0,0"
                    Padding="8,3"
                    Command="{Binding SetLast30DaysFilterCommand}"
                    Style="{StaticResource NeonButtonStyle}" />
                <Button
                    Content="清除筛选"
                    Margin="5,0,0,0"
                    Padding="8,3"
                    Command="{Binding ClearFilterCommand}"
                    Style="{StaticResource NeonButtonStyle}" />

                <!--  级别筛选  -->
                <TextBlock
                    VerticalAlignment="Center"
                    Margin="15,0,5,0"
                    Style="{StaticResource TechMetricLabel}"
                    Text="级别:" />
                <ComboBox
                    ItemsSource="{Binding AvailableLevels}"
                    SelectedItem="{Binding SelectedLevel}"
                    Width="100"
                    ToolTip="按级别筛选（留空查看全部）" />
            </StackPanel>
        </Border>

        <!--  ===== 关键字搜索 + 操作按钮面板  ===== -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,10"
            Padding="12"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Margin="0,0,14,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:PackIconPhosphorIcons
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonCyanBrush}"
                        Kind="MagnifyingGlass" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricLabel}"
                        Text="关键字" />
                    <TextBox
                        Width="240"
                        Margin="8,0,0,0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入数据库日志内容或级别关键词" />
                    <!--  关键字实时筛选状态提示  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        FontSize="{StaticResource FontSizeMicro}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                <Setter Property="Text" Value="筛选中..." />
                                <Style.Triggers>
                                    <!--  有关键字：显示"筛选中..."（灰色小字）  -->
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!--  关键字非空但无匹配结果：显示"无匹配结果"（橙色小字）
                                        此触发器在 IsSearching 之后，会覆盖上面的状态  -->
                                    <DataTrigger Binding="{Binding IsNoSearchMatch}" Value="True">
                                        <Setter Property="Text" Value="无匹配结果" />
                                        <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding ReloadLogsCommand}"
                    Style="{StaticResource ButtonPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="ArrowsClockwise" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>

                <Button
                    Margin="0,0,8,0"
                    Padding="12,6"
                    Command="{Binding CopySelectedCommand}"
                    Style="{StaticResource ButtonSuccess}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Copy" />
                        <TextBlock Text="复制选中" />
                    </StackPanel>
                </Button>

                <Button
                    Padding="12,6"
                    Command="{Binding ClearLogsCommand}"
                    Style="{StaticResource ButtonDanger}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="14"
                            Height="14"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Trash" />
                        <TextBlock Text="清空日志" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!--  ===== 保留策略状态条  ===== -->
        <Border
            Grid.Row="3"
            Margin="0,0,0,10"
            Padding="10,5"
            Background="{StaticResource TechInnerBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  日志总数  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:PackIconPhosphorIcons
                        Width="14"
                        Height="14"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Kind="Database" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource TechMetricLabel}"
                        Text="日志总数: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricValue}"
                        Text="{Binding LogCountDisplay}" />
                </StackPanel>

                <!--  使用率进度条
                    P0-FIX: ProgressBar.Value 默认 TwoWay 绑定，LogCountPercent 为只读属性，
                    必须显式指定 Mode=OneWay，否则窗口布局更新时反复抛 InvalidOperationException 导致 UI 无法渲染  -->
                <ProgressBar
                    Grid.Column="1"
                    Margin="15,0"
                    VerticalAlignment="Center"
                    Height="10"
                    Value="{Binding LogCountPercent, Mode=OneWay}"
                    Maximum="100">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLogCountWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!--  最早记录  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <icons:PackIconPhosphorIcons
                        Width="14"
                        Height="14"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Kind="Clock" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricLabel}"
                        Text="最早: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricValue}"
                        Text="{Binding OldestLogTimeDisplay}" />
                </StackPanel>

                <!--  策略说明  -->
                <TextBlock
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource TechMetricLabel}"
                    Text="{Binding RetentionPolicyDisplay}" />

                <!--  立即清理按钮：危险操作语义  -->
                <Button
                    Grid.Column="4"
                    Margin="10,0,0,0"
                    Padding="8,3"
                    Command="{Binding CleanupNowCommand}"
                    Style="{StaticResource ButtonDanger}"
                    ToolTip="根据保留策略立即清理过期日志">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="12"
                            Height="12"
                            Margin="0,0,3,0"
                            VerticalAlignment="Center"
                            Kind="Broom" />
                        <TextBlock Text="立即清理" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  ===== DataGrid 容器 + 空状态覆盖层 + 加载更多  ===== -->
        <Border
            Grid.Row="4"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid
                    x:Name="LogDataGrid"
                    Grid.Row="0"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeRows="False"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    FrozenColumnCount="1"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding LogsView}"
                    SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    MouseDoubleClick="LogDataGrid_MouseDoubleClick">
                    <!-- REVIEW: DarkDataGridStyle 已按要求移除，使用 WPF 默认样式 -->
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="170"
                            Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                            Header="时间" />
                        <DataGridTemplateColumn Width="70" Header="级别">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{Binding Color}"
                                        CornerRadius="3"
                                        Padding="5,2"
                                        Margin="2"
                                        ToolTip="{Binding LevelFullName}">
                                        <TextBlock
                                            Text="{Binding LevelDisplay}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*" Header="内容">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Padding="4,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Color}"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Binding="{Binding FormattedException}"
                            Header="异常"
                            Width="300">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  空状态覆盖层  -->
                <Border
                    Grid.Row="0"
                    Background="{StaticResource TechCardBgBrush}"
                    IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <icons:PackIconPhosphorIcons
                            Kind="Empty"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource TechTextLabelBrush}" />
                        <!--  空状态主标题：根据是否有筛选条件切换显示
                            - 无筛选 + 无数据：暂无日志记录
                            - 有筛选 + 无数据：未找到匹配的日志，请尝试修改筛选条件  -->
                        <TextBlock
                            Margin="0,10"
                            Text="{Binding EmptyStateTitle}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource EmptyStatePrimaryText}" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TechTextSecondaryBrush}" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding EmptyStateHint}">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource EmptyStateSecondaryText}" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!--  加载更多按钮：霓虹风格  -->
                <Button
                    Grid.Row="1"
                    Command="{Binding LoadMoreCommand}"
                    Content="加载更多"
                    Margin="5"
                    Padding="10,5"
                    HorizontalAlignment="Center">
                    <Button.Style>
                        <Style BasedOn="{StaticResource NeonButtonStyle}" TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMoreLogs}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!--  ===== 详情面板  ===== -->
        <Border
            Grid.Row="5"
            Margin="0,10,0,0"
            Padding="12"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,12,0" VerticalAlignment="Top">
                    <!--  详情标题  -->
                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource TechCardTitleText}"
                        Text="选中记录详情" />
                    <!--  时间标签 + 值  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource TechMetricLabel}"
                        Text="时间:" />
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource TechMetricValue}"
                        Text="{Binding SelectedLog.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}, TargetNullValue=暂无}" />
                    <!--  级别标签 + 值（级别色由绑定决定，无选中时回退到 TechTextDimBrush）  -->
                    <TextBlock
                        Margin="0,0,0,4"
                        Style="{StaticResource TechMetricLabel}"
                        Text="级别:" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontWeight="SemiBold"
                        Foreground="{Binding SelectedLog.Color, TargetNullValue={StaticResource TechTextDimBrush}}"
                        Text="{Binding SelectedLog.Level, TargetNullValue=未选择日志}" />
                    <!--  异常标签 + 值（错误色）  -->
                    <TextBlock
                        Margin="0,10,0,4"
                        Style="{StaticResource TechMetricLabel}"
                        Text="异常:" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontFamily="Consolas"
                        Foreground="{StaticResource StatusErrorBrush}"
                        Text="{Binding SelectedLog.FormattedException, TargetNullValue=无}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  右侧：完整消息内容  -->
                <Border
                    Grid.Column="1"
                    Padding="12"
                    Background="{StaticResource TechInnerBgBrush}"
                    BorderBrush="{StaticResource TechCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock
                        Foreground="{StaticResource TechTextTertiaryBrush}"
                        Text="{Binding SelectedLog.RenderedMessage, TargetNullValue=双击某条记录即可复制并在此查看完整内容。}"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!--  ===== 日志加载 Loading 覆盖层（参考 DatabaseView 的 IsBusy 实现）  ===== -->
        <!--  REVIEW-FIX(亮色主题): 覆盖层改浅色半透明 + 深色文字  -->
        <Border
            Grid.RowSpan="6"
            Background="#CCF2F5F8"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <ProgressBar
                    Width="40"
                    Height="40"
                    IsIndeterminate="True"
                    Maximum="100"
                    Minimum="0" />
                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="{StaticResource FontSizeStat}"
                    Foreground="{StaticResource TechTextPrimaryBrush}"
                    Text="正在加载日志..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
