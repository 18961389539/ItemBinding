<UserControl
    x:Class="ImageViewer.Controls.ImageViewer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ImageViewer.Controls"
    xmlns:localization="clr-namespace:ImageViewer.Localization"
    xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    AllowDrop="True"
    UseLayoutRounding="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <LinearGradientBrush x:Key="ViewerBackdropBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0E141D" Offset="0" />
            <GradientStop Color="#0A0F16" Offset="0.55" />
            <GradientStop Color="#080B11" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ViewerSurfaceBrush" Color="#18212E" />
        <SolidColorBrush x:Key="ViewerSurfaceAltBrush" Color="#111824" />
        <SolidColorBrush x:Key="ViewerPanelBorderBrush" Color="#314158" />
        <SolidColorBrush x:Key="ViewerAccentBrush" Color="#69AFFF" />
        <SolidColorBrush x:Key="ViewerAccentSoftBrush" Color="#2869AFFF" />
        <SolidColorBrush x:Key="ViewerAccentBorderBrush" Color="#567FD6FF" />
        <SolidColorBrush x:Key="ViewerTextPrimaryBrush" Color="#F5F8FC" />
        <SolidColorBrush x:Key="ViewerTextSecondaryBrush" Color="#AAB5C3" />
        <SolidColorBrush x:Key="ViewerButtonHoverBrush" Color="#243245" />
        <SolidColorBrush x:Key="ViewerButtonPressedBrush" Color="#2D3D54" />
        <SolidColorBrush x:Key="ViewerChipBorderBrush" Color="#35506D" />

        <ControlTemplate x:Key="ViewerChromeButtonTemplate" TargetType="{x:Type ButtonBase}">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ViewerButtonHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ViewerButtonPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ViewerFloatingPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ViewerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Effect">
                <Setter.Value>
                    <effects:DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.28" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ViewerTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ViewerTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ViewerSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
        </Style>

        <Style x:Key="ViewerToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="Background" Value="{StaticResource ViewerAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBorderBrush}" />
        </Style>

        <Style x:Key="ViewerToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource ViewerTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ViewerSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ViewerChipBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template" Value="{StaticResource ViewerChromeButtonTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource ViewerAccentSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource ViewerAccentBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewerProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource ViewerAccentBrush}" />
            <Setter Property="Background" Value="#172433" />
            <Setter Property="BorderBrush" Value="#28405B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="rootGrid" Background="{StaticResource ViewerBackdropBrush}" ClipToBounds="True" SnapsToDevicePixels="True" AllowDrop="True">
        <Grid.ContextMenu>
            <ContextMenu x:Name="mainContextMenu" Opened="OnContextMenuOpened">
                <ContextMenu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                </ContextMenu.Resources>
                <MenuItem x:Name="roiOperationsMenuItem" Header="{localization:UiText MenuRoiOperations}">
                    <MenuItem x:Name="undoMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.Undo}" Header="{localization:UiText MenuUndo}" IsEnabled="{Binding MenuState.Context.UndoEnabled}" />
                    <MenuItem x:Name="redoMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.Redo}" Header="{localization:UiText MenuRedo}" IsEnabled="{Binding MenuState.Context.RedoEnabled}" />
                    <Separator />
                    <MenuItem x:Name="drawRoiMenuItem" Header="{localization:UiText MenuDraw}" IsEnabled="{Binding MenuState.Context.DrawRoiEnabled}" />
                    <MenuItem x:Name="measureMenuItem" Header="{localization:UiText MenuMeasure}" />
                    <Separator />
                    <MenuItem x:Name="deleteRoiMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.DeleteSelected}" Header="{localization:UiText MenuDeleteSelectedRoi}" IsEnabled="{Binding MenuState.Context.DeleteSelectedEnabled}" />
                    <MenuItem x:Name="clearAllMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.ClearAll}" Header="{localization:UiText MenuClearAllRois}" IsEnabled="{Binding MenuState.Context.ClearAllEnabled}" />
                    <Separator />
                    <MenuItem x:Name="editPropertiesMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.EditProperties}" Header="{localization:UiText MenuEditProperties}" IsEnabled="{Binding MenuState.Context.EditPropertiesEnabled}" />
                    <MenuItem x:Name="setLabelMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetLabel}" Header="{localization:UiText MenuSetLabel}" IsEnabled="{Binding MenuState.Context.SetLabelEnabled}" />
                    <MenuItem x:Name="setColorMenuItem" Header="{localization:UiText MenuSetColor}" IsEnabled="{Binding MenuState.Context.SetColorEnabled}">
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorCyanDefault}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorCyan}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorRed}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorRed}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorGreen}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorGreen}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorYellow}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorYellow}" />
                        <MenuItem Click="OnRoiMenuCommandClick" Header="{localization:UiText MenuColorMagenta}" Tag="{x:Static controls:ImageViewerRoiMenuTags.SetColorMagenta}" />
                    </MenuItem>
                    <MenuItem x:Name="calibratePixelsMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.CalibratePixels}" Header="{localization:UiText MenuCalibratePixels}" IsEnabled="{Binding MenuState.Context.CalibratePixelsEnabled}" />
                    <MenuItem x:Name="editCaliperSettingsMenuItem" Click="OnRoiMenuCommandClick" Tag="{x:Static controls:ImageViewerRoiMenuTags.EditCaliperSettings}" Header="{localization:UiText MenuEditCaliperSettings}" IsEnabled="{Binding MenuState.Context.EditCaliperSettingsEnabled}" />
                    <MenuItem x:Name="gradientDetectMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.GradientDetect}" Header="{localization:UiText MenuGradientAlignCaliper}" IsEnabled="{Binding MenuState.Context.GradientDetectEnabled}" />
                    <Separator />
                    <MenuItem x:Name="showRoiListMenuItem" Header="{localization:UiText MenuShowRoiList}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleRoiList}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowRoiListChecked}" />
                    <MenuItem x:Name="zoomToSelectionMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ZoomToSelection}" Header="{localization:UiText MenuZoomToSelectedRoi}" IsEnabled="{Binding MenuState.View.ZoomToSelectionEnabled}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuFileAndProjects}">
                    <MenuItem x:Name="openImageMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}" Header="{localization:UiText MenuOpenImageFile}" />
                    <MenuItem x:Name="saveRoisMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.SaveRois}" Header="{localization:UiText MenuSaveRois}" IsEnabled="{Binding MenuState.File.SaveRoisEnabled}" />
                    <MenuItem x:Name="loadRoisMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.LoadRois}" Header="{localization:UiText MenuLoadRois}" />
                    <Separator />
                    <MenuItem x:Name="saveSessionMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.SaveSession}" Header="{localization:UiText MenuSaveSession}" IsEnabled="{Binding MenuState.File.SaveSessionEnabled}" />
                    <MenuItem x:Name="loadSessionMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.LoadSession}" Header="{localization:UiText MenuOpenProjectOrSession}" />
                    <MenuItem x:Name="recentProjectsMenuItem" Header="{localization:UiText MenuRecentProjects}" ItemsSource="{Binding MenuState.File.RecentProjects}" IsEnabled="{Binding MenuState.File.RecentProjectsEnabled}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="{x:Type MenuItem}">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                <Setter Property="Tag" Value="{Binding Tag}" />
                                <EventSetter Event="Click" Handler="OnFileMenuCommandClick" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem x:Name="exportProjectPackageMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.ExportProjectPackage}" Header="{localization:UiText MenuExportProjectPackage}" IsEnabled="{Binding MenuState.File.ExportProjectPackageEnabled}" />
                    <MenuItem x:Name="autoSaveMenuItem" Click="OnFileMenuCommandClick" Tag="{x:Static controls:ImageViewerFileMenuTags.ToggleAutoSave}" Header="{localization:UiText MenuAutoSave}" IsCheckable="True" IsChecked="{Binding MenuState.File.AutoSaveChecked}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuAnalysisAndExport}">
                    <MenuItem x:Name="exportSnapshotMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportSnapshot}" Header="{localization:UiText MenuExportCurrentViewPng}" IsEnabled="{Binding MenuState.Context.ExportSnapshotEnabled}" />
                    <MenuItem x:Name="exportAnalysisCsvMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ExportAnalysisCsv}" Header="{localization:UiText MenuExportAnalysisCsv}" IsEnabled="{Binding MenuState.Context.ExportAnalysisCsvEnabled}" />
                    <MenuItem x:Name="showAnalysisSummaryMenuItem" Click="OnFeatureMenuCommandClick" Tag="{x:Static controls:ImageViewerFeatureMenuTags.ShowAnalysisSummary}" Header="{localization:UiText MenuShowAnalysisSummary}" IsEnabled="{Binding MenuState.Context.ShowAnalysisSummaryEnabled}" />
                    <Separator />
                    <MenuItem Header="{localization:UiText MenuAnalysisRun}">
                        <MenuItem x:Name="enableAsyncAnalysisMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAsyncAnalysis}" Header="{localization:UiText MenuEnableAsyncAnalysis}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.EnableAsyncAnalysisChecked}" />
                        <MenuItem x:Name="pauseRealtimeHistogramMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePauseRealtimeHistogram}" Header="{localization:UiText MenuPauseRealtimeHistogram}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PauseRealtimeHistogramChecked}" IsEnabled="{Binding MenuState.Analysis.PauseRealtimeHistogramEnabled}" />
                        <MenuItem x:Name="pauseRealtimeProfileMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePauseRealtimeProfile}" Header="{localization:UiText MenuPauseRealtimeProfile}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PauseRealtimeProfileChecked}" IsEnabled="{Binding MenuState.Analysis.PauseRealtimeProfileEnabled}" />
                        <MenuItem x:Name="refreshAnalysisMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.RefreshAnalysis}" Header="{localization:UiText MenuRefreshAnalysis}" IsEnabled="{Binding MenuState.Analysis.EnableRefreshAnalysis}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuLargeImageAndPerformance}">
                    <MenuItem x:Name="enableImagePyramidMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleImagePyramid}" Header="{localization:UiText MenuEnableImagePyramid}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.EnableImagePyramidChecked}" />
                    <MenuItem x:Name="autoSelectPyramidLevelMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAutoSelectPyramidLevel}" Header="{localization:UiText MenuAutoSelectPyramidLevel}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.AutoSelectPyramidLevelChecked}" IsEnabled="{Binding MenuState.Analysis.AutoSelectPyramidLevelEnabled}" />
                    <MenuItem Header="{localization:UiText MenuAdvancedPerformance}">
                        <MenuItem x:Name="enableTiledRenderingMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleTiledRendering}" Header="{localization:UiText MenuEnableTiledRendering}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.EnableTiledRenderingChecked}" />
                        <MenuItem x:Name="prefetchAdjacentTilesMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePrefetchAdjacentTiles}" Header="{localization:UiText MenuPrefetchAdjacentTiles}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PrefetchAdjacentTilesChecked}" IsEnabled="{Binding MenuState.Analysis.PrefetchAdjacentTilesEnabled}" />
                        <MenuItem x:Name="gpuRenderingMenuItem" Header="{localization:UiText MenuEnableGpuViewportCache}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleGpuRendering}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.GpuRenderingChecked}" />
                        <Separator />
                        <MenuItem x:Name="clearPyramidCacheMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ClearPyramidCache}" Header="{localization:UiText MenuClearPyramidCache}" IsEnabled="{Binding MenuState.Analysis.EnableClearPyramidCache}" />
                        <MenuItem x:Name="clearAnalysisCacheMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ClearAnalysisCache}" Header="{localization:UiText MenuClearAnalysisCache}" IsEnabled="{Binding MenuState.Analysis.EnableClearAnalysisCache}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuRenderAndPseudoColor}">
                    <MenuItem Header="{localization:UiText MenuPseudoColorStrategy}">
                        <MenuItem x:Name="preferShaderPseudoColorMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.TogglePreferShaderPseudoColor}" Header="{localization:UiText MenuPreferShaderPseudoColor}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PreferShaderPseudoColorChecked}" />
                        <MenuItem x:Name="allowCpuPseudoColorFallbackMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ToggleAllowCpuPseudoColorFallback}" Header="{localization:UiText MenuAllowCpuFallback}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.AllowCpuPseudoColorFallbackChecked}" />
                    </MenuItem>
                    <MenuItem x:Name="pseudoColorMenuItem" Header="{localization:UiText MenuPseudoColor}">
                        <MenuItem Header="{localization:UiText MenuPseudoColorOriginal}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteNone}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorNoneChecked}" />
                        <MenuItem Header="{localization:UiText MenuPseudoColorHot}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteHot}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorHotChecked}" />
                        <MenuItem Header="{localization:UiText MenuPseudoColorJet}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteJet}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorJetChecked}" />
                        <MenuItem Header="{localization:UiText MenuPseudoColorViridis}" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.SetPseudoColorPaletteViridis}" IsCheckable="True" IsChecked="{Binding MenuState.Analysis.PseudoColorViridisChecked}" />
                    </MenuItem>
                    <MenuItem x:Name="showRenderStatusMenuItem" Click="OnAnalysisCommandMenuClick" Tag="{x:Static controls:ImageViewerAnalysisMenuTags.ShowRenderStatus}" Header="{localization:UiText MenuShowRenderStatus}" IsEnabled="{Binding MenuState.Analysis.EnableShowRenderStatus}" />
                </MenuItem>
                <MenuItem Header="{localization:UiText MenuDisplaySettings}">
                    <MenuItem x:Name="showPixelGridMenuItem" Header="{localization:UiText MenuShowPixelGrid}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.TogglePixelGrid}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowPixelGridChecked}" />
                    <MenuItem x:Name="showSnapGridMenuItem" Header="{localization:UiText MenuShowSnapGrid}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleSnapGrid}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowSnapGridChecked}" />
                    <MenuItem x:Name="enableSnapToGridMenuItem" Header="{localization:UiText MenuEnableSnapToGrid}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleSnapToGrid}" IsCheckable="True" IsChecked="{Binding MenuState.View.EnableSnapToGridChecked}" />
                    <MenuItem x:Name="showCrosshairMenuItem" Header="{localization:UiText MenuShowCrosshair}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleCrosshair}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowCrosshairChecked}" />
                    <MenuItem x:Name="showCaliperScoresMenuItem" Header="{localization:UiText MenuShowCaliperScores}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleCaliperScores}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowCaliperScoresChecked}" />
                    <MenuItem x:Name="showInfoPanelMenuItem" Header="{localization:UiText MenuShowInfoPanel}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleInfoPanel}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowInfoPanelChecked}" />
                    <MenuItem x:Name="showHistogramMenuItem" Header="{localization:UiText MenuShowHistogram}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleHistogram}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowHistogramChecked}" />
                    <MenuItem x:Name="showProfileMenuItem" Header="{localization:UiText MenuShowProfile}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleProfile}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowProfileChecked}" />
                    <MenuItem x:Name="showScaleBarMenuItem" Header="{localization:UiText MenuShowScaleBar}" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ToggleScaleBar}" IsCheckable="True" IsChecked="{Binding MenuState.View.ShowScaleBarChecked}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{localization:UiText MenuViewControl}">
                    <MenuItem x:Name="fitToViewMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.FitToView}" Header="{localization:UiText MenuFitToView}" IsEnabled="{Binding MenuState.View.FitToViewEnabled}" />
                    <MenuItem x:Name="actualSizeMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ActualSize}" Header="{localization:UiText MenuActualSize}" IsEnabled="{Binding MenuState.View.ActualSizeEnabled}" />
                    <MenuItem x:Name="resetViewMenuItem" Click="OnViewCommandMenuClick" Tag="{x:Static controls:ImageViewerViewMenuTags.ResetView}" Header="{localization:UiText MenuResetView}" IsEnabled="{Binding MenuState.View.ResetViewEnabled}" />
                </MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Canvas x:Name="canvas" SnapsToDevicePixels="True">
            <!-- 图像容器，负责缩放和平移 -->
            <Canvas x:Name="imageContainer" SnapsToDevicePixels="True">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="scaleTransform" />
                        <TranslateTransform x:Name="translateTransform" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!-- 图像显示 -->
                <Image x:Name="image" RenderOptions.BitmapScalingMode="NearestNeighbor" />

                <Canvas x:Name="snapGridCanvas" IsHitTestVisible="False" Opacity="0.6" />

                <!-- ROI 覆盖层 -->
                <Canvas x:Name="overlayCanvas" SnapsToDevicePixels="True">
                    <Canvas x:Name="committedOverlayCanvas" SnapsToDevicePixels="True" />
                    <Canvas x:Name="selectionOverlayCanvas" SnapsToDevicePixels="True" />
                    <Canvas x:Name="activeOverlayCanvas" SnapsToDevicePixels="True" />
                </Canvas>
                
                <!-- 像素网格层 -->
                <Canvas x:Name="pixelGridCanvas" IsHitTestVisible="False" Opacity="0.5" />
            </Canvas>
        </Canvas>

        <Canvas x:Name="screenOverlayCanvas" IsHitTestVisible="False" SnapsToDevicePixels="True" />

        <!-- 十字准星（不随图像缩放） -->
        <Canvas IsHitTestVisible="False">
            <Line x:Name="crosshairH" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="1.25" Visibility="Collapsed" />
            <Line x:Name="crosshairV" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="1.25" Visibility="Collapsed" />
        </Canvas>

        <!-- 坐标显示 -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10"
                Padding="10,6"
                Background="#C0141D29"
                BorderBrush="#334A63"
                BorderThickness="1"
                CornerRadius="12"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=coordTextBlock}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="coordTextBlock"
                       Foreground="{StaticResource ViewerTextPrimaryBrush}"
                       FontWeight="SemiBold" />
        </Border>

        <!-- 比例尺 -->
        <Canvas x:Name="scaleBarCanvas" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="10,0,0,35" 
                Width="150" 
                Height="30" 
                IsHitTestVisible="False" 
                Visibility="Collapsed">
            <Polyline x:Name="scaleBarLine" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="2" Points="0,0 0,10 100,10 100,0" />
            <TextBlock x:Name="scaleBarText" Text="{localization:UiText ScaleBarDefault}" Foreground="{StaticResource ViewerTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Canvas.Left="30" Canvas.Top="-5"/>
        </Canvas>

        <!-- 信息面板 -->
        <Border x:Name="infoPanel" 
                Margin="10" 
                Padding="5" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Style="{StaticResource ViewerFloatingPanelStyle}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <TextBlock x:Name="infoTextBlock" Foreground="{StaticResource ViewerTextPrimaryBrush}" />
        </Border>

        <Border x:Name="roiListPanel"
                Margin="10"
                Padding="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="240"
                MaxHeight="320"
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{localization:UiText RoiListTitle}" Foreground="{StaticResource ViewerTextPrimaryBrush}" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox Grid.Row="1"
                         x:Name="roiListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource ViewerTextPrimaryBrush}"
                         ItemsSource="{Binding ViewerState.AllRois, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         SelectedItem="{Binding ViewerState.SelectedRoi, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                                <CheckBox Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                          IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                          ToolTip="{localization:UiText RoiListToggleVisibleTooltip}"
                                          Content="{localization:UiText RoiListToggleVisible}" />
                                <CheckBox Grid.Column="2"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource ViewerTextPrimaryBrush}"
                                          IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                          ToolTip="{localization:UiText RoiListToggleLockedTooltip}"
                                          Content="{localization:UiText RoiListToggleLocked}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border x:Name="roiPropertyPanel"
                Margin="10,56,10,10"
                Padding="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="320"
                MaxHeight="420"
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="{localization:UiText PropertyPanelTitle}" Foreground="{StaticResource ViewerTextPrimaryBrush}" FontWeight="Bold" Margin="0,0,0,6" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="roiPropertyEditorHost" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 直方图面板 -->
        <Border x:Name="histogramPanel" 
                Margin="10,0,10,40" 
                Padding="5" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Bottom" 
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Width="266" 
                Height="160"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{localization:UiText HistogramPanelTitle}" Foreground="{StaticResource ViewerTextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" FontWeight="SemiBold" Opacity="0.95"/>
                <Canvas x:Name="histogramCanvas" Margin="0,15,0,0" Width="256" Height="140" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- 灰度剖面图面板 -->
        <Border x:Name="profilePanel" 
                Margin="10,0,10,40" 
                Padding="5" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Style="{StaticResource ViewerFloatingPanelStyle}"
                Width="266" 
                Height="160"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Grid>
                <TextBlock Text="{localization:UiText ProfilePanelTitle}" Foreground="{StaticResource ViewerTextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="10" FontWeight="SemiBold" Opacity="0.95"/>
                <Canvas x:Name="profileCanvas" Margin="0,15,0,0" Width="256" Height="140" ClipToBounds="True"/>
            </Grid>
        </Border>

        <Border x:Name="emptyStatePanel"
                Width="420"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
            Panel.ZIndex="90">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ViewerFloatingPanelStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ImageSource, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}" />
                                <Condition Binding="{Binding IsImageLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Width="360">
                <Border Width="72"
                        Height="72"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Background="{StaticResource ViewerAccentSoftBrush}"
                        BorderBrush="{StaticResource ViewerAccentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <Viewbox Margin="16">
                        <Canvas Width="40" Height="40">
                            <Path Data="M4,8 H36 V32 H4 Z" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="2" Fill="Transparent" StrokeLineJoin="Round" />
                            <Path Data="M8,26 L16,18 L24,26 L29,21 L34,28" Stroke="{StaticResource ViewerAccentBrush}" StrokeThickness="2" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Ellipse Canvas.Left="28" Canvas.Top="12" Width="4" Height="4" Fill="{StaticResource ViewerAccentBrush}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock Text="{localization:UiText EmptyStateTitle}"
                           Foreground="{StaticResource ViewerTextPrimaryBrush}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextAlignment="Center" />

                <TextBlock Text="{localization:UiText EmptyStateDescription}"
                           Foreground="{StaticResource ViewerTextSecondaryBrush}"
                           FontSize="13"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,8,0,0" />

                <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Margin="0,0,8,8" Padding="10,4" Background="#1C2736" BorderBrush="#36516E" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="拖放加载" Foreground="{StaticResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="10,4" Background="#1C2736" BorderBrush="#36516E" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="后台重试" Foreground="{StaticResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Margin="0,0,8,8" Padding="10,4" Background="#1C2736" BorderBrush="#36516E" BorderThickness="1" CornerRadius="999">
                        <TextBlock Text="大图分块" Foreground="{StaticResource ViewerTextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </WrapPanel>

                <Button Margin="0,18,0,0"
                        HorizontalAlignment="Center"
                        Click="OnToolbarFileCommandClick"
                        Content="{localization:UiText MenuOpenImageFile}"
                        Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}"
                        Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />

                <TextBlock Text="{localization:UiText EmptyStateHint}"
                           Foreground="{StaticResource ViewerTextSecondaryBrush}"
                           FontSize="11"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </StackPanel>
        </Border>

        <!-- 2026-09-18: 工具面板切换按钮——面板默认隐藏（ShowToolbarPanel=false），点击 ⚙ 开合 -->
        <ToggleButton x:Name="toolbarToggleChip"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Margin="16"
                      Panel.ZIndex="101"
                      Width="30"
                      Height="30"
                      Content="⚙"
                      FontSize="14"
                      IsChecked="{Binding ShowToolbarPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                      ToolTip="{localization:UiText MenuToolbarToggle}"
                      Style="{StaticResource ViewerToolbarToggleButtonStyle}" />

        <Border x:Name="toolbarPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="56,16,16,16"
                Panel.ZIndex="100"
                Visibility="{Binding ShowToolbarPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource ViewerFloatingPanelStyle}">
            <StackPanel Width="Auto">
                <TextBlock Text="{localization:UiText MenuFileAndProjects}" Style="{StaticResource ViewerSectionTitleStyle}" />
                <WrapPanel>
                    <Button Content="{localization:UiText MenuOpenImageFile}"
                            Click="OnToolbarFileCommandClick"
                            Tag="{x:Static controls:ImageViewerFileMenuTags.OpenImage}"
                            Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />
                </WrapPanel>

                <TextBlock Text="{localization:UiText MenuViewControl}" Style="{StaticResource ViewerSectionTitleStyle}" Margin="0,4,0,8" />
                <WrapPanel>
                    <Button Content="{localization:UiText MenuFitToView}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.FitToView}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuActualSize}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.ActualSize}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                    <Button Content="{localization:UiText MenuResetView}"
                            Click="OnToolbarViewCommandClick"
                            Tag="{x:Static controls:ImageViewerViewMenuTags.ResetView}"
                            Style="{StaticResource ViewerToolbarButtonStyle}" />
                </WrapPanel>

                <TextBlock Text="{localization:UiText MenuDisplaySettings}" Style="{StaticResource ViewerSectionTitleStyle}" Margin="0,4,0,8" />
                <WrapPanel>
                    <ToggleButton Content="{localization:UiText MenuShowInfoPanel}"
                                  IsChecked="{Binding ShowInfoPanel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowHistogram}"
                                  IsChecked="{Binding ShowHistogram, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowProfile}"
                                  IsChecked="{Binding ShowProfile, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowScaleBar}"
                                  IsChecked="{Binding ShowScaleBar, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                    <ToggleButton Content="{localization:UiText MenuShowRoiList}"
                                  IsChecked="{Binding ShowRoiList, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                  Checked="OnToolbarPanelToggleChanged"
                                  Unchecked="OnToolbarPanelToggleChanged"
                                  Style="{StaticResource ViewerToolbarToggleButtonStyle}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="imageLoadPanel"
                Margin="16"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource ViewerSurfaceBrush}"
                BorderBrush="{StaticResource ViewerPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Panel.ZIndex="110"
                Width="420"
                Visibility="{Binding IsImageLoading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                Style="{StaticResource ViewerFloatingPanelStyle}">
            <Grid Width="384">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Ellipse Stroke="#294055" StrokeThickness="4" />
                    <Ellipse Stroke="{StaticResource ViewerAccentBrush}"
                             StrokeDashArray="1.2 2.5"
                             StrokeDashCap="Round"
                             StrokeThickness="4">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="loadingSpinnerRotate" CenterX="24" CenterY="24" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="loadingSpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding ImageLoadStatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource ViewerTextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextWrapping="Wrap" />
                    <ProgressBar Style="{StaticResource ViewerProgressBarStyle}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ImageLoadProgress, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Button Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Padding="14,6"
                            Click="OnRetryImageLoadClick"
                            Content="{localization:UiText ImageLoadRetry}"
                            Visibility="{Binding CanRetryImageLoad, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ViewerToolbarPrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
