<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="README.md">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" ExcludeAssets="runtime;native" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.28.0" />
		<PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" Version="1.24.1" />
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260214" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260214" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="YoloDotNet" Version="4.2.0" />
		<PackageReference Include="YoloDotNet.ExecutionProvider.Cpu" Version="1.1.0" />
		<PackageReference Include="YoloDotNet.ExecutionProvider.OpenVino" Version="1.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MainAPP\MainAPP.csproj" />
		<ProjectReference Include="..\JinlongYolo\JinlongYolo.csproj" />
		<ProjectReference Include="..\HikCameraLib\HikScanner\HikScanner.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="best.onnx">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
