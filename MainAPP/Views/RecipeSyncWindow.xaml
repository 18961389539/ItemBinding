<Window
    x:Class="MainAPP.Views.RecipeSyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Title="批量参数同步"
    Width="500"
    Height="560"
    MinWidth="460"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource DarkGroupBoxStyle}" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TechTextSecondaryBrush}" />
        </Style>
    </Window.Resources>
    <Grid Margin="16" Background="{StaticResource TechPageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="12.5"
            Foreground="{StaticResource NeonCyanBrush}"
            Text="把当前配方的参数组批量同步到其他配方（目标配方会被覆盖并立即保存）。"
            TextWrapping="Wrap" />

        <!--  同步内容  -->
        <GroupBox Grid.Row="1" Margin="0,12,0,12" Header="同步内容">
            <StackPanel Margin="4">
                <CheckBox
                    x:Name="SyncImageTool"
                    Margin="0,0,0,8"
                    Content="图像采集参数（曝光时间 / 增益 / 取图来源 / 目录 / 跳过帧）"
                    IsChecked="True" />
                <CheckBox
                    x:Name="SyncEdgeTool"
                    Margin="0,0,0,8"
                    Content="边缘检测模型（路径 / 缩放 / 阈值 / 掩码面积过滤）"
                    IsChecked="False" />
                <CheckBox
                    x:Name="SyncAngleTool"
                    Margin="0,0,0,8"
                    Content="角度检测模型（含启用开关 / 灰度判向开关）"
                    IsChecked="False" />
                <CheckBox
                    x:Name="SyncCalib"
                    Content="标定补偿与抓取点（角度偏移 / 长轴偏移 / 短轴偏移）"
                    IsChecked="False" />
            </StackPanel>
        </GroupBox>

        <!--  目标配方  -->
        <GroupBox Grid.Row="2" Header="目标配方（Ctrl+点击多选，再次点击取消）">
            <ListBox
                x:Name="TargetList"
                Margin="4"
                Background="{StaticResource TechInnerBgBrush}"
                BorderBrush="{StaticResource TechCardBorderBrush}"
                SelectionMode="Multiple"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="13"
                                Height="13"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="Flask" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!--  操作按钮  -->
        <StackPanel
            Grid.Row="3"
            Margin="0,14,0,0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <Button
                MinWidth="72"
                Margin="0,0,8,0"
                Padding="{StaticResource PaddingButtonCompact}"
                Click="SyncButton_Click"
                IsDefault="True"
                Style="{StaticResource ButtonPrimary}">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconPhosphorIcons
                        Width="14"
                        Height="14"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Kind="ArrowsClockwise" />
                    <TextBlock Text="同步" />
                </StackPanel>
            </Button>
            <Button
                MinWidth="72"
                Padding="{StaticResource PaddingButtonCompact}"
                Click="CancelButton_Click"
                IsCancel="True">
                <StackPanel Orientation="Horizontal">
                    <icons:PackIconPhosphorIcons
                        Width="14"
                        Height="14"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Kind="X" />
                    <TextBlock Text="取消" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>