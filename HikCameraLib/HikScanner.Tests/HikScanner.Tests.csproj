      <HintPath>..\HikScanner\DLLs\MvCodeReaderSDK.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="HikScanner" />
  </ItemGroup>

</Project>