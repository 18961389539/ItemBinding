<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>机械手.ico</ApplicationIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>NU1701;NETSDK1206</NoWarn>
	</PropertyGroup>

	<!-- 2026-09-11: 允许测试程序集访问 internal 成员，用于直接单测灰度判向等纯算法逻辑
	     （ApplyBrightnessHeadDirectionIfEnabled / BrightnessDirectionStats 均为 internal）。 -->
	<ItemGroup>
		<InternalsVisibleTo Include="MainAPP.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="DataGridExtensions" Version="2.9.1" />
		<PackageReference Include="HandyControl" Version="3.4.0" />
		<PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.24" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.24" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.24">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Windows" Version="1.28.0" />
		<PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
		<!-- Roslyn 分析器：强制 async void 使用规范、检测 sync-over-async 等 -->
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.13.61">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
		<PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.11.0.20250507" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Serilog.Sinks.SQLite" Version="6.0.0" />
		<!-- 2026-09-13: 覆盖传递依赖 System.Collections.Immutable 6.0.0（其旧版 targets 在新 SDK 上
		     对 net8.0-windows 误报 "doesn't support"，阻断构建）。8.0.0 与 .NET 8 运行时内置版本同源，
		     API 向后兼容，只升 targets 兼容性，不影响任何行为。 -->
		<PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
		<!-- 同 2026-09-13：System.Composition.Runtime 6.0.0 旧版 targets 误报（该程序集 .NET 6+ 运行时内置），
		     9.0.0 消除误报。System.Composition.* 为 SQLite/分析器链的传递依赖，API 兼容。 -->
		<PackageReference Include="System.Composition.Runtime" Version="9.0.0" />
		<!-- 同族覆盖：System.Composition.Hosting / AttributedModel / TypedParts / Convention
		     6.0.0 旧 targets 对 net8.0-windows 报错（9.0.0 仅警告），一次覆盖收敛。 -->
		<PackageReference Include="System.Composition.Hosting" Version="9.0.0" />
		<PackageReference Include="System.Composition.AttributedModel" Version="9.0.0" />
		<PackageReference Include="System.Composition.TypedParts" Version="9.0.0" />
		<PackageReference Include="System.Composition.Convention" Version="9.0.0" />
		<!-- System.Composition 聚合元包 6.0.0 同因报错，一并覆盖到 9.0.0。 -->
		<PackageReference Include="System.Composition" Version="9.0.0" />
	</ItemGroup>

	<!-- 2026-09-12: AI 对话模块（离线本地推理，全部开源组件，不自建轮子）。
	     Microsoft.Extensions.AI → 模型访问抽象（IChatClient / AIFunction / 工具调用中间件），
	       已由 LLamaSharp 传递引入，无需单独引用。
	     LLamaSharp → 本地 GGUF 推理（llama.cpp 的 .NET 绑定），本机已实测 Qwen3.5-4B 可用。
	     ★ 核心包与 backend 必须同版本，且<b>只能装一个 backend</b>：同时装 CPU 与 CUDA 会静默跑 CPU。
	       这里选 Vulkan——只需显卡驱动；Cuda12 在缺 CUDA 运行时的机器上会静默回落 CPU（已实测）。
	     下一步若需多智能体编排 / MCP 服务端，再引入 Microsoft.Agents.AI（MAF，SK 的继任者）。 -->
	<ItemGroup>
		<!-- 工具调用中间件（ChatClientBuilder.UseFunctionInvocation / FunctionInvokingChatClient）
		     在 Microsoft.Extensions.AI 主包里，LLamaSharp 只传递引入 Abstractions。
		     10.9.0 的 lib 含 net8.0，可安全用于本工程。 -->
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
		<!-- OpenAI 协议适配器：把 llama-server 侧车（OpenAI 兼容 HTTP）包装成 IChatClient，
		     MAF / 流式 / 工具调用代码零改动即可从进程内推理切到侧车。 -->
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
		<!-- 浏览器级对话 UI 的承载控件（A 部分）：WPF 内嵌 WebView2 跑 Deep Chat 页面。
		     ★ 部署注意：目标机需有 WebView2 Runtime（Win11 自带；老旧 Win10 需装
		        Evergreen Runtime 或随包带 Fixed Version，约 200MB）。 -->
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
		<!-- Agent 与工具调用编排（Semantic Kernel 的继任者，2026-04 GA）。
		     1.21.0 的 lib 含 net8.0/net9.0/net10.0/net472，可安全用于本工程（已实测还原）。
		     提供 AIAgent / AgentSession（多轮会话状态）/ 工具循环。 -->
		<PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Deep Chat（MIT）官方单文件打包产物，随程序集内嵌，产线离线可用（378 KB）。
		     来源：https://unpkg.com/deep-chat@2.5.1/dist/deepChat.bundle.js
		     由 AiWebHost 以 /deepchat.js 路由对外提供，前端零 CDN 依赖。 -->
		<EmbeddedResource Include="Services\AI\Resources\deepChat.bundle.js" />
	</ItemGroup>

	<ItemGroup>
		<!-- 2026-09-13: Web 页面抽为独立嵌入资源（替代 C# raw string，可独立编辑/校验） -->
		<EmbeddedResource Include="Web\AiIndex.html" />
		<EmbeddedResource Include="Web\CameraIndex.html" />
		<EmbeddedResource Include="Web\OpsIndex.html" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CoordinateSystemMapping\CoordinateSystemMapping.csproj" />
		<ProjectReference Include="..\Extensions\Extensions.csproj" />
		<ProjectReference Include="..\HikCameraLib\HikScanner\HikScanner.csproj" />
		<ProjectReference Include="..\JinlongYolo\JinlongYolo.csproj" />
		<ProjectReference Include="..\LicenseSystem\src\LicenseCore\LicenseCore.csproj" />
		<ProjectReference Include="..\ScottPlot.WPF\ScottPlot.WPF.csproj" />
		<ProjectReference Include="..\ImageViewerControl\ImageViewerControl.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="机械手.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- REVIEW(2026-09-04): 发布修复——CUDA 运行时必须随发布携带，否则无 CUDA Toolkit 的部署机 GPU 推理缺依赖。
	     cuda_runtime_dlls/ 的完整清单见 CudaRuntimeLoader.cs（s_cudaDlls + s_optionalCudaDllPatterns + s_cudnnCompanionFiles）。
	     重建方式：运行 tools\extract_cuda_minimal.ps1（从 NVIDIA 官方 PyPI 轮子提取，无需 CUDA Toolkit）。
	     历史坑：早期该目录由手工拷贝生成，漏了 nvrtc/curand/nvJitLink，导致部分机器在卷积节点抛
	             CUDNN_FE failure 7: GRAPH_EXECUTION_FAILED（cuDNN 回退到「运行时编译引擎」时需要 NVRTC）。
	     注意：cuDNN 按「文件名」LoadLibrary 加载 nvrtc，而本目录是应用目录下的子目录、不在 Windows DLL
	           搜索顺序内，因此这些文件必须在 CudaRuntimeLoader 中显式预载，只放进目录是无效的。
	     模型(best.onnx)属运行时资产：由下方 CopyYoloModel / CopyYoloModelToPublish Target 自动拷贝到
	     输出与发布目录的 Models\（HomeViewModel 从 BaseDirectory\Models\best.onnx 加载）。
	     勿用 Content 声明：MainAPP\Models 是 C# 源码目录，与仓库根的 Models\（模型仓库）不是同一个。 -->
	<ItemGroup>
		<Content Include="cuda_runtime_dlls\**" Condition="Exists('cuda_runtime_dlls')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- REVIEW(2026-09-04): 模型自动拷贝。
	     历史坑：best.onnx 此前靠发布后手工拷贝，8-13 的发布包就漏了它；
	             且该模型（md5 00b0d409）与仓库 Models\ 下其他 onnx 大小相同但内容不同，
	             曾只存在于即将被清理的旧 publish 目录里，险些丢失——现已归位到仓库根 Models\best.onnx。
	     源路径默认 $(MSBuildThisFileDirectory)..\Models\best.onnx，可用 -p:YoloModelSourcePath=... 覆盖；
	     发布时若源文件缺失会直接报错终止（缺模型的发布包不能上产线），确需跳过传 -p:SkipYoloModelCopy=true。 -->
	<PropertyGroup>
		<YoloModelSourcePath Condition="'$(YoloModelSourcePath)' == ''">$(MSBuildThisFileDirectory)..\Models\best.onnx</YoloModelSourcePath>
		<SkipYoloModelCopy Condition="'$(SkipYoloModelCopy)' == ''">false</SkipYoloModelCopy>
	</PropertyGroup>

	<!-- 开发运行用：拷到常规输出目录（bin\Debug|Release\net8.0-windows\Models\） -->
	<Target Name="CopyYoloModel" AfterTargets="Build" Condition="'$(SkipYoloModelCopy)' != 'true'">
		<Copy SourceFiles="$(YoloModelSourcePath)" DestinationFolder="$(OutputPath)Models\"
		      SkipUnchangedFiles="true" Condition="Exists('$(YoloModelSourcePath)')" />
		<Warning Text="[模型] 未找到 $(YoloModelSourcePath)，输出目录将缺少 Models\best.onnx"
		         Condition="!Exists('$(YoloModelSourcePath)')" />
	</Target>

	<!-- 部署用：拷到发布目录。注意 publish 的文件清单不来自 OutputPath 镜像，
	     所以这里必须独立于 CopyYoloModel 再拷一次。 -->
	<Target Name="CopyYoloModelToPublish" AfterTargets="Publish" Condition="'$(SkipYoloModelCopy)' != 'true'">
		<Copy SourceFiles="$(YoloModelSourcePath)" DestinationFolder="$(PublishDir)Models\"
		      SkipUnchangedFiles="true" Condition="Exists('$(YoloModelSourcePath)')" />
		<Error Text="[模型] 未找到 $(YoloModelSourcePath)，发布目录将缺少 Models\best.onnx，不能用于产线部署。确需跳过请传 -p:SkipYoloModelCopy=true"
		       Condition="!Exists('$(YoloModelSourcePath)')" />
	</Target>

	<!-- REVIEW(2026-08-06): 发布修复——OnnxRuntime.Gpu 的原生 DLL（onnxruntime.dll / providers_cuda 等）
	     位于 runtimes\win-x64\native，dotnet publish 默认漏拷，显式补拷到发布目录。 -->
	<Target Name="CopyOnnxNativeDlls" AfterTargets="Publish">
		<ItemGroup>
			<_OnnxNative Include="$(TargetDir)runtimes\win-x64\native\onnxruntime*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(_OnnxNative)" DestinationFolder="$(PublishDir)" Condition="Exists('$(TargetDir)runtimes\win-x64\native')" />
	</Target>

	<!-- CUDA DLL：运行时按需加载策略
	     构建时不自动复制，运行时由 CudaRuntimeLoader 从 CUDA Toolkit 或本地目录动态加载。
	     如需部署到无 CUDA Toolkit 的机器，运行 extract_cuda_minimal.bat 提取到 cuda_runtime_dlls/ 目录。 -->
	<Target Name="WarnCudaMissing" AfterTargets="Build" Condition="!Exists('$(CUDA_PATH)\bin\cudart64_13.dll') And !Exists('$(MSBuildProjectDirectory)\cuda_runtime_dlls\cudart64_13.dll')">
		<Message Text="[CUDA] 未找到 CUDA DLL。运行时将自动回退到 OpenVINO/CPU。如需 CUDA 加速，请安装 CUDA Toolkit 13.x 或运行 extract_cuda_minimal.bat" Importance="high" />
	</Target>



</Project>