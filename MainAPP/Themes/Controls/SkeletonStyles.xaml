<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        Skeleton 骨架屏样式系统（加载态占位）
        ============================================================
        组成：
        1. ShimmerStoryboard     — 横向流光动画（横向平移重复）
        2. SkeletonBase          — 骨架基础矩形（ColorBg700 底色）
        3. ShimmerOverlay        — 流光修饰层（ColorBg600，叠加在基础之上）
        4. SkeletonCard          — 骨架卡片容器（复用 Surface 画刷）
        5. SkeletonDataGridRow   — 骨架 DataGrid 行（头像 + 3 行文字）

        用法：在加载态用 Grid 叠加 SkeletonBase + ShimmerOverlay 形成单个骨架块，
              或直接使用 SkeletonCard / SkeletonDataGridRow 组合件。
        ============================================================
    -->

    <!--  ===== 1. Shimmer 横向流光动画 =====  -->
    <Storyboard x:Key="ShimmerStoryboard">
        <DoubleAnimation
            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
            From="-100"
            To="200"
            Duration="0:0:1.5"
            RepeatBehavior="Forever"
            EasingFunction="{StaticResource EaseInOut}" />
    </Storyboard>

    <!--  ===== 2. Skeleton 基础样式（底色矩形，用 ColorBg700） =====  -->
    <Style x:Key="SkeletonBase" TargetType="Rectangle">
        <Setter Property="Fill">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource ColorBg700}" />
            </Setter.Value>
        </Setter>
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== 3. Shimmer 修饰层（叠加在 Skeleton 上的流光，略亮于基础，用 ColorBg600） =====  -->
    <Style x:Key="ShimmerOverlay" TargetType="Rectangle">
        <Setter Property="Fill">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource ColorBg600}" />
            </Setter.Value>
        </Setter>
        <Setter Property="RadiusX" Value="4" />
        <Setter Property="RadiusY" Value="4" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource ShimmerStoryboard}" />
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!--  ===== 4. 骨架卡片容器样式 =====  -->
    <Style x:Key="SkeletonCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!--  ===== 5. 骨架 DataGrid 行样式（头像 + 3 行文字，整体水平排列） =====  -->
    <!--  采用 ContentControl + ControlTemplate，便于直接放置在任意加载态容器中  -->
    <Style x:Key="SkeletonDataGridRow" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource SurfaceCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!--  头像占位（24x24 圆形）  -->
                            <Grid Width="24" Height="24" Margin="0,0,12,0">
                                <Rectangle Style="{StaticResource SkeletonBase}" RadiusX="12" RadiusY="12" />
                                <Rectangle Style="{StaticResource ShimmerOverlay}" RadiusX="12" RadiusY="12" />
                            </Grid>
                            <!--  文字行占位（3 行，宽度递减模拟标题/描述/元信息）  -->
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <Grid Width="200" Height="10" Margin="0,0,0,6" HorizontalAlignment="Left">
                                    <Rectangle Style="{StaticResource SkeletonBase}" />
                                    <Rectangle Style="{StaticResource ShimmerOverlay}" />
                                </Grid>
                                <Grid Width="160" Height="10" Margin="0,0,0,6" HorizontalAlignment="Left">
                                    <Rectangle Style="{StaticResource SkeletonBase}" />
                                    <Rectangle Style="{StaticResource ShimmerOverlay}" />
                                </Grid>
                                <Grid Width="120" Height="10" HorizontalAlignment="Left">
                                    <Rectangle Style="{StaticResource SkeletonBase}" />
                                    <Rectangle Style="{StaticResource ShimmerOverlay}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
