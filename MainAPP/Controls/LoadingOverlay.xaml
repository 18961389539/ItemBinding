<UserControl
    x:Class="MainAPP.Controls.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    x:Name="Root">
    <Border Background="{StaticResource LoadingOverlayBrush}">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <icons:PackIconPhosphorIcons
                Width="48"
                Height="48"
                Margin="0,0,0,12"
                HorizontalAlignment="Center"
                Foreground="{StaticResource NeonCyanBrush}"
                Kind="CircleNotch"
                RenderTransformOrigin="0.5,0.5">
                <icons:PackIconPhosphorIcons.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                </icons:PackIconPhosphorIcons.RenderTransform>
                <icons:PackIconPhosphorIcons.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    RepeatBehavior="Forever"
                                    Storyboard.TargetName="SpinnerRotate"
                                    Storyboard.TargetProperty="Angle"
                                    From="0"
                                    To="360"
                                    Duration="0:0:1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </icons:PackIconPhosphorIcons.Triggers>
            </icons:PackIconPhosphorIcons>
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="{StaticResource FontSizeStat}"
                Foreground="{StaticResource TechTextSecondaryBrush}"
                Text="{Binding Message, ElementName=Root, TargetNullValue=正在处理...}" />
        </StackPanel>
    </Border>
</UserControl>
