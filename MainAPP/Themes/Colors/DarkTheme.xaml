<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        浅色科技风 Color Token 体系（三层架构）
        ============================================================
        Layer 1 — Base：原始色值，作为整个设计系统的根变量
        Layer 2 — Semantic：基于 Base 派生的语义色（主文字/次文字/主强调/状态等）
        Layer 3 — Surface：UI 层级表达（页面/卡片/内嵌/状态栏）
        ============================================================
        2026-08-05：由深色主题改为浅色主题（键名保持不变，全局引用自动跟随）。
        亮色对比度校准：主文本 #263238 在 #FFFFFF 上 ≈ 12.6:1；标签文本 #708999 在
        #FFFFFF 上 ≈ 4.0:1；主强调 #00838F 在 #FFFFFF 上 ≈ 4.6:1（均满足 WCAG AA）。
    -->

    <!--  ===== Layer 1: Base 原始色值（浅色系） =====  -->

    <!--  背景基础色（浅色阶）  -->
    <Color x:Key="ColorBg900">#F4F6F9</Color>
    <Color x:Key="ColorBg800">#EDF1F5</Color>
    <Color x:Key="ColorBg700">#FFFFFF</Color>
    <Color x:Key="ColorBg600">#D7DEE6</Color>
    <Color x:Key="ColorBg500">#E9EDF2</Color>
    <Color x:Key="ColorBg400">#E3E9EF</Color>
    <Color x:Key="ColorBg300">#DEE5EB</Color>
    <Color x:Key="ColorBg200">#C9D2DA</Color>

    <!--  Cyan 品牌主色阶（亮背景加深以保证对比度）  -->
    <Color x:Key="ColorCyan300">#00ACC1</Color>
    <Color x:Key="ColorCyan400">#00838F</Color>
    <Color x:Key="ColorCyan700">#006064</Color>

    <!--  霓虹强调色（亮背景加深）  -->
    <Color x:Key="ColorTeal400">#00897B</Color>
    <Color x:Key="ColorBlue400">#0277BD</Color>
    <Color x:Key="ColorOrange400">#EF6C00</Color>
    <Color x:Key="ColorGreen400">#2E7D32</Color>

    <!--  状态色基础（亮背景加深；Warning 取深橙 #C2410C，保证白底文字 ≥4.5:1）  -->
    <Color x:Key="ColorSuccess500">#2E7D32</Color>
    <Color x:Key="ColorWarning500">#C2410C</Color>
    <Color x:Key="ColorError500">#C62828</Color>
    <Color x:Key="ColorError400">#E53935</Color>
    <Color x:Key="ColorInfo500">#1565C0</Color>

    <!--  文本色基础（按层级递减；REVIEW-FIX(对比度): 整体加深一档，
         三文本 #546E7A 白底 5.4:1、标签 #5C6B7A 白底 5.5:1、弱 #607D8B 白底 4.4:1）  -->
    <Color x:Key="ColorText100">#263238</Color>
    <Color x:Key="ColorText200">#37474F</Color>
    <Color x:Key="ColorText300">#546E7A</Color>
    <Color x:Key="ColorText400">#5C6B7A</Color>
    <Color x:Key="ColorText500">#607D8B</Color>

    <!--  数据可视化基础色（亮背景加深）  -->
    <Color x:Key="ColorDataBlue">#1565C0</Color>
    <Color x:Key="ColorDataYellow">#F9A825</Color>
    <Color x:Key="ColorDataOrange">#E65100</Color>
    <Color x:Key="ColorDataLink">#0D47A1</Color>


    <!--  ===== Layer 2: Semantic 语义色（派生引用 Base） =====  -->

    <!--  主强调色（Primary Accent）  -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource ColorCyan400}" />
    <SolidColorBrush x:Key="AccentPrimaryLightBrush" Color="{StaticResource ColorCyan300}" />
    <SolidColorBrush x:Key="AccentPrimaryDeepBrush" Color="{StaticResource ColorCyan700}" />

    <!--  次强调色  -->
    <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource ColorTeal400}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource ColorBlue400}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource ColorOrange400}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource ColorGreen400}" />

    <!--  数据可视化色  -->
    <SolidColorBrush x:Key="DataBlueBrush" Color="{StaticResource ColorDataBlue}" />
    <SolidColorBrush x:Key="DataYellowBrush" Color="{StaticResource ColorDataYellow}" />
    <SolidColorBrush x:Key="DataOrangeBrush" Color="{StaticResource ColorDataOrange}" />
    <SolidColorBrush x:Key="DataLinkBrush" Color="{StaticResource ColorDataLink}" />

    <!--  文本层级（5 级，深色文字，对比度按 WCAG AA 校准）  -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorText100}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorText200}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorText300}" />
    <SolidColorBrush x:Key="TextQuaternaryBrush" Color="{StaticResource ColorText400}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#B0BEC5" />

    <!--  状态色  -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource ColorSuccess500}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource ColorWarning500}" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource ColorError500}" />
    <SolidColorBrush x:Key="StatusErrorSoftBrush" Color="{StaticResource ColorError400}" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource ColorInfo500}" />

    <!--  状态背景色（淡色，用于徽章背景等）  -->
    <SolidColorBrush x:Key="StatusSuccessBackgroundBrush" Color="#E4F3E9" />
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#FFF3E0" />
    <SolidColorBrush x:Key="StatusErrorBackgroundBrush" Color="#FFEBEE" />
    <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#E3F2FD" />


    <!--  ===== Layer 3: Surface UI 层级（浅色） =====  -->

    <!--  页面背景层（z-depth 0）  -->
    <SolidColorBrush x:Key="SurfacePageBrush" Color="{StaticResource ColorBg900}" />
    <SolidColorBrush x:Key="SurfacePageMidBrush" Color="{StaticResource ColorBg800}" />

    <!--  卡片背景层（z-depth 1）  -->
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource ColorBg700}" />
    <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="{StaticResource ColorBg600}" />

    <!--  内嵌层（z-depth 2，卡片内的卡片）  -->
    <SolidColorBrush x:Key="SurfaceInnerBrush" Color="{StaticResource ColorBg500}" />

    <!--  状态栏层（顶部/底部状态栏）  -->
    <SolidColorBrush x:Key="SurfaceBarBrush" Color="{StaticResource ColorBg300}" />
    <SolidColorBrush x:Key="SurfaceBarAccentBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="SurfaceSubBarBrush" Color="{StaticResource ColorBg400}" />
    <SolidColorBrush x:Key="SurfaceSubBarBorderBrush" Color="{StaticResource ColorBg500}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource ColorBg200}" />


    <!--  ===== 向后兼容别名（引用 Layer 2/3，保持既有引用不破坏） =====  -->

    <!--  页面/卡片背景  -->
    <SolidColorBrush x:Key="TechPageBgBrush" Color="{StaticResource ColorBg900}" />
    <SolidColorBrush x:Key="TechPageBgMidBrush" Color="{StaticResource ColorBg800}" />
    <SolidColorBrush x:Key="TechCardBgBrush" Color="{StaticResource ColorBg700}" />
    <SolidColorBrush x:Key="TechCardBorderBrush" Color="{StaticResource ColorBg600}" />
    <SolidColorBrush x:Key="TechInnerBgBrush" Color="{StaticResource ColorBg500}" />

    <!--  霓虹色  -->
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource ColorCyan400}" />
    <SolidColorBrush x:Key="NeonCyanLightBrush" Color="{StaticResource ColorCyan300}" />
    <SolidColorBrush x:Key="NeonCyanDeepBrush" Color="{StaticResource ColorCyan700}" />
    <SolidColorBrush x:Key="NeonTealBrush" Color="{StaticResource ColorTeal400}" />
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource ColorBlue400}" />
    <SolidColorBrush x:Key="NeonOrangeBrush" Color="{StaticResource ColorOrange400}" />
    <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource ColorGreen400}" />

    <!--  文本（旧名）  -->
    <SolidColorBrush x:Key="TechTextPrimaryBrush" Color="{StaticResource ColorText100}" />
    <SolidColorBrush x:Key="TechTextSecondaryBrush" Color="{StaticResource ColorText200}" />
    <SolidColorBrush x:Key="TechTextTertiaryBrush" Color="{StaticResource ColorText300}" />
    <SolidColorBrush x:Key="TechTextLabelBrush" Color="{StaticResource ColorText400}" />
    <SolidColorBrush x:Key="TechTextDimBrush" Color="{StaticResource ColorText500}" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource ColorText100}" />
    <SolidColorBrush x:Key="TextSubtleOnDarkBrush" Color="{StaticResource ColorText300}" />

    <!--  数据可视化旧名  -->
    <SolidColorBrush x:Key="AccentYellowBrush" Color="{StaticResource ColorDataYellow}" />
    <SolidColorBrush x:Key="AccentLinkBrush" Color="{StaticResource ColorDataLink}" />

    <!--  状态栏旧名  -->
    <SolidColorBrush x:Key="DarkBarBackgroundBrush" Color="{StaticResource ColorBg300}" />
    <SolidColorBrush x:Key="DarkBarAccentBrush" Color="#1565C0" />
    <SolidColorBrush x:Key="DarkSubBarBackgroundBrush" Color="{StaticResource ColorBg400}" />
    <SolidColorBrush x:Key="DarkSubBarBorderBrush" Color="{StaticResource ColorBg500}" />
    <SolidColorBrush x:Key="DarkSeparatorBrush" Color="{StaticResource ColorBg200}" />


    <!--  ===== 装饰画刷 =====  -->

    <!--  网格线画刷（浅色背景装饰：半透明深色细线）  -->
    <DrawingBrush
        x:Key="TechGridBrush"
        Stretch="Uniform"
        TileMode="Tile"
        Viewport="0,0,40,40"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#10000000" Thickness="0.5" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--  浅色页面渐变背景  -->
    <LinearGradientBrush x:Key="TechPageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource ColorBg900}" />
        <GradientStop Offset="0.5" Color="{StaticResource ColorBg800}" />
        <GradientStop Offset="1" Color="{StaticResource ColorBg900}" />
    </LinearGradientBrush>

</ResourceDictionary>
