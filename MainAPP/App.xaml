<Application
    x:Class="MainAPP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MainAPP">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  HandyControl 主题  -->
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <!--  注意：顺序很重要，先加载底层资源（Color/FontSize/Spacing），再加载上层样式  -->

                <!--  1. 颜色（深色主题，默认；浅色主题备用，未来切换）  -->
                <ResourceDictionary Source="Themes/Colors/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/Colors/LightTheme.xaml" />

                <!--  2. 排版与间距  -->
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Spacing.xaml" />

                <!--  3. Elevation 阴影系统 + Animation 动画系统  -->
                <ResourceDictionary Source="Themes/Elevation.xaml" />
                <ResourceDictionary Source="Themes/Animations.xaml" />

                <!--  4. Converter  -->
                <ResourceDictionary Source="Themes/Converters.xaml" />

                <!--  4. 控件样式（依赖前面的 Brush/FontSize）  -->
                <ResourceDictionary Source="Themes/Controls/CardStyles.xaml" />
                <ResourceDictionary Source="Themes/Controls/TextStyles.xaml" />
                <ResourceDictionary Source="Themes/Controls/ButtonStyles.xaml" />
                <ResourceDictionary Source="Themes/Controls/OverlayStyles.xaml" />
                <ResourceDictionary Source="Themes/Controls/StateStyles.xaml" />

                <!--  5. 各 View 抽取出的命名样式（DataGrid / 表单控件 / 列表控件 / 滚动条）  -->
                <ResourceDictionary Source="Themes/Controls/DataGridDarkStyles.xaml" />
                <ResourceDictionary Source="Themes/Controls/FormControls.xaml" />
                <ResourceDictionary Source="Themes/Controls/ListControls.xaml" />
                <ResourceDictionary Source="Themes/Controls/ScrollBarStyles.xaml" />

                <!--  6. Skeleton 骨架屏样式（加载态占位）  -->
                <ResourceDictionary Source="Themes/Controls/SkeletonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
