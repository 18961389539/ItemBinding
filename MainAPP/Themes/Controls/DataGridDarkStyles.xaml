<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ===== 深色科技风 DataGrid 命名样式 =====  -->
    <!--  统一来源：HomeView / LogView 的隐式样式，采用更通用的值  -->
    <!--  DatabaseView 已有 TechDataGridColumnHeader / TechDataGridRow / TechDataGridCell 命名样式，未做合并以免影响其现有视觉  -->
    <!--  注意：StaticResource 要求被引用资源在前面定义，故子样式放在 DarkDataGridStyle 之前  -->

    <!--  列头：深色内框背景 + 青色霓虹文字（Padding 统一为 8,6）  -->
    <!--  ControlTemplate 自定义：排序箭头（AccentPrimary） + 列宽 Thumb（PART_*），保留 WPF 内置排序 / 列宽调整 / 列头冻结（Sticky Header）行为  -->
    <!--  BorderThickness=0：列头之间不显示分隔线，视觉更简洁  -->
    <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  列标题内容  -->
                            <ContentPresenter
                                Grid.Column="0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                Margin="{TemplateBinding Padding}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

                            <!--  排序方向箭头（默认隐藏）  -->
                            <!--  Data 为朝上三角形：升序 Angle=0 不旋转 → 朝上；降序 Angle=180 → 朝下（与 WPF 内置模板一致）  -->
                            <Path
                                x:Name="SortArrow"
                                Grid.Column="1"
                                Width="8"
                                Height="8"
                                Margin="4,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource AccentPrimaryBrush}"
                                Data="M0,4 L4,0 L8,4 Z"
                                Visibility="Collapsed"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>

                            <!--  列宽调整 Thumb（WPF 内置 PART 名），保留拖拽调整列宽功能，避免覆盖模板后丢失该能力  -->
                            <Thumb
                                x:Name="PART_LeftHeaderGripper"
                                Grid.Column="0"
                                Width="8"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                Cursor="SizeWE" />
                            <Thumb
                                x:Name="PART_RightHeaderGripper"
                                Grid.Column="1"
                                Width="8"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Cursor="SizeWE" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  升序：显示箭头，Angle=0 朝上  -->
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--  降序：显示箭头，旋转 180° 朝下  -->
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  行：白字 + 选中时半透明青色高亮 + 悬停深灰  -->
    <Style x:Key="DarkDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource TechCardBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="34" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#D6EBF0" />
                <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F4F7" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  单元格：重写 ControlTemplate 彻底去除 HandyControl 默认的右侧白色分隔线，仅保留内容 + Padding + 选中背景  -->
    <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        x:Name="CellBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="0"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DataGrid 整体：深色卡片背景 + 白字 + 水平网格线 + 行交替色  -->
    <!--  通过 ColumnHeaderStyle / RowStyle / CellStyle 自动级联子样式，便于一处引用全套  -->
    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource TechCardBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TechTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource TechCardBgBrush}" />
        <!-- REVIEW-FIX(亮色主题): 交替行浅灰 -->
        <Setter Property="AlternatingRowBackground" Value="#F5F8FA" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TechCardBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DarkDataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DarkDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DarkDataGridCellStyle}" />
    </Style>

    <!--  RowDetails 模板：行展开后内容区域的样式（深色内层 + 上下分隔线）。
          用法：在 DataGrid.RowDetailsTemplate 中 <Border Style="{StaticResource TechDataGridRowDetails}">...</Border>  -->
    <Style x:Key="TechDataGridRowDetails" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceInnerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

</ResourceDictionary>
