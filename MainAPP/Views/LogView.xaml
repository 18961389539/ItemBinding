<UserControl
    x:Class="MainAPP.Views.LogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MainAPP.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  ===== 统计徽章样式：基于 Tech 指标样式，覆盖居中对齐与字号  ===== -->
        <Style x:Key="LogStatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TechMetricValue}">
            <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="LogStatLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource TechMetricLabel}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!--  ===== 级别快捷胶囊：颜色随级别，激活态加底色  ===== -->
        <Style x:Key="LevelChipStyle" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ===== 深色科技风：输入控件隐式样式  ===== -->
        <!--  TextBox：白字 + 深色内框 + 白色光标  -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
        <!--  DatePicker：白字 + 深色内框  -->
        <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TechInnerBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TechCardBorderBrush}" />
        </Style>

        <!--  ScrollBar 隐式应用命名样式（DataGrid 内部 ScrollBar 为模板自动生成，无法直接 Style 引用）  -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}" />
    </UserControl.Resources>

    <!--  ===== 根 Grid：深色科技风渐变背景  ===== -->
    <Grid Background="{StaticResource TechPageBackgroundBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  装饰性网格背景层（横跨所有行，作为底层装饰，不挡住其他内容）  -->
        <Rectangle Grid.RowSpan="5" Opacity="0.3">
            <Rectangle.Fill>
                <StaticResource ResourceKey="TechGridBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <!--  ===== 顶部标题栏：青色图标 + 标题 + 统计徽章  ===== -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!--  青色图标徽章  -->
                    <Border
                        Width="48"
                        Height="48"
                        Margin="0,0,12,0"
                        Background="{StaticResource NeonCyanDeepBrush}"
                        CornerRadius="10">
                        <icons:PackIconPhosphorIcons
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Notebook" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource TechCardTitleText}"
                            FontSize="{StaticResource FontSizeHeader}"
                            Text="运行日志" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="{StaticResource FontSizeSmall}"
                            Foreground="{StaticResource TechTextTertiaryBrush}"
                            Text="直接管理 SQLite 数据库中的日志记录。" />
                    </StackPanel>
                </StackPanel>

                <!--  统计徽章组  -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Border
                        MinWidth="92"
                        Margin="6,0"
                        Padding="10,6"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource TechCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LogStatValueStyle}" Text="{Binding TotalLogCount}" />
                            <TextBlock Style="{StaticResource LogStatLabelStyle}" Text="数据库总数" />
                        </StackPanel>
                    </Border>
                    <Border
                        MinWidth="92"
                        Margin="6,0"
                        Padding="10,6"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource TechCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LogStatValueStyle}" Text="{Binding VisibleLogCount}" />
                            <TextBlock Style="{StaticResource LogStatLabelStyle}" Text="筛选结果" />
                        </StackPanel>
                    </Border>
                    <Border
                        MinWidth="170"
                        Margin="6,0"
                        Padding="10,6"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource TechCardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LogStatValueStyle}" Text="{Binding LatestLogTimeText}" />
                            <TextBlock Style="{StaticResource LogStatLabelStyle}" Text="最新记录" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </Border>

        <!--  ===== 合并筛选工具栏：时间范围 + 快捷段 + 级别胶囊（一行）+ 关键字/操作/实时跟随（一行）  ===== -->
        <Border
            Grid.Row="1"
            Margin="0,10,0,0"
            Padding="12"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  第一行：时间范围 + 快捷按钮 + 级别胶囊（带实时计数）+ 小时筛选徽章  -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricLabel}"
                        Text="时间范围:" />

                    <DatePicker
                        SelectedDate="{Binding StartTimeFilter}"
                        Width="120"
                        ToolTip="起始日期（包含）" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="5,0"
                        Style="{StaticResource TechMetricLabel}"
                        Text="至" />

                    <DatePicker
                        SelectedDate="{Binding EndTimeFilter}"
                        Width="120"
                        ToolTip="结束日期（包含）" />

                    <Button
                        Content="今日"
                        Margin="5,0,0,0"
                        Padding="8,3"
                        Command="{Binding SetTodayFilterCommand}"
                        Style="{StaticResource NeonButtonStyle}" />
                    <Button
                        Content="最近7天"
                        Margin="5,0,0,0"
                        Padding="8,3"
                        Command="{Binding SetLast7DaysFilterCommand}"
                        Style="{StaticResource NeonButtonStyle}" />
                    <Button
                        Content="最近30天"
                        Margin="5,0,0,0"
                        Padding="8,3"
                        Command="{Binding SetLast30DaysFilterCommand}"
                        Style="{StaticResource NeonButtonStyle}" />
                    <Button
                        Content="清除筛选"
                        Margin="5,0,0,0"
                        Padding="8,3"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource NeonButtonStyle}" />

                    <!--  级别分隔线  -->
                    <Rectangle
                        Width="1"
                        Height="20"
                        Margin="10,0,2,0"
                        VerticalAlignment="Center"
                        Fill="{StaticResource TechCardBorderBrush}" />

                    <!--  错误胶囊（激活态加底色）  -->
                    <Button
                        Command="{Binding SetLevelChipCommand}"
                        CommandParameter="Error"
                        ToolTip="只看错误级日志（Error + Fatal），再点一次取消">
                        <Button.Style>
                            <Style BasedOn="{StaticResource LevelChipStyle}" TargetType="Button">
                                <Setter Property="Foreground" Value="#FF8A5C" />
                                <Setter Property="BorderBrush" Value="#D55E00" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsErrorChipActive}" Value="True">
                                        <Setter Property="Background" Value="#38D55E00" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="错误" />
                            <TextBlock Margin="5,0,0,0" Text="{Binding ErrorCountText}" />
                        </StackPanel>
                    </Button>

                    <!--  警告胶囊  -->
                    <Button Command="{Binding SetLevelChipCommand}" CommandParameter="Warning">
                        <Button.Style>
                            <Style BasedOn="{StaticResource LevelChipStyle}" TargetType="Button">
                                <Setter Property="Foreground" Value="#FFC14D" />
                                <Setter Property="BorderBrush" Value="#E69F00" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWarningChipActive}" Value="True">
                                        <Setter Property="Background" Value="#38E69F00" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="警告" />
                            <TextBlock Margin="5,0,0,0" Text="{Binding WarningCountText}" />
                        </StackPanel>
                    </Button>

                    <!--  信息胶囊  -->
                    <Button Command="{Binding SetLevelChipCommand}" CommandParameter="Information">
                        <Button.Style>
                            <Style BasedOn="{StaticResource LevelChipStyle}" TargetType="Button">
                                <Setter Property="Foreground" Value="#2ED9A3" />
                                <Setter Property="BorderBrush" Value="#009E73" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInfoChipActive}" Value="True">
                                        <Setter Property="Background" Value="#38009E73" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="信息" />
                            <TextBlock Margin="5,0,0,0" Text="{Binding InfoCountText}" />
                        </StackPanel>
                    </Button>

                    <!--  调试胶囊  -->
                    <Button Command="{Binding SetLevelChipCommand}" CommandParameter="Debug">
                        <Button.Style>
                            <Style BasedOn="{StaticResource LevelChipStyle}" TargetType="Button">
                                <Setter Property="Foreground" Value="#4FA8E8" />
                                <Setter Property="BorderBrush" Value="#0072B2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDebugChipActive}" Value="True">
                                        <Setter Property="Background" Value="#380072B2" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="调试" />
                            <TextBlock Margin="5,0,0,0" Text="{Binding DebugCountText}" />
                        </StackPanel>
                    </Button>

                    <!--  小时筛选激活徽章（点击分布条柱块后出现，× 清除）  -->
                    <Border
                        Margin="10,0,0,0"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource TechInnerBgBrush}"
                        BorderBrush="{StaticResource NeonCyanBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        ToolTip="已按该小时精确筛选，点 × 清除">
                        <Border.Visibility>
                            <Binding Path="HasHourFilter" Converter="{StaticResource BooleanToVisibilityConverter}" />
                        </Border.Visibility>
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource NeonCyanBrush}"
                                Kind="Clock" />
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource NeonCyanBrush}"
                                Text="{Binding SelectedHourRangeText}" />
                            <Button
                                Margin="6,0,0,0"
                                Padding="3,0"
                                Command="{Binding ClearHourFilterCommand}"
                                Content="×"
                                Cursor="Hand"
                                FontSize="12"
                                Foreground="{StaticResource TechTextSecondaryBrush}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  第二行：关键字搜索 + 实时跟随（左） | 操作按钮（右）  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <icons:PackIconPhosphorIcons
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource NeonCyanBrush}"
                        Kind="MagnifyingGlass" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricLabel}"
                        Text="关键字" />
                    <TextBox
                        Width="240"
                        Margin="8,0,0,0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="输入数据库日志内容或级别关键词" />
                    <!--  关键字实时筛选状态提示  -->
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="8,0,0,0"
                        FontSize="{StaticResource FontSizeMicro}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                <Setter Property="Text" Value="筛选中..." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNoSearchMatch}" Value="True">
                                        <Setter Property="Text" Value="无匹配结果" />
                                        <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--  实时跟随开关：每 3 秒静默刷新并滚动到最新一条  -->
                    <CheckBox
                        Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        Content="实时跟随"
                        FontSize="12"
                        Foreground="{StaticResource TechTextSecondaryBrush}"
                        IsChecked="{Binding IsLiveFollow}"
                        ToolTip="开启后每 3 秒自动刷新并滚动到最新一条日志" />

                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Command="{Binding ReloadLogsCommand}"
                        Style="{StaticResource ButtonPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="ArrowsClockwise" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>

                    <Button
                        Margin="0,0,8,0"
                        Padding="12,6"
                        Command="{Binding CopySelectedCommand}"
                        Style="{StaticResource ButtonSuccess}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Copy" />
                            <TextBlock Text="复制选中" />
                        </StackPanel>
                    </Button>

                    <Button
                        Padding="12,6"
                        Command="{Binding ClearLogsCommand}"
                        Style="{StaticResource ButtonDanger}">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Trash" />
                            <TextBlock Text="清空日志" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  ===== 保留策略状态条  ===== -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="10,5"
            Background="{StaticResource TechInnerBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  日志总数  -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <icons:PackIconPhosphorIcons
                        Width="14"
                        Height="14"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Kind="Database" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Style="{StaticResource TechMetricLabel}"
                        Text="日志总数: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricValue}"
                        Text="{Binding LogCountDisplay}" />
                </StackPanel>

                <!--  使用率进度条
                    P0-FIX: ProgressBar.Value 默认 TwoWay 绑定，LogCountPercent 为只读属性，
                    必须显式指定 Mode=OneWay，否则窗口布局更新时反复抛 InvalidOperationException 导致 UI 无法渲染  -->
                <ProgressBar
                    Grid.Column="1"
                    Margin="15,0"
                    VerticalAlignment="Center"
                    Height="10"
                    Value="{Binding LogCountPercent, Mode=OneWay}"
                    Maximum="100">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Foreground" Value="{StaticResource StatusSuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLogCountWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!--  最早记录  -->
                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <icons:PackIconPhosphorIcons
                        Width="14"
                        Height="14"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TechTextLabelBrush}"
                        Kind="Clock" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricLabel}"
                        Text="最早: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricValue}"
                        Text="{Binding OldestLogTimeDisplay}" />
                </StackPanel>

                <!--  策略说明  -->
                <TextBlock
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource TechMetricLabel}"
                    Text="{Binding RetentionPolicyDisplay}" />

                <!--  立即清理按钮：危险操作语义  -->
                <Button
                    Grid.Column="4"
                    Margin="10,0,0,0"
                    Padding="8,3"
                    Command="{Binding CleanupNowCommand}"
                    Style="{StaticResource ButtonDanger}"
                    ToolTip="根据保留策略立即清理过期日志">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconPhosphorIcons
                            Width="12"
                            Height="12"
                            Margin="0,0,3,0"
                            VerticalAlignment="Center"
                            Kind="Broom" />
                        <TextBlock Text="立即清理" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  ===== 日志分布条：最近 24 小时 × 级别堆叠，点击柱块套用小时筛选  ===== -->
        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Padding="12,8"
            Background="{StaticResource TechCardBgBrush}"
            BorderBrush="{StaticResource TechCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <!--  标题 + 摘要 + 图例  -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource TechMetricLabel}"
                        Text="日志分布 · 最近 24 小时" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource FontSizeMicro}"
                        Foreground="{StaticResource TechTextTertiaryBrush}"
                        Text="{Binding DistributionSummaryText}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Rectangle Width="8" Height="8" Fill="#D55E00" RadiusX="2" RadiusY="2" />
                        <TextBlock Margin="4,0,10,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TechTextSecondaryBrush}" Text="错误" />
                        <Rectangle Width="8" Height="8" Fill="#E69F00" RadiusX="2" RadiusY="2" />
                        <TextBlock Margin="4,0,10,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TechTextSecondaryBrush}" Text="警告" />
                        <Rectangle Width="8" Height="8" Fill="#009E73" RadiusX="2" RadiusY="2" />
                        <TextBlock Margin="4,0,10,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TechTextSecondaryBrush}" Text="信息" />
                        <Rectangle Width="8" Height="8" Fill="#0072B2" RadiusX="2" RadiusY="2" />
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TechTextSecondaryBrush}" Text="调试" />
                    </StackPanel>
                </Grid>

                <!--  图表区（有数据时显示）  -->
                <StackPanel Visibility="{Binding HasDistribution, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl Height="92" ItemsSource="{Binding HourlyBuckets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="1,0"
                                    Background="Transparent"
                                    ToolTip="{Binding Tooltip}">
                                    <Border.InputBindings>
                                        <MouseBinding
                                            Command="{Binding DataContext.SelectHourCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Gesture="LeftClick" />
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="2" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <Rectangle Height="{Binding DebugHeight}" Fill="#0072B2" />
                                        <Rectangle Height="{Binding InfoHeight}" Fill="#009E73" />
                                        <Rectangle Height="{Binding WarningHeight}" Fill="#E69F00" />
                                        <Rectangle Height="{Binding ErrorHeight}" Fill="#D55E00" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  小时刻度（与柱块同列对齐）  -->
                    <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding HourlyBuckets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeMicro}"
                                    Foreground="{StaticResource TechTextDimBrush}"
                                    Text="{Binding HourLabel}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        FontSize="{StaticResource FontSizeMicro}"
                        Foreground="{StaticResource TechTextDimBrush}"
                        Text="点击柱块筛选该小时，再次点击取消" />
                </StackPanel>

                <!--  空状态（最近 24 小时无日志）  -->
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource FontSizeSmall}"
                    Foreground="{StaticResource TechTextTertiaryBrush}"
                    Text="最近 24 小时暂无日志">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDistribution}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!--  ===== 主从布局：左侧日志表格 + 右侧详情抽屉（选中时出现）  ===== -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  左：DataGrid 容器 + 空状态覆盖层 + 加载更多  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource TechCardBgBrush}"
                BorderBrush="{StaticResource TechCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid
                        x:Name="LogDataGrid"
                        Grid.Row="0"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="False"
                        CanUserResizeRows="False"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        ScrollViewer.CanContentScroll="True"
                        FrozenColumnCount="1"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding LogsView}"
                        SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        MouseDoubleClick="LogDataGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="170"
                                Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"
                                Header="时间" />
                            <DataGridTemplateColumn Width="70" Header="级别">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border
                                            Background="{Binding Color}"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            Margin="2"
                                            ToolTip="{Binding LevelFullName}">
                                            <TextBlock
                                                Text="{Binding LevelDisplay}"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--  内容列：HighlightTextBlock 行内高亮搜索词  -->
                            <DataGridTemplateColumn Width="*" Header="内容">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:HighlightTextBlock
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Color}"
                                            HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Text="{Binding Message}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!--  异常列：同样支持搜索词高亮  -->
                            <DataGridTemplateColumn Width="300" Header="异常">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:HighlightTextBlock
                                            Padding="4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            Foreground="{StaticResource StatusErrorBrush}"
                                            HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Text="{Binding FormattedException}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  空状态覆盖层  -->
                    <Border
                        Grid.Row="0"
                        Background="{StaticResource TechCardBgBrush}"
                        IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <icons:PackIconPhosphorIcons
                                Kind="Empty"
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource TechTextLabelBrush}" />
                            <TextBlock
                                Margin="0,10"
                                Text="{Binding EmptyStateTitle}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource EmptyStatePrimaryText}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TechTextSecondaryBrush}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding EmptyStateHint}">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource EmptyStateSecondaryText}" TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TechTextTertiaryBrush}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!--  加载更多按钮：霓虹风格  -->
                    <Button
                        Grid.Row="1"
                        Command="{Binding LoadMoreCommand}"
                        Content="加载更多"
                        Margin="5"
                        Padding="10,5"
                        HorizontalAlignment="Center">
                        <Button.Style>
                            <Style BasedOn="{StaticResource NeonButtonStyle}" TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMoreLogs}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!--  右：详情抽屉（选中日志时出现，替代原底部常驻详情面板）  -->
            <Border
                Grid.Column="1"
                Width="300"
                Margin="10,0,0,0"
                Padding="12"
                Background="{StaticResource TechCardBgBrush}"
                BorderBrush="{StaticResource TechCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedLog}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  抽屉标题 + 关闭按钮  -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource TechCardTitleText}" Text="选中记录详情" />
                        <Button
                            Padding="4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding ClearSelectedLogCommand}"
                            Content="×"
                            Cursor="Hand"
                            FontSize="16"
                            Foreground="{StaticResource TechTextSecondaryBrush}"
                            ToolTip="关闭详情">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!--  详情内容（可滚动）  -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TechMetricLabel}" Text="时间:" />
                            <TextBlock
                                Margin="0,2,0,8"
                                Style="{StaticResource TechMetricValue}"
                                Text="{Binding SelectedLog.Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}" />
                            <TextBlock Style="{StaticResource TechMetricLabel}" Text="级别:" />
                            <Border
                                Margin="0,2,0,8"
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                Background="{Binding SelectedLog.Color}"
                                CornerRadius="3">
                                <TextBlock
                                    Text="{Binding SelectedLog.Level}"
                                    Foreground="White"
                                    FontWeight="Bold" />
                            </Border>
                            <TextBlock Style="{StaticResource TechMetricLabel}" Text="完整消息:" />
                            <Border
                                Margin="0,2,0,8"
                                Padding="8"
                                Background="{StaticResource TechInnerBgBrush}"
                                BorderBrush="{StaticResource TechCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <controls:HighlightTextBlock
                                    FontFamily="Consolas"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource TechTextSecondaryBrush}"
                                    HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    LineHeight="18"
                                    Text="{Binding SelectedLog.Message}"
                                    TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Style="{StaticResource TechMetricLabel}" Text="异常:" />
                            <Border
                                Margin="0,2,0,0"
                                Padding="8"
                                Background="{StaticResource TechInnerBgBrush}"
                                BorderBrush="{StaticResource TechCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <controls:HighlightTextBlock
                                    FontFamily="Consolas"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource StatusErrorBrush}"
                                    HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Text="{Binding SelectedLog.FormattedException, TargetNullValue=无}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  操作按钮  -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Command="{Binding CopySelectedCommand}"
                            Style="{StaticResource ButtonPrimary}"
                            ToolTip="复制该条日志全文（含异常与属性）到剪贴板">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Kind="Copy" />
                                <TextBlock Text="复制全部" />
                            </StackPanel>
                        </Button>
                        <Button
                            Padding="10,5"
                            HorizontalAlignment="Left"
                            Command="{Binding AskAiAboutSelectedCommand}"
                            Style="{StaticResource ButtonSuccess}"
                            ToolTip="复制该条日志并跳转到 AI 助手标签页">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Kind="Lightning" />
                                <TextBlock Text="问 AI 助手" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  ===== 日志加载 Loading 覆盖层（参考 DatabaseView 的 IsBusy 实现）  ===== -->
        <Border
            Grid.RowSpan="5"
            Background="#CCF2F5F8"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <ProgressBar
                    Width="40"
                    Height="40"
                    IsIndeterminate="True"
                    Maximum="100"
                    Minimum="0" />
                <TextBlock
                    Margin="0,12,0,0"
                    FontSize="{StaticResource FontSizeStat}"
                    Foreground="{StaticResource TechTextPrimaryBrush}"
                    Text="正在加载日志..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
