<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Jinlong.YoloSharp</RootNamespace>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<PropertyGroup>
		<PackageName>YoloSharp</PackageName>
		<!-- 2026-09-16: ORT 相关版本已集中到根 Directory.Packages.props（CPM）。
		     此处只保留"选哪个 ORT 打包形态"的属性——它是名称选择而非版本，且需按命令行开关分支。 -->
		<OnnxRuntimePackage>Microsoft.ML.OnnxRuntime.Managed</OnnxRuntimePackage>
		<PackageName Condition="'$(GpuPackage)' == 'true'">$(PackageName).Gpu</PackageName>
		<PackageName Condition="'$(OpenVinoPackage)' == 'true'">$(PackageName).OpenVino</PackageName>
		<PackageName Condition="'$(CorePackage)' == 'true'">$(PackageName).Core</PackageName>
		<OnnxRuntimePackage Condition="'$(OpenVinoPackage)' == 'false'">Microsoft.ML.OnnxRuntime</OnnxRuntimePackage>
		<OnnxRuntimePackage Condition="'$(GpuPackage)' == 'true'">Microsoft.ML.OnnxRuntime.Gpu</OnnxRuntimePackage>
		<OnnxRuntimePackage Condition="'$(CorePackage)' == 'true'">Microsoft.ML.OnnxRuntime.Managed</OnnxRuntimePackage>
		<DefineConstants Condition="'$(GpuPackage)' == 'true'">$(DefineConstants);USE_CUDA_DEFAULT</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<PackageId>$(PackageName)</PackageId>
		<AssemblyName>$(PackageName)</AssemblyName>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Description>real-time for object detection tasks, with edge performance, powered by ONNX-Runtime.</Description>
		<PackageTags>image-classification object-detection pose-estimation instance-segmentation onnx imagesharp</PackageTags>
		<Authors>Jinlong</Authors>
		<Version>1.1.0</Version>
		<Deterministic>true</Deterministic>
		<DebugType>embedded</DebugType>
	</PropertyGroup>


	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Clipper2" />
		<PackageReference Include="Intel.ML.OnnxRuntime.OpenVino" Condition="'$(GpuPackage)' != 'true' and '$(CorePackage)' != 'true' and '$(OpenVinoPackage)' != 'false'" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<PackageReference Include="SixLabors.ImageSharp.Drawing" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="$(OnnxRuntimePackage)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="JinlongYolo.Tests" />
		<InternalsVisibleTo Include="JinlongYolo.Benchmarks" />
	</ItemGroup>

</Project>
