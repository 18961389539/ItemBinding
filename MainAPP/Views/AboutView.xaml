<UserControl
    x:Class="MainAPP.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:MainAPP.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MainAPP.ViewModels"
    d:DesignHeight="720"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <vm:AboutViewModel />
    </UserControl.DataContext>

    <!--  ===== 深色科技风：整页深色背景 + 霓虹高光（背景画刷引用 CommonStyles） =====  -->
    <UserControl.Background>
        <StaticResource ResourceKey="TechPageBackgroundBrush" />
    </UserControl.Background>

    <Grid>
        <!--  装饰性网格背景（TechGridBrush 由 CommonStyles 提供）  -->
        <Rectangle Opacity="0.4">
            <Rectangle.Fill>
                <StaticResource ResourceKey="TechGridBrush" />
            </Rectangle.Fill>
        </Rectangle>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" Grid.IsSharedSizeScope="True">

                <!--  ===== Hero 区：Logo + 大标题 + 状态呼吸灯（亮色主题：浅青白渐变） =====  -->
                <Border Margin="0,0,0,16" Padding="24,24" CornerRadius="8">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusY="1.2" RadiusX="0.8">
                            <GradientStop Offset="0" Color="#EAF3F5" />
                            <GradientStop Offset="1" Color="#F7FAFC" />
                        </RadialGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#006064" />
                            <GradientStop Offset="0.5" Color="#00ACC1" />
                            <GradientStop Offset="1" Color="#006064" />
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness>1</Thickness>
                    </Border.BorderThickness>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <!--  Logo + 标题  -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  发光 Logo  -->
                            <Border
                                Width="56"
                                Height="56"
                                CornerRadius="28">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#80DEEA" />
                                        <GradientStop Offset="1" Color="#00838F" />
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="18"
                                        Opacity="0.7"
                                        ShadowDepth="0"
                                        Color="#4DD0E1" />
                                </Border.Effect>
                                <icons:PackIconPhosphorIcons
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="Barcode" />
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TechTextPrimaryBrush}"
                                    Text="{Binding AppTitle}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource TechTextTertiaryBrush}"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <!--  徽章组：版本 + 已激活 + 在线呼吸灯  -->
                        <StackPanel
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <!--  版本徽章  -->
                            <Border
                                Padding="12,4"
                                CornerRadius="3">
                                <Border.Background>
                                    <!-- REVIEW-FIX(对比度): 渐变暗端改深青 #006064，白字 ≥7:1（原 #00ACC1 白字仅 2.7:1） -->
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00838F" />
                                        <GradientStop Offset="1" Color="#006064" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock
                                    FontSize="{StaticResource FontSizeMicro}"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding Version, StringFormat='v{0}'}" />
                            </Border>
                            <!--  已激活徽章  -->
                            <Border
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Background="#1B5E20"
                                CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource NeonGreenBrush}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="已激活" />
                                </StackPanel>
                            </Border>
                            <!--  在线状态呼吸灯（Fill 直接引用 NeonCyanBrush）  -->
                            <Border
                                Margin="8,0,0,0"
                                Padding="12,4"
                                Background="{StaticResource TechInnerBgBrush}"
                                BorderBrush="{StaticResource TechCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource NeonCyanBrush}">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="Forever"
                                                            AutoReverse="True"
                                                            Storyboard.TargetProperty="Opacity"
                                                            From="1" To="0.2" Duration="0:0:1.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        FontSize="{StaticResource FontSizeMicro}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource NeonCyanBrush}"
                                        Text="在线" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ===== 数据可视化：4 个关键指标 =====  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  运行时间  -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        Padding="0,14"
                        Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource NeonCyanBrush}"
                                Kind="Timer" />
                            <TextBlock Style="{StaticResource TechBigMetricValue}" Text="{Binding ProcessorCount}" />
                            <TextBlock Style="{StaticResource TechBigMetricLabel}" Text="CPU 核心" />
                        </StackPanel>
                    </Border>

                    <!--  内存使用  -->
                    <Border
                        Grid.Column="1"
                        Margin="6,0"
                        Padding="0,14"
                        Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource NeonTealBrush}"
                                Kind="Memory" />
                            <TextBlock Style="{StaticResource TechBigMetricValue}" Text="{Binding MemorySize}" />
                            <TextBlock Style="{StaticResource TechBigMetricLabel}" Text="内存占用" />
                        </StackPanel>
                    </Border>

                    <!--  版本号  -->
                    <Border
                        Grid.Column="2"
                        Margin="6,0"
                        Padding="0,14"
                        Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource NeonBlueBrush}"
                                Kind="Tag" />
                            <TextBlock Style="{StaticResource TechBigMetricValue}" Text="{Binding Version, StringFormat='v{0}'}" />
                            <TextBlock Style="{StaticResource TechBigMetricLabel}" Text="应用版本" />
                        </StackPanel>
                    </Border>

                    <!--  构建日期  -->
                    <Border
                        Grid.Column="3"
                        Margin="6,0,0,0"
                        Padding="0,14"
                        Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <icons:PackIconPhosphorIcons
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                Foreground="{StaticResource NeonOrangeBrush}"
                                Kind="Calendar" />
                            <TextBlock Style="{StaticResource TechBigMetricValue}" Text="{Binding BuildDateShort}" />
                            <TextBlock Style="{StaticResource TechBigMetricLabel}" Text="构建日期" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  ===== 两列布局：左侧应用信息 + 右侧系统信息 =====  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左：应用信息卡  -->
                    <Border Grid.Column="0" Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonCyanBrush}"
                                    Kind="Info" />
                                <TextBlock Style="{StaticResource TechCardTitleText}" Text="应用信息" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AppLabelCol" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TechMetricLabel}" Text="版本" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TechMetricValue}" Text="{Binding Version}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="构建" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding BuildDate}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="作者" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding Author}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="版权" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding Copyright}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="描述" />
                                <TextBlock
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Margin="0,8,0,0"
                                    FontSize="{StaticResource FontSizeSmall}"
                                    Foreground="{StaticResource TechTextTertiaryBrush}"
                                    Text="{Binding Description}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  右：系统信息卡  -->
                    <Border Grid.Column="2" Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonCyanBrush}"
                                    Kind="Desktop" />
                                <TextBlock Style="{StaticResource TechCardTitleText}" Text="系统信息" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SysLabelCol" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TechMetricLabel}" Text="系统" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TechMetricValue}" Text="{Binding OsVersion}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="运行时" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding RuntimeVersion}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="机器名" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding MachineName}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="启动" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding AppStartTime}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource TechMetricLabel}" Text="核心数" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource TechMetricValue}" Text="{Binding ProcessorCount}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  ===== 主要依赖：Consolas 代码感 =====  -->
                <Border Style="{StaticResource TechCardBorder}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel
                            Margin="0,0,0,12"
                            Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource NeonCyanBrush}"
                                Kind="Code" />
                            <TextBlock Style="{StaticResource TechCardTitleText}" Text="主要依赖" />
                            <Border
                                Margin="8,0,0,0"
                                Padding="8,2"
                                Background="{StaticResource TechInnerBgBrush}"
                                BorderBrush="{StaticResource TechCardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeCaption}"
                                    Foreground="{StaticResource TechTextLabelBrush}"
                                    Text="RUNTIME LOADED" />
                            </Border>
                        </StackPanel>
                        <Border
                            Padding="12,8"
                            Background="{StaticResource TechInnerBgBrush}"
                            BorderBrush="{StaticResource TechCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontFamily="Consolas, 'Cascadia Code', monospace"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource NeonTealBrush}"
                                Text="{Binding Dependencies}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ===== 两列：技术支持 + 许可证 =====  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  技术支持卡  -->
                    <Border Grid.Column="0" Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonCyanBrush}"
                                    Kind="Headset" />
                                <TextBlock Style="{StaticResource TechCardTitleText}" Text="技术支持" />
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <icons:PackIconPhosphorIcons
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonGreenBrush}"
                                    Kind="Phone" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TechMetricLabel}" Text="热线" />
                                    <TextBlock Style="{StaticResource TechMetricValue}" Text="{Binding SupportPhone}" />
                                </StackPanel>

                                <icons:PackIconPhosphorIcons
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Margin="0,12,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonBlueBrush}"
                                    Kind="Envelope" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TechMetricLabel}" Text="邮箱" />
                                    <TextBlock Style="{StaticResource TechMetricValue}" Text="{Binding SupportEmail}" />
                                </StackPanel>

                                <icons:PackIconPhosphorIcons
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Margin="0,12,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonOrangeBrush}"
                                    Kind="Clock" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TechMetricLabel}" Text="时间" />
                                    <TextBlock Style="{StaticResource TechMetricValue}" Text="{Binding SupportHours}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  许可证卡  -->
                    <Border Grid.Column="2" Style="{StaticResource TechCardBorder}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel
                                Margin="0,0,0,12"
                                Orientation="Horizontal">
                                <icons:PackIconPhosphorIcons
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource NeonCyanBrush}"
                                    Kind="Certificate" />
                                <TextBlock Style="{StaticResource TechCardTitleText}" Text="许可证" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="{StaticResource FontSizeSmall}"
                                Foreground="{StaticResource TechTextTertiaryBrush}"
                                Text="{Binding LicenseInfo}"
                                TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TechMetricLabel}" Text="类型" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <Border
                                        Padding="8,2"
                                        Background="#1B5E20"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="{StaticResource FontSizeCaption}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource NeonGreenBrush}"
                                            Text="{Binding LicenseType}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" Style="{StaticResource TechMetricLabel}" Text="期限" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Orientation="Horizontal">
                                    <Border
                                        Padding="8,2"
                                        Background="{StaticResource TechInnerBgBrush}"
                                        BorderBrush="{StaticResource NeonCyanBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                        <TextBlock
                                            FontSize="{StaticResource FontSizeCaption}"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource NeonCyanBrush}"
                                            Text="{Binding LicenseExpiry}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!--  ===== 霓虹按钮组 =====  -->
                <StackPanel
                    Margin="0,4,0,12"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding CopyInfoCommand}"
                        Style="{StaticResource NeonButtonStyle}"
                        ToolTip="将版本/构建日期等信息复制到剪贴板">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Kind="Copy" />
                            <TextBlock Text="复制信息" />
                        </StackPanel>
                    </Button>
                    <Button
                        Command="{Binding CheckUpdateCommand}"
                        Style="{StaticResource NeonButtonStyle}"
                        ToolTip="获取最新版本请联系技术支持">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconPhosphorIcons
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                Kind="DownloadSimple" />
                            <TextBlock Text="检查更新" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  ===== 底部版权 =====  -->
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="{StaticResource FontSizeCaption}"
                    Foreground="{StaticResource TechTextDimBrush}"
                    Text="{Binding Copyright}" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
